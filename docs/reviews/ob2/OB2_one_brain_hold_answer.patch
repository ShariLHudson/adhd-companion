+/**
+ * One Brain room gate — OB-2.
+ *
+ * MECHANICALLY THIN. A room supplies its pending question (plain data) and the
+ * member's words; Boundary decides what the member is doing, `permitsFor`
+ * decides whether the words may be stored / the room may advance, and the room
+ * performs the returned obligation with its OWN specialist copy.
+ *
+ *   room pending question ─► resolveConversationBoundary ─► permitsFor ─► verdict
+ *
+ * No room may interpret the member's text to choose an obligation. This module
+ * contains no language rules and no domain explanations: `renderRoomHoldReply`
+ * only frames the copy the room hands it.
+ */
+
+import {
+  resolveConversationBoundary,
+  type BoundaryPendingQuestion,
+  type ConversationBoundaryDecision,
+} from "./conversationBoundary";
+import {
+  HELP_REQUESTED_EVIDENCE,
+  isBoundaryMeaningHoldEnabled,
+  permitsFor,
+  type BoundaryObligation,
+  type BoundaryPermits,
+} from "./conversationBoundaryMeaning";
+
+/** A room's pending question, as data. */
+export type RoomPendingQuestion = {
+  /** The question exactly as the room asked it. */
+  text: string;
+  /** Answer shape; open questions default to "free". */
+  expects?: BoundaryPendingQuestion["expects"];
+  choices?: string[];
+  /** The room's own answer affordances (e.g. its authored signal patterns). */
+  affordances?: readonly RegExp[];
+  /** The room lets the member skip this question. */
+  optional?: boolean;
+  /**
+   * The room's question invites a question as its answer ("What question would
+   * you like to bring to the Board?"). A member question is then the answer; a
+   * request to explain the room's own question still holds.
+   */
+  acceptsQuestions?: boolean;
+  /**
+   * The room's own answer affordance accepts "I don't know" as information
+   * (Board: a settled unknown the Directors reason with; Events: pause this
+   * question and come back). One Brain returns an `unknown` verdict and the
+   * room applies its own semantics. With `unknownWithHelp`, a help request
+   * rides on the unknown (Board); without it, a help request still holds.
+   */
+  acceptsUnknown?: boolean;
+  unknownWithHelp?: boolean;
+  /**
+   * An opening invitation ("What's on your mind?", "What would you like to
+   * bring to the Board?") accepts anything the member offers; it holds only for
+   * a request to explain the invitation itself, or for distress.
+   */
+  openingInvitation?: boolean;
+};
+
+export type RoomHoldObligation = Exclude<BoundaryObligation, "domain_turn" | "execute_authorized_scope">;
+
+export type RoomTurnVerdict =
+  /** Store/advance exactly as the room always has (its own domain validation still applies). */
+  | { kind: "proceed"; decision: ConversationBoundaryDecision | null; permits: BoundaryPermits | null }
+  /** The member declined an optional question: advance without storing. */
+  | { kind: "skip"; decision: ConversationBoundaryDecision; permits: BoundaryPermits }
+  /**
+   * The member does not know the answer and the room accepts that as
+   * information (`acceptsUnknown`). The room applies its own unknown semantics.
+   */
+  | {
+      kind: "unknown";
+      helpRequested: boolean;
+      decision: ConversationBoundaryDecision;
+      permits: BoundaryPermits;
+    }
+  /** Do not store, do not advance; perform the obligation; the question stays pending. */
+  | { kind: "hold"; obligation: RoomHoldObligation; decision: ConversationBoundaryDecision; permits: BoundaryPermits };
+
+/**
+ * The single gate every OB-2 room calls BEFORE storing or advancing.
+ * With the kill switch off it always returns `proceed` (previous behavior).
+ */
+export function roomTurnVerdict(input: {
+  userText: string;
+  question: RoomPendingQuestion;
+  turn?: number;
+  /** The room's own domain validation of the value, when it has one. */
+  answerAffordanceValid?: boolean;
+  /**
+   * The room has its own correction specialist (e.g. Claire's confirmation
+   * contract handles "modified"): a correction proceeds to it instead of holding.
+   */
+  hasCorrectionSpecialist?: boolean;
+}): RoomTurnVerdict {
+  if (!isBoundaryMeaningHoldEnabled()) return { kind: "proceed", decision: null, permits: null };
+  const turn = input.turn ?? 2;
+  const decision = resolveConversationBoundary({
+    userText: input.userText,
+    turn,
+    pendingQuestion: {
+      kind: "open",
+      expects: input.question.expects ?? "free",
+      choices: input.question.choices,
+      affordances: input.question.affordances,
+    },
+    lastAssistantText: input.question.text,
+  });
+  const permits = permitsFor(decision, {
+    currentTurn: turn,
+    answerAffordanceValid: input.answerAffordanceValid,
+    pendingQuestionOwnsInput: true,
+    pendingQuestionOptional: input.question.optional === true,
+  });
+  if (permits.mayStoreAsAnswer) return { kind: "proceed", decision, permits };
+  const high = decision.meaningConfidence === "high";
+  if (input.question.openingInvitation) {
+    const explainInvitation = high && decision.relation === "clarify";
+    if (!explainInvitation && permits.obligation !== "pause_for_person") {
+      return { kind: "proceed", decision, permits };
+    }
+  }
+  // A room ASKED a question (it made no offer), so "No, I don't have savings set
+  // aside." answers it; the decline-with-content ambiguity only matters for offers.
+  if (
+    decision.relation === "decline" &&
+    decision.evidence.includes("meaning:low:decline_with_content")
+  ) {
+    return { kind: "proceed", decision, permits };
+  }
+  if (input.question.acceptsUnknown && decision.relation === "unsure") {
+    const helpRequested = decision.evidence.includes(`meaning:${HELP_REQUESTED_EVIDENCE}`);
+    if (!helpRequested || input.question.unknownWithHelp) {
+      return { kind: "unknown", helpRequested, decision, permits };
+    }
+  }
+  // A yes/no question's own answers: a clear yes or no IS the answer.
+  if (
+    high &&
+    input.question.expects === "yes_no" &&
+    (decision.relation === "accept" || decision.relation === "decline")
+  ) {
+    return { kind: "proceed", decision, permits };
+  }
+  if (high && decision.relation === "ask" && input.question.acceptsQuestions) {
+    return { kind: "proceed", decision, permits };
+  }
+  if (high && decision.relation === "correct" && input.hasCorrectionSpecialist) {
+    return { kind: "proceed", decision, permits };
+  }
+  if (permits.obligation === "acknowledge_and_release" && permits.mayAdvance) {
+    return { kind: "skip", decision, permits };
+  }
+  const obligation: RoomHoldObligation =
+    permits.obligation === "domain_turn" || permits.obligation === "execute_authorized_scope"
+      ? "check_meaning"
+      : permits.obligation;
+  return { kind: "hold", obligation, decision, permits };
+}
+
+/** The room's own words about its pending question (specialist content). */
+export type RoomQuestionCopy = {
+  question: string;
+  /** What the question means / why the room asks it. */
+  meaning: string;
+  /** How the member can work out an answer (examples, a way in). */
+  help: string;
+};
+
+/**
+ * Frame a hold reply from the room's own copy. Person first, then the pending
+ * question again so the member can answer it on the next turn.
+ */
+export function renderRoomHoldReply(
+  verdict: Extract<RoomTurnVerdict, { kind: "hold" }>,
+  copy: RoomQuestionCopy,
+  opts: { reask?: boolean } = {},
+): string {
+  const strained = verdict.decision.affect === "strained";
+  // Rooms whose UI already shows the pending question beneath the reply pass reask:false.
+  const reask = opts.reask === false ? "" : `When you're ready: ${copy.question}`;
+  switch (verdict.obligation) {
+    case "explain_own_last_contribution":
+      return `${strained ? "Sorry — I didn't make that clear. " : ""}${copy.meaning} ${reask}`.trim();
+    case "answer_question":
+      return `Good question. ${copy.meaning} ${reask}`.trim();
+    case "help_with_pending":
+      return `${strained ? "That's completely okay. " : "That's okay — "}${copy.help} ${reask}`.trim();
+    case "apply_or_confirm_correction":
+      return `Thanks for catching that — I don't want to get it wrong. Tell me what it should be, and I'll use that instead. ${reask}`.trim();
+    case "acknowledge_and_release":
+      return `No problem. We can come back to this whenever you like. ${reask}`.trim();
+    case "pause_for_person":
+      return "Let's pause right here. Nothing is lost — your place is saved, and we can pick this back up whenever you're ready.";
+    case "check_meaning":
+    default:
+      return `Just so I get this right — is that your answer to "${copy.question}", or would you like me to explain the question first?`;
+  }
+}
