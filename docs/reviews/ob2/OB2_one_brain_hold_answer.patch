+++ b/lib/oneBrainCertification/roomHold.ob2.test.ts
@@ -0,0 +1,239 @@
+// @vitest-environment jsdom
+/**
+ * OB-2 — hold-and-answer through One Brain, per room.
+ *
+ * For each converged room: a clarification is held (nothing stored, same
+ * question pending) and the SPECIALIST explains its own question; the next
+ * turn's genuine answer stores normally; the kill switch restores the
+ * previous path. Main chat: a held turn is never a Create discovery answer.
+ */
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+  resolveConversationBoundary,
+  isMeaningHold,
+  type BoundaryPendingQuestion,
+} from "@/lib/conversationBoundary";
+import {
+  boardIntakeTurn,
+  createEmptyBoardIntakeDraft,
+  setDraftStep,
+} from "@/lib/board/boardDiscussion/boardDirectorDiscussion";
+import { applyBoardMemberAnswers } from "@/lib/board/reconstructed/orchestration/boardMemberQuestions";
+import type { BoardMemberQuestion } from "@/lib/board/reconstructed/orchestration/types";
+import { applyEventConversationalAnswer } from "@/lib/eventsIntelligence/applyEventConversationalAnswer";
+import { nextFoundationQuestionForRecord } from "@/lib/eventsIntelligence/eventMemberQuestionPaths";
+import { getEventRecord } from "@/lib/eventsIntelligence/eventRecordStore";
+import {
+  advanceEventsEntranceUnderstanding,
+  startEventsEntranceUnderstanding,
+} from "@/lib/eventsEstate/eventsEntranceUnderstanding";
+import { bootstrapStrategyApplySession, processStrategyApplyTurn } from "@/lib/strategyApplyCoach";
+import {
+  __resetStrategyChamberStoresForTests,
+  applyGuidedJourneyAnswer,
+  createStrategyWorkItem,
+  getStrategyWorkItem,
+  updateStrategyWorkItem,
+} from "@/lib/strategyChamber";
+import { processDayDesignerMessage, startDayDesignerSession } from "@/lib/day-designer";
+import { advanceEntranceUnderstanding, startEntranceUnderstanding } from "@/lib/createEstate/entranceUnderstanding";
+import { resolveClaireConfirmationTurn } from "@/lib/businessProfileFounder/claireConfirmationTurn";
+import { buildWriteCandidate } from "@/lib/businessProfileFounder/writeCandidateContract";
+import { classifyCreateTurnRelationship } from "@/lib/universalCreation/createTurnRelationship";
+import type { UniversalCreationSession } from "@/lib/universalCreation/types";
+
+const CLARIFY = "I don't know what you mean. Can you explain that before we keep going?";
+const HOLD = "NEXT_PUBLIC_BOUNDARY_MEANING_HOLD";
+let saved: string | undefined;
+beforeEach(() => {
+  saved = process.env[HOLD];
+  delete process.env[HOLD];
+  localStorage.clear();
+});
+afterEach(() => {
+  if (saved === undefined) delete process.env[HOLD];
+  else process.env[HOLD] = saved;
+});
+
+describe("Board intake", () => {
+  const draft = () => setDraftStep(createEmptyBoardIntakeDraft([]), "importance");
+  it("holds a clarification, explains Board's own question, then stores a real answer", () => {
+    const held = boardIntakeTurn(draft(), CLARIFY);
+    expect(held.draft.currentStep).toBe("importance");
+    expect(held.draft.importance).toBe("");
+    expect(held.holdReply).toMatch(/why this decision matters right now/);
+    expect(held.holdReply).toMatch(/Why does it matter now\?/);
+    const answered = boardIntakeTurn(held.draft, "Cash is tight this quarter.");
+    expect(answered.holdReply).toBeNull();
+    expect(answered.draft.importance).toBe("Cash is tight this quarter.");
+    expect(answered.draft.currentStep).toBe("options");
+  });
+  it("kill switch restores storing every reply", () => {
+    process.env[HOLD] = "0";
+    expect(boardIntakeTurn(draft(), CLARIFY).draft.importance).toBe(CLARIFY);
+  });
+});
+
+describe("Board meeting", () => {
+  const q: BoardMemberQuestion = {
+    id: "q1",
+    question: "What is your monthly revenue right now?",
+    askedBy: [{ directorReasoningId: "economic-survivability", missingInformation: "monthly revenue" }],
+    status: "asked",
+  };
+  it("routes a held turn to the asking Director (Board explains), keeps the question open", () => {
+    const r = applyBoardMemberAnswers([q], [{ questionId: "q1", answer: "Wait, why does that matter?" }]);
+    expect(r.ok).toBe(true);
+    const after = r.ok ? r.questions[0]! : null;
+    expect(after?.status).toBe("asked");
+    expect(after?.memberQuestionAddressedTo).toBe("economic-survivability");
+  });
+  it("Board's affordance: 'I don't know' settles as unknown (help rides along); a factual unknown settles too", () => {
+    // R3F-5B (Founder-certified): the Board accepts an unknown as information the
+    // Directors reason with — One Brain returns `unknown`, the Board applies it.
+    const help = applyBoardMemberAnswers([q], [{ questionId: "q1", answer: "I don't know. Help me figure that out." }]);
+    expect(help.ok && help.questions[0]!.status).toBe("answered");
+    expect(help.ok && help.questions[0]!.settledAsUnknown).toBe(true);
+    expect(help.ok && help.questions[0]!.helpRequested).toBe(true);
+    const unknown = applyBoardMemberAnswers([q], [{ questionId: "q1", answer: "No revenue yet — we launch in March." }]);
+    expect(unknown.ok && unknown.questions[0]!.status).toBe("answered");
+  });
+});
+
+describe("Events", () => {
+  it("holds without writing, explains Events' own question, same question next turn", () => {
+    const start = startEventsEntranceUnderstanding("I'm hosting an online event.");
+    expect(start).not.toBeNull();
+    const session = start!.session;
+    const step = advanceEventsEntranceUnderstanding(session, CLARIFY);
+    expect(step.kind).toBe("question");
+    if (step.kind !== "question") return;
+    expect(step.acknowledgment).toMatch(/I'm asking/);
+    expect(Number(step.session.answers["events-turn-count"] ?? "0")).toBe(
+      Number(session.answers["events-turn-count"] ?? "0"),
+    );
+    expect(JSON.stringify(step.session.answers)).not.toContain("what you mean");
+  });
+  it("the record is not rewritten on a hold", () => {
+    const start = startEventsEntranceUnderstanding("I'm hosting an online event.")!;
+    const id = start.session.answers["events-record-id"]!;
+    const rec = getEventRecord(id)!;
+    const q = nextFoundationQuestionForRecord(rec);
+    const before = JSON.stringify(getEventRecord(id));
+    const res = applyEventConversationalAnswer(rec, CLARIFY, q);
+    expect(res.held).toBe(true);
+    expect(JSON.stringify(getEventRecord(id))).toBe(before);
+    const answer = applyEventConversationalAnswer(rec, "ADHD entrepreneurs and solopreneurs.", q);
+    expect(answer.held).toBeUndefined();
+    expect(answer.record.activeQuestionId).not.toBe(rec.activeQuestionId);
+  });
+});
+
+describe("Strategy Apply", () => {
+  it("holds, explains Strategy's own question, then advances on a real answer", () => {
+    const s = bootstrapStrategyApplySession("ugly-first-draft")!.session;
+    const held = processStrategyApplyTurn(s, CLARIFY);
+    expect(held.session).toBe(s);
+    expect(held.reply).toMatch(/what's really getting in the way/);
+    const next = processStrategyApplyTurn(held.session, "I keep rewriting my sales page.");
+    expect(next.session.questionIndex).toBe(s.questionIndex + 1);
+  });
+});
+
+describe("Strategy Chamber", () => {
+  it("a hold changes only Shari's reflection", () => {
+    __resetStrategyChamberStoresForTests();
+    const item = createStrategyWorkItem({ entryReason: "need_direction" });
+    updateStrategyWorkItem(item.id, applyGuidedJourneyAnswer(item, "Where should my marketing focus?"));
+    const current = getStrategyWorkItem(item.id)!;
+    const patch = applyGuidedJourneyAnswer(current, CLARIFY);
+    expect(Object.keys(patch)).toEqual(["shariReflection"]);
+    expect(patch.shariReflection).toMatch(/I'm asking this so we build the strategy/);
+  });
+});
+
+describe("Day Designer (Plan My Day)", () => {
+  it("holds with Plan My Day's own explanation and keeps the step", () => {
+    const s = { ...startDayDesignerSession(new Date("2026-09-28T09:00:00Z")), step: "priorities" as const };
+    const r = processDayDesignerMessage(s, CLARIFY);
+    expect(r.holdReply).toMatch(/what truly has to get done today/);
+    expect(r.session.step).toBe("priorities");
+    expect(r.plan).toBeNull();
+  });
+});
+
+describe("Create entrance (and Work Recognition, which reuses it)", () => {
+  it("holds with Create's own slot explanation; same question; nothing stored", () => {
+    const start = startEntranceUnderstanding("I want to create a client onboarding guide")!;
+    expect(start.kind).toBe("question");
+    if (start.kind !== "question") return;
+    const step = advanceEntranceUnderstanding(start.session, CLARIFY);
+    expect(step.kind).toBe("question");
+    if (step.kind !== "question") return;
+    expect(step.question.id).toBe(start.question.id);
+    expect(step.acknowledgment).toMatch(/I'm asking/);
+    expect(step.session.answers[start.question.id]).toBeUndefined();
+  });
+});
+
+describe("Claire confirmation", () => {
+  const candidate = () => buildWriteCandidate("My workshop costs $150.")!;
+  it("a clarification holds the candidate; yes still confirms; a correction reaches Claire's contract", () => {
+    const held = resolveClaireConfirmationTurn(candidate(), "What do you mean by that?");
+    expect(held.kind).toBe("hold");
+    expect(held.kind === "hold" && held.reply).toMatch(/only update your business picture/);
+    const yes = resolveClaireConfirmationTurn(candidate(), "Yes.");
+    expect(yes.kind === "outcome" && yes.outcome.kind).toBe("confirmed");
+    const fix = resolveClaireConfirmationTurn(candidate(), "No, that's wrong. It's $175.");
+    expect(fix.kind).toBe("outcome");
+  });
+});
+
+describe("Main chat — Boundary reconciliation", () => {
+  const pendingQuestion: BoundaryPendingQuestion = {
+    kind: "open",
+    expects: "free",
+    role: "recipient",
+    outstandingRoles: ["recipient", "goal", "subject", "outcome"],
+  };
+  const boundary = (userText: string) =>
+    resolveConversationBoundary({
+      userText,
+      turn: 2,
+      activeTopic: { topicId: "t", goal: "Help me write an email to my client", resolved: false, startedAtTurn: 1, updatedAtTurn: 1 },
+      activeWork: { kind: "create", id: "uc:email", artifactType: "email", awaitingAnswer: true, suspendable: true },
+      pendingQuestion,
+      lastAssistantText: "Who is receiving this email?",
+    });
+  const session = {
+    documentType: "email",
+    phase: "discovery",
+    confidence: "high",
+    answers: {},
+    questionIndex: 1,
+    originalUserText: "Help me write an email to my client",
+    startedAtTurn: 1,
+    preparationReady: false,
+    pendingEnhancements: [],
+    lifecycle: "active",
+  } as unknown as UniversalCreationSession;
+
+  it("a clarification holds the thread (not a switch, not an answer) and is never a Create answer", () => {
+    const d = boundary("I'm not sure. Help me figure that out.");
+    expect(d.decision).toBe("continue_current_topic");
+    expect(isMeaningHold(d)).toBe(true);
+    const rel = classifyCreateTurnRelationship({ userText: "I'm not sure. Help me figure that out.", session, boundaryDecision: d });
+    expect(rel.relationship).not.toBe("answer-create-question");
+  });
+  it("a real answer is still a Create discovery answer", () => {
+    const d = boundary("My accountant");
+    expect(d.decision).toBe("answer_pending_question");
+    const rel = classifyCreateTurnRelationship({ userText: "My accountant", session, boundaryDecision: d });
+    expect(rel.relationship).toBe("answer-create-question");
+  });
+  it("kill switch restores the unreconciled transition", () => {
