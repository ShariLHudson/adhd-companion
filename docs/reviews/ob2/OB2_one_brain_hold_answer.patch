+++ b/lib/businessProfileFounder/claireConfirmationTurn.ts
@@ -0,0 +1,45 @@
+/**
+ * Claire confirmation turn — OB-2.
+ *
+ * While Claire is waiting for the member to confirm a business fact, One Brain
+ * decides what the member is doing. A question, a request to explain, "I'm not
+ * sure", or an unclear reply HOLDS the candidate (nothing is written or
+ * dropped) and Claire explains in her own words. A clear yes / no / change /
+ * correction goes to Claire's own confirmation contract, unchanged.
+ */
+
+import { renderRoomHoldReply, roomTurnVerdict } from "@/lib/conversationBoundaryRoomGate";
+import {
+  parseMemberConfirmationResponse,
+  type MemberConfirmationOutcome,
+} from "./confirmationContract";
+import type { ProfileWriteCandidate } from "./writeCandidateContract";
+
+export type ClaireConfirmationTurn =
+  | { kind: "hold"; reply: string }
+  | { kind: "outcome"; outcome: MemberConfirmationOutcome };
+
+export function resolveClaireConfirmationTurn(
+  candidate: ProfileWriteCandidate,
+  memberLine: string,
+): ClaireConfirmationTurn {
+  const question = candidate.confirmationPrompt?.trim() || "Should I save that to your business picture?";
+  const verdict = roomTurnVerdict({
+    userText: memberLine,
+    question: { text: question, expects: "yes_no" },
+    hasCorrectionSpecialist: true,
+  });
+  if (verdict.kind === "hold") {
+    return {
+      kind: "hold",
+      reply: renderRoomHoldReply(verdict, {
+        question,
+        meaning:
+          "I'm checking before I save anything — I only update your business picture when you tell me it's right, so nothing changes by accident.",
+        help:
+          "There's no rush. You can say it's right, tell me what to change, or ask me to leave it as it is — I won't save it until you do.",
+      }),
+    };
+  }
+  return { kind: "outcome", outcome: parseMemberConfirmationResponse(candidate, memberLine) };
+}
