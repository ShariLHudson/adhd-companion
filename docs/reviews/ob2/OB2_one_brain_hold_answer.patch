@@ -0,0 +1,95 @@
+/**
+ * OB-2 One Brain consumer isolation (replaces the OB-1 shadow-isolation test).
+ *
+ * OB-2 turns the meaning contract on — but through ONE gate. Proves:
+ * - only the room gate calls `permitsFor` or reads the meaning fields;
+ * - rooms touch the meaning module only for the kill switch;
+ * - production never imports the certification harness or the
+ *   evaluation-only model read (approach A: no model tier).
+ */
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+
+const ROOT = path.resolve(__dirname, "../..");
+const SCAN_DIRS = ["app", "components", "lib", "proxy.ts"];
+
+function productionFiles(): string[] {
+  const out: string[] = [];
+  const walk = (p: string) => {
+    const st = statSync(p);
+    if (st.isDirectory()) {
+      if (/node_modules|\.next|__tests__/.test(p)) return;
+      for (const f of readdirSync(p)) walk(path.join(p, f));
+      return;
+    }
+    if (!/\.(ts|tsx)$/.test(p) || /\.test\.(ts|tsx)$/.test(p)) return;
+    out.push(path.relative(ROOT, p));
+  };
+  for (const d of SCAN_DIRS) {
+    try {
+      walk(path.join(ROOT, d));
+    } catch {
+      // optional entry
+    }
+  }
+  return out;
+}
+
+const BOUNDARY = new Set([
+  "lib/conversationBoundary.ts",
+  "lib/conversationBoundaryMeaning.ts",
+  "lib/conversationBoundaryLexicon.ts",
+]);
+const GATE = "lib/conversationBoundaryRoomGate.ts";
+const HARNESS = "lib/oneBrainCertification/";
+
+describe("OB-2 One Brain consumers", () => {
+  const files = productionFiles().filter((f) => !f.startsWith(HARNESS));
+  const read = (f: string) => readFileSync(path.join(ROOT, f), "utf8");
+
+  it("production never imports the certification harness or the evaluation-only model read", () => {
+    expect(files.filter((f) => /from\s+["'][^"']*oneBrainCertification[^"']*["']/.test(read(f)))).toEqual([]);
+  });
+
+  it("only the room gate calls permitsFor; only Boundary calls the reader", () => {
+    const permits = files.filter((f) => !BOUNDARY.has(f) && /\bpermitsFor\s*\(/.test(read(f)));
+    expect(permits).toEqual([GATE]);
+    const reader = files.filter(
+      (f) => f !== "lib/conversationBoundaryMeaning.ts" && /readBoundaryMeaning\s*\(/.test(read(f)),
+    );
+    expect(reader).toEqual(["lib/conversationBoundary.ts"]);
+  });
+
+  it("only the room gate reads the meaning fields; rooms use the gate, not the fields", () => {
+    const re =
+      /(?:[bB]oundaryDecision|turnBoundaryDecision|boundary|\bdecision)\??\.(?:relation|stance|affect|binding|meaningConfidence)\b|\bmeaningConfidence\b/;
+    const readers = files.filter((f) => !BOUNDARY.has(f) && f !== GATE && re.test(read(f)));
+    expect(readers).toEqual([]);
+  });
+
+  it("rooms import the meaning module only for the kill switch", () => {
+    const importers = files.filter(
+      (f) => !BOUNDARY.has(f) && f !== GATE && /from\s+["'][^"']*conversationBoundaryMeaning["']/.test(read(f)),
+    );
+    for (const f of importers) {
+      const m = read(f).match(/import\s*\{([^}]*)\}\s*from\s*["'][^"']*conversationBoundaryMeaning["']/);
+      const names = (m?.[1] ?? "").split(",").map((x) => x.trim()).filter(Boolean);
+      expect(names, f).toEqual(["isBoundaryMeaningHoldEnabled"]);
+    }
+  });
+
+  it("every converged room entry goes through the One Brain gate", () => {
+    const entries = [
+      "lib/board/boardDiscussion/boardDirectorDiscussion.ts",
+      "lib/board/reconstructed/orchestration/boardMemberQuestions.ts",
+      "lib/eventsIntelligence/applyEventConversationalAnswer.ts",
+      "lib/strategyApplyCoach.ts",
+      "lib/strategyChamber/guidedJourney.ts",
+      "lib/day-designer/dayMessages.ts",
+      "lib/createEstate/entranceUnderstanding.ts",
+      "lib/businessProfileFounder/claireConfirmationTurn.ts",
+    ];
+    for (const f of entries) expect(read(f), f).toMatch(/\broomTurnVerdict\s*\(/);
+  });
+});
