@@ -0,0 +1,209 @@
+/**
+ * OB-5 — capability PROJECTION (names, purposes, connection facts) read from
+ * the Estate's existing registries. Import-light on purpose: the server
+ * prompt builder imports this without the client-side owner recognizers.
+ * See `./readPath.ts` for the full read path.
+ */
+
+import { BP2_PROFILE_AREAS } from "@/lib/businessProfileFounder/profileNavigatorModel";
+import { BOARD_ROOM_ENTRANCE_COPY, BOARD_ROOM_PLACE_NAME } from "@/lib/board/visualFoundation/boardRoomEntranceCopy";
+import { getChamberMemberById } from "@/lib/chamber/chamberMemberRegistry";
+import { APP_FEATURES, type AppFeatureId } from "@/lib/appFeatureKnowledge";
+import { MY_DAY_AND_WORK_DESTINATIONS } from "@/lib/estate/myDayAndWorkNavigation";
+import { capabilityById } from "@/lib/estateCapabilityRegistry/catalog";
+import { listStrategyTypes } from "@/lib/strategyChamber/intelligence/registry";
+import { CAPABILITY_CONNECTIONS, type CapabilityConnection, type OneBrainCapabilityId } from "./connections";
+
+/** Where a projected fact came from (registry + id), for provenance. */
+export type CapabilitySource = { registry: string; id: string };
+
+/** The projected, read-only view One Brain and the model share. */
+export type CapabilityProjection = {
+  id: OneBrainCapabilityId;
+  name: string;
+  purpose: string;
+  /** When the owner itself says to use it (owner copy), if it says. */
+  whenToUse?: string;
+  sources: CapabilitySource[];
+  connection: CapabilityConnection;
+};
+
+// ── Projection (names / purposes read from the source registries) ───────────
+
+export function feature(id: AppFeatureId) {
+  return APP_FEATURES.find((f) => f.id === id) ?? null;
+}
+
+function place(id: string) {
+  return MY_DAY_AND_WORK_DESTINATIONS.find((d) => d.id === id) ?? null;
+}
+
+function catalog(id: string) {
+  return capabilityById(id);
+}
+
+function project(id: OneBrainCapabilityId): Omit<CapabilityProjection, "connection"> {
+  switch (id) {
+    case "claire":
+      return {
+        id,
+        name: "Claire (My Business Estate)",
+        purpose: `Keeps Spark's understanding of your business — ${BP2_PROFILE_AREAS.map((a) => a.label).join(", ")}.`,
+        sources: [{ registry: "businessProfileFounder/profileNavigatorModel", id: "BP2_PROFILE_AREAS" }],
+      };
+    case "board":
+      return {
+        id,
+        name: BOARD_ROOM_PLACE_NAME,
+        purpose: BOARD_ROOM_ENTRANCE_COPY.howItWorksWhat,
+        whenToUse: BOARD_ROOM_ENTRANCE_COPY.howItWorksWhen,
+        sources: [{ registry: "board/visualFoundation/boardRoomEntranceCopy", id: "howItWorks" }],
+      };
+    case "research": {
+      const c = catalog("research.current");
+      return {
+        id,
+        name: place("research-library")?.label ?? "Research",
+        purpose: c?.purpose ?? c?.description ?? "Research a question with sources.",
+        sources: [
+          { registry: "estateCapabilityRegistry", id: "research.current" },
+          { registry: "estate/myDayAndWorkNavigation", id: "research-library" },
+        ],
+      };
+    }
+    case "projects": {
+      const f = feature("projects");
+      return {
+        id,
+        name: f?.name ?? "Projects",
+        purpose: f?.howTo ?? "Your projects and their next steps.",
+        sources: [
+          { registry: "appFeatureKnowledge", id: "projects" },
+          { registry: "estateCapabilityRegistry", id: "momentum.projects" },
+        ],
+      };
+    }
+    case "events": {
+      const m = getChamberMemberById("events");
+      return {
+        id,
+        name: m?.displayName ?? "Events",
+        purpose: m?.specialty ?? "Events",
+        sources: [{ registry: "chamber/chamberMemberRegistry", id: "events" }],
+      };
+    }
+    case "strategy_chamber":
+      return {
+        id,
+        name: "Strategy Chamber",
+        purpose: `Structured strategy thinking: ${listStrategyTypes()
+          .map((t) => t.name)
+          .join(", ")}.`,
+        sources: [{ registry: "strategyChamber/intelligence/registry", id: "STRATEGY_TYPES" }],
+      };
+    case "create": {
+      const f = feature("create");
+      return {
+        id,
+        name: f?.name ?? "Create",
+        purpose: f?.howTo ?? "Make something together.",
+        sources: [{ registry: "appFeatureKnowledge", id: "create" }],
+      };
+    }
+    case "plan_my_day": {
+      const f = feature("plan-my-day");
+      return {
+        id,
+        name: f?.name ?? "Plan My Day",
+        purpose: f?.howTo ?? "Decide what today holds.",
+        sources: [{ registry: "appFeatureKnowledge", id: "plan-my-day" }],
+      };
+    }
+    case "reminders":
+      return {
+        id,
+        name: place("reminders")?.label ?? "Reminders",
+        purpose: "A one-time reminder at the time you choose.",
+        sources: [{ registry: "estate/myDayAndWorkNavigation", id: "reminders" }],
+      };
+    case "rhythms":
+      return {
+        id,
+        name: place("rhythms")?.label ?? "Rhythms",
+        purpose: "Something you do again and again — every day, week or month.",
+        sources: [{ registry: "estate/myDayAndWorkNavigation", id: "rhythms" }],
+      };
+    case "visual_thinking":
+      return {
+        id,
+        name: place("cartographers-studio")?.label ?? "Visual Thinking Studio",
+        purpose: catalog("visual.model")?.purpose ?? "See your thinking laid out visually.",
+        sources: [
+          { registry: "estate/myDayAndWorkNavigation", id: "cartographers-studio" },
+          { registry: "estateCapabilityRegistry", id: "visual.model" },
+        ],
+      };
+    case "client_avatars": {
+      const f = feature("client-avatars");
+      return {
+        id,
+        name: f?.name ?? "Client Avatars",
+        purpose: f?.howTo ?? "Who you help, one question at a time.",
+        sources: [{ registry: "appFeatureKnowledge", id: "client-avatars" }],
+      };
+    }
+    case "lmc":
+      return {
+        id,
+        name: "Living Model Canvas",
+        purpose: BOARD_ROOM_ENTRANCE_COPY.livingModelNote,
+        sources: [{ registry: "board/visualFoundation/boardRoomEntranceCopy", id: "livingModelNote" }],
+      };
+  }
+}
+
+export function capabilityProjection(id: OneBrainCapabilityId): CapabilityProjection {
+  return { ...project(id), connection: CAPABILITY_CONNECTIONS[id] };
+}
+
+export function listCapabilityProjections(): CapabilityProjection[] {
+  return (Object.keys(CAPABILITY_CONNECTIONS) as OneBrainCapabilityId[]).map(capabilityProjection);
+}
+
+// ── Model projection (the same source, compact) ──────────────────────────────
+
+/** First sentence of an owner's own copy (the projection stays compact). */
+function firstSentence(text: string): string {
+  const t = text.trim();
+  const m = t.match(/^.*?[.!?](?=\s|$)/);
+  return (m ? m[0] : `${t}.`).trim();
+}
+
+const MODE_LINE: Record<CapabilityConnection["mode"], string> = {
+  acts_with_confirmation: "can change things after you confirm",
+  acts: "can set this up directly",
+  advises: "thinks it through with you; changes nothing on its own",
+  navigates: "opens a place for you to work",
+};
+
+/**
+ * The smallest useful projection for the model prompt: what exists, what it
+ * is for, whether it can act or only advise, how the member gets there, and
+ * the honest limit. Replaces hand-written feature lists as the authority for
+ * Estate capability awareness.
+ */
+export function buildCapabilityPromptBlock(): string {
+  const lines = listCapabilityProjections().map((p) => {
+    const c = p.connection;
+    const reach =
+      c.status === "disconnected"
+        ? `not reachable from chat yet (${c.reach})`
+        : c.reach;
+    return `- ${p.name}: ${firstSentence(p.purpose)} It ${MODE_LINE[c.mode]}. Reach: ${reach}.${c.cannot ? ` Limit: ${c.cannot}` : ""}`;
+  });
+  return [
+    "ESTATE CAPABILITIES (authoritative — read from the Estate's registries; overrides any feature list elsewhere in this prompt):",
+    ...lines,
+    "You cannot open, save, send or change anything yourself — Spark's owners do, and only through their own confirmation. Never claim a capability acted unless the conversation shows it did. For features not listed here use APP FEATURE KNOWLEDGE; never invent a capability.",
+  ].join("\n");
+}
diff --git a/lib/oneBrainCapability/readPath.ts b/lib/oneBrainCapability/readPath.ts
new file mode 100644
index 00000000..0aa8d190
--- /dev/null
+++ b/lib/oneBrainCapability/readPath.ts
@@ -0,0 +1,201 @@
+/**
+ * OB-5 — ONE capability read path for One Brain.
+ *
+ * NOT another catalog. Every name, purpose and recognizer below is READ from
+ * the Estate's existing authoritative registries and owner modules:
+ *
+ *   - capability catalog      lib/estateCapabilityRegistry (consult + entries)
+ *   - Estate knowledge        lib/estateBrain/knowledgeRegistry (via search)
+ *   - app feature knowledge   lib/appFeatureKnowledge (APP_FEATURES)
+ *   - My Day & Work places    lib/estate/myDayAndWorkNavigation
+ *   - Board Room canon copy   lib/board/visualFoundation/boardRoomEntranceCopy
+ *   - Claire's area model     lib/businessProfileFounder/profileNavigatorModel
+ *   - Strategy Chamber types  lib/strategyChamber/intelligence/registry
+ *   - Chamber member cards    lib/chamber/chamberMemberRegistry
+ *
+ * and each owner's OWN recognizer (the function its existing seam already
+ * uses). The only thing this module adds is the wiring: which registry entry
+ * and which recognizer belong to which existing owner, plus the traced facts
+ * about how One Brain reaches that owner and where its result goes (the
+ * adapter table in `./connections.ts`). No member-need vocabulary is added.
+ */
+
+import { BOARD_ROOM_ENTRANCE_COPY } from "@/lib/board/visualFoundation/boardRoomEntranceCopy";
+import { consultEstateCapabilities } from "@/lib/estateCapabilityRegistry";
+import { matchStrategyTypesFromText } from "@/lib/strategyChamber/intelligence/registry";
+import { detectBusinessEstateNavIntent, detectBusinessProfileNavIntent } from "@/lib/businessEstateNavIntent";
+import { detectClientAvatarExploration } from "@/lib/clientAvatarOffer";
+import { classifyMemberIntent } from "@/lib/memberIntent/classifyMemberIntent";
+import { detectEventIntent } from "@/lib/eventsIntelligence/detectEventIntent";
+import { resolveExecutableRequest } from "@/lib/memberIntent/executableRequest";
+import { resolveExplicitCapabilityIntent } from "@/lib/universalAccess/resolveExplicitCapabilityIntent";
+import { extractProjectQuery } from "@/lib/workspaceIntent";
+import { classifyRememberIntent } from "@/lib/rhythms/fromContent";
+import type { OneBrainCapabilityId } from "./connections";
+import { feature } from "./projection";
+
+export type { OneBrainCapabilityId } from "./connections";
+export {
+  buildCapabilityPromptBlock,
+  capabilityProjection,
+  listCapabilityProjections,
+  type CapabilityProjection,
+  type CapabilitySource,
+} from "./projection";
+
+/**
+ * One recognition by an existing owner recognizer. `owner` = the owner's own
+ * seam recognizer fired (authoritative for that owner); `catalog` = only the
+ * shared catalog consult matched (weaker — a candidate, not a claim).
+ */
+export type CapabilityRecognition = {
+  id: OneBrainCapabilityId;
+  strength: "owner" | "catalog";
+  /** Which existing recognizer fired (file:function). */
+  recognizer: string;
+  /** Owner-specific detail the recognizer produced (project query, area…). */
+  detail?: Record<string, string>;
+};
+
+// ── Recognition (each owner's EXISTING recognizer) ───────────────────────────
+
+const CATALOG_TO_CAPABILITY: Record<string, OneBrainCapabilityId> = {
+  "research.current": "research",
+  "research.known": "research",
+  "research.deep": "research",
+};
+
+/** Catalog consult score at which a catalog match is a usable candidate. */
+const CATALOG_CANDIDATE_MIN = 60;
+
+
+/**
+ * Run the existing owner recognizers on the member's text. Pure reads — no
+ * owner state is written. Order is irrelevant; selection ranks by strength.
+ */
+export function recognizeCapabilities(text: string): CapabilityRecognition[] {
+  const t = text.trim();
+  if (!t) return [];
+  const out: CapabilityRecognition[] = [];
+  const add = (r: CapabilityRecognition) => {
+    if (!out.some((o) => o.id === r.id && o.strength === r.strength)) out.push(r);
+  };
+
+  // Claire — the seam that already opens My Business Estate from chat.
+  if (detectBusinessEstateNavIntent(t)) {
+    add({
+      id: "claire",
+      strength: "owner",
+      recognizer: "lib/businessEstateNavIntent.ts:detectBusinessEstateNavIntent",
+      detail: { intent: detectBusinessProfileNavIntent(t) ? "business_profile" : "business_estate" },
+    });
+  }
+  if (detectClientAvatarExploration(t)) {
+    add({ id: "client_avatars", strength: "owner", recognizer: "lib/clientAvatarOffer.ts:detectClientAvatarExploration" });
+  }
+
+  // Member-intent classifier (continuity gate): Board / Project / New document.
+  let bucket: string | null = null;
+  try {
+    bucket = classifyMemberIntent({ userText: t } as Parameters<typeof classifyMemberIntent>[0]).bucket;
+  } catch {
+    bucket = null;
+  }
+  if (bucket === "board_member") {
+    add({ id: "board", strength: "owner", recognizer: "lib/memberIntent/classifyMemberIntent.ts:board_member" });
+  }
+  if (bucket === "new_document") {
+    add({ id: "create", strength: "owner", recognizer: "lib/memberIntent/classifyMemberIntent.ts:new_document" });
+  }
+
+  // Projects — the existing project-name extractor (and the project bucket).
+  const projectQuery = extractProjectQuery(t);
+  if (projectQuery || bucket === "project") {
+    add({
+      id: "projects",
+      strength: "owner",
+      recognizer: projectQuery
+        ? "lib/workspaceIntent.ts:extractProjectQuery"
+        : "lib/memberIntent/classifyMemberIntent.ts:project",
+      detail: projectQuery ? { projectQuery } : undefined,
+    });
+  }
+
+  // Events Intelligence's own goal detector.
+  if (detectEventIntent(t).isClearEventGoal) {
+    add({ id: "events", strength: "owner", recognizer: "lib/eventsIntelligence/detectEventIntent.ts" });
+  }
+
+  // Strategy Chamber's own entry signals.
+  const strategy = matchStrategyTypesFromText(t)[0];
+  if (strategy) {
+    add({
+      id: "strategy_chamber",
+      strength: "owner",
+      recognizer: "lib/strategyChamber/intelligence/registry.ts:matchStrategyTypesFromText",
+      detail: { strategyType: strategy.type.id },
+    });
+  }
+
+  // Remember owner — the executable-request authority (Boundary's own stance
+  // source), else the Remember owner's content classifier.
+  const executable = resolveExecutableRequest(t);
+  const named = new Set(executable.actions.map((a) => a.capability));
+  const remember = named.size ? null : classifyRememberIntent(t);
+  if (named.has("reminder") || remember === "reminder") {
+    add({ id: "reminders", strength: "owner", recognizer: "lib/memberIntent/executableRequest.ts | lib/rhythms/fromContent.ts:classifyRememberIntent" });
+  }
+  if (named.has("rhythm") || remember === "rhythm") {
+    add({ id: "rhythms", strength: "owner", recognizer: "lib/memberIntent/executableRequest.ts | lib/rhythms/fromContent.ts:classifyRememberIntent" });
+  }
+
+  // Universal access — explicit capability opens (visual thinking, plan my day…).
+  const universal = resolveExplicitCapabilityIntent(t);
+  if (universal?.capabilityId === "visual-thinking") {
+    add({ id: "visual_thinking", strength: "owner", recognizer: "lib/universalAccess:visual-thinking" });
+  }
+  if (universal?.capabilityId === "plan-my-day") {
+    add({ id: "plan_my_day", strength: "owner", recognizer: "lib/universalAccess:plan-my-day" });
+  }
+
+  // App feature knowledge — Plan My Day's own match patterns.
+  if (feature("plan-my-day")?.match.some((re) => re.test(t))) {
+    add({ id: "plan_my_day", strength: "owner", recognizer: "lib/appFeatureKnowledge.ts:plan-my-day" });
+  }
+
+  // Shared capability catalog consult — a candidate only.
+  for (const m of consultEstateCapabilities(t, { limit: 3 })) {
+    const id = CATALOG_TO_CAPABILITY[m.entry.id];
+    if (id && m.score >= CATALOG_CANDIDATE_MIN) {
+      add({ id, strength: "catalog", recognizer: `lib/estateCapabilityRegistry:${m.entry.id}` });
+    }
+  }
+
+  // Board Room canon — the member used one of the Board's OWN phrases for what
+  // it is for ("several perspectives"): adjacent content-word pairs of the
+  // Founder-approved "how it works" copy. A candidate, never a claim.
+  if (!out.some((o) => o.id === "board") && usesOwnerPhrase(t, BOARD_ROOM_ENTRANCE_COPY.howItWorksWhat)) {
+    add({
+      id: "board",
+      strength: "catalog",
+      recognizer: "lib/board/visualFoundation/boardRoomEntranceCopy.ts:howItWorksWhat",
+    });
+  }
+
+  return out;
+}
+
+const PHRASE_STOP = new Set(["that", "with", "this", "something", "your", "place", "room", "stay", "charge"]);
+
+/** True when the text contains an adjacent content-word pair from the owner's copy. */
+function usesOwnerPhrase(text: string, ownerCopy: string): boolean {
+  const words = ownerCopy.toLowerCase().replace(/[^a-z\s]/g, " ").split(/\s+/).filter(Boolean);
+  const hay = ` ${text.toLowerCase().replace(/[^a-z\s]/g, " ").replace(/\s+/g, " ")} `;
+  for (let i = 0; i + 1 < words.length; i += 1) {
+    const [a, b] = [words[i], words[i + 1]];
+    if (a.length < 5 || b.length < 5 || PHRASE_STOP.has(a) || PHRASE_STOP.has(b)) continue;
+    if (hay.includes(` ${a} ${b} `)) return true;
+  }
+  return false;
+}
+
