+    handoff: "research_launch",
+    returnPath: "main_chat",
+    status: "partially_connected",
+    reach: "Spark opens the Research Library with your question",
+    contextCarried: ["member's question", "what 'this' refers to (active topic)", "member decisions in play"],
+    cannot:
+      "Research runs in the Research Library, not in chat. Findings come back into this conversation only while a project is active.",
+    evidence:
