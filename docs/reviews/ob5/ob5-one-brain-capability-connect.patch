+      const plan = planChoiceAcceptance(payload, pb.scope[0] as never);
+      return { decision, selection, plan, accepted: null };
+    }
+    return { decision, selection, plan: null, accepted: payload };
+  }
+  const plan = selection
+    ? planCapabilityTurn({ selection, userText: text, peopleIHelp: detectClientAvatarExploration(text) })
+    : null;
+  if (plan?.kind === "offer") {
+    armPendingReply({
+      bindKey: plan.bindKey,
+      offeredAtTurn: n,
+      handoff: plan.payload as unknown as Record<string, unknown>,
+      ...(plan.items ? { items: plan.items } : {}),
+    });
