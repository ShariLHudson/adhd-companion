--- /dev/null
+++ b/lib/oneBrainCapability/returns.ts
@@ -0,0 +1,139 @@
+/**
+ * OB-5 — return architecture: where an owner's result goes after a handoff.
+ *
+ * No new result store. Returns are PROJECTIONS over the owners' own records
+ * (the Research-return pattern, `conversationResearchReturn.ts`):
+ *
+ *   - Board  → the Board's discussion record (`listBoardDirectorDiscussions`)
+ *              through the certified projection the Board already exposes
+ *              (`buildCertifiedV2BoardContextProjection`). Only discussions the
+ *              member started FROM CHAT (`sourceContext.source === "chat_invite"`).
+ *   - Claire → a one-shot note Claire leaves when a member-CONFIRMED write
+ *              commits (`claireChatHandoff.ts`); on return the page records it
+ *              as the OB-4 receipt so "change it" binds to Claire's work.
+ *
+ * The next useful action (if any) is armed on the ONE pending record (OB-3)
+ * so "okay, let's do that" binds to exactly it. The Board sets no next step
+ * (BC-6): the only next action derived here is researching the evidence the
+ * Board itself said is missing.
+ */
+
+import { listBoardDirectorDiscussions } from "@/lib/board/boardDiscussion/boardDirectorDiscussion";
+import { buildCertifiedV2BoardContextProjection } from "@/lib/board/contextTransfer/certifiedV2BoardContextProjection";
+import { findResearchCollectionsBySourceEntity } from "@/lib/researchLibrary/persistence";
+import { buildResearchReturnPackage } from "@/lib/researchLibrary/conversationResearchReturn";
+import type { CapabilityHandoffPayload } from "./handoffs";
+
+export type BoardReturn = {
+  discussionId: string;
+  /** What was discussed (the decision in the member's framing). */
+  discussed: string;
+  /** The member's own settled decision, if they made one. */
+  memberDecision: string | null;
+  decisionStatus: "decided" | "deferred" | "evidence_needed" | "reopen_required" | "unresolved";
+  /** Strongest dissent the Board recorded (kept distinct from the decision). */
+  dissent: string | null;
+  /** What the Board said is still unresolved. */
+  unresolved: string[];
+  /** The one next action One Brain may offer (research the missing evidence). */
+  nextAction: { label: string; handoff: Extract<CapabilityHandoffPayload, { kind: "research_launch" }> } | null;
+  updatedAt: string;
+};
+
+/**
+ * The newest Board discussion started from main chat, updated at/after
+ * `sinceIso` (the handoff time), as a compact return. Null when there is none
+ * or it is not a certified discussion (no fabricated summary).
+ */
+export function boardReturnForConversation(sinceIso: string | null): BoardReturn | null {
+  const records = listBoardDirectorDiscussions()
+    .filter((r) => r.sourceContext?.source === "chat_invite")
+    .filter((r) => !sinceIso || (r.updatedAt ?? "") >= sinceIso)
+    .sort((a, b) => ((b.updatedAt ?? "") > (a.updatedAt ?? "") ? 1 : -1));
+  for (const record of records) {
+    const projection = buildCertifiedV2BoardContextProjection(record);
+    if (!projection) continue;
+    const opportunity = record.certifiedSynthesis?.researchOpportunity ?? null;
+    const unresolved = [...projection.unresolvedEvidence].filter((u) => u.trim());
+    const researchQuestion =
+      opportunity?.boundedQuestion?.trim() ||
+      record.sharedHandoff?.evidenceRequest?.evidenceNeeded?.trim() ||
+      (projection.decisionStatus === "evidence_needed" ? unresolved[0] : "") ||
+      "";
+    return {
+      discussionId: projection.discussionId,
+      discussed: projection.issueFraming,
+      memberDecision: projection.memberSettledDecision ?? null,
+      decisionStatus: projection.decisionStatus,
+      dissent: projection.materialDissent ?? null,
+      unresolved,
+      nextAction: researchQuestion
+        ? {
+            label: `Research: ${researchQuestion}`,
+            handoff: {
+              kind: "research_launch",
+              memberRequest: researchQuestion,
+              sourceRoom: "board",
+              sourceId: projection.discussionId,
+              returnTo: "main_chat",
+            },
+          }
+        : null,
+      updatedAt: projection.lastUpdatedAt,
+    };
+  }
+  return null;
+}
+
+/** The smallest useful member-facing return. Never the transcript. */
+export function formatBoardReturnMessage(ret: BoardReturn): string {
+  const lines = [`Back from the Board. You brought: “${ret.discussed}”.`];
+  if (ret.memberDecision) lines.push(`You decided: ${ret.memberDecision}`);
+  else if (ret.decisionStatus === "deferred") lines.push("You chose to hold the decision for now.");
+  else lines.push("You haven't settled it yet — the decision stays yours.");
+  if (ret.dissent) lines.push(`Strongest pushback: ${ret.dissent}`);
+  if (ret.unresolved.length) lines.push(`Still open: ${ret.unresolved.slice(0, 2).join("; ")}`);
+  if (ret.nextAction) {
+    lines.push(`Want me to take “${ret.nextAction.handoff.memberRequest}” to Research?`);
+  }
+  return lines.join("\n");
+}
+
+/** Model context for the turns after a Board return (labelled, compact). */
+export function formatBoardReturnHint(ret: BoardReturn): string {
+  return [
+    "BOARD RETURN (the member's own Board discussion, started from this chat — do not re-summarize unless asked):",
+    `Discussed: ${ret.discussed}`,
+    `Member decision: ${ret.memberDecision ?? "(not settled — the decision is the member's)"}`,
+    ret.dissent ? `Strongest dissent: ${ret.dissent}` : "",
+    ret.unresolved.length ? `Unresolved: ${ret.unresolved.join("; ")}` : "",
+    "The Board advises; it set no next step. Never present the Board's view as the member's decision.",
+  ]
+    .filter(Boolean)
+    .join("\n");
+}
+
+export type BoardResearchReturn = {
+  question: string;
+  synthesis: string | null;
+  sourcedCount: number;
+  uncertainties: string[];
+};
+
+/**
+ * Research → Board: the newest Research collection launched FROM this Board
+ * discussion, projected through Research's own return package (sourced
+ * findings stay distinct from member / Spark material). Null when none.
+ */
+export function researchReturnForBoard(discussionId: string): BoardResearchReturn | null {
+  const pool = findResearchCollectionsBySourceEntity("board", discussionId);
+  if (!pool.length) return null;
+  const newest = pool.reduce((a, b) => ((b.updatedAt ?? "") > (a.updatedAt ?? "") ? b : a));
+  const pkg = buildResearchReturnPackage(newest);
+  return {
+    question: pkg.question,
+    synthesis: pkg.synthesis,
+    sourcedCount: pkg.sourcedFindings.length,
+    uncertainties: pkg.uncertainties,
+  };
+}
diff --git a/lib/oneBrainCapability/selectCapability.ts b/lib/oneBrainCapability/selectCapability.ts
new file mode 100644
index 00000000..8b065053
--- /dev/null
+++ b/lib/oneBrainCapability/selectCapability.ts
@@ -0,0 +1,105 @@
+/**
+ * OB-5 — capability selection: the CONNECT step of the One Brain turn.
+ *
+ * Boundary already decided WHAT the member is doing, and OB-3 / OB-4 decided
+ * what a reply binds to. This decides WHICH EXISTING capability owner is
+ * relevant — once per turn, from the same Boundary decision (read through the
+ * One Brain gate's `capabilityTurnEligibility`) plus the read path's
+ * recognitions. It adds no meaning classifier: request-vs-discussion is
+ * Boundary's stance, a hold on the current thread is Boundary's hold, and LOW
+ * certainty is Boundary's meaning certainty.
+ *
+ * Output kinds:
+ *   - route   One Brain connects the owner (Claire / Board / Research / Projects).
+ *   - confirm Meaning was LOW (or only a catalog candidate): offer, never connect.
+ *   - ask     Two owners fit equally: a short choice, nothing runs.
+ *   - defer   An existing seam owns this capability; One Brain records only.
+ *   - none    No capability, or the turn belongs to a binding / hold / discussion.
+ *
+ * Selection itself never writes, opens or executes anything.
+ */
+
+import type { ConversationBoundaryDecision } from "@/lib/conversationBoundary";
+import { isBoundaryMeaningHoldEnabled } from "@/lib/conversationBoundaryMeaning";
+import {
+  capabilityTurnEligibility,
+  type CorrectionBinding,
+  type PendingBinding,
+} from "@/lib/conversationBoundaryRoomGate";
+import { isOneBrainConnected, type OneBrainCapabilityId } from "./connections";
+import { recognizeCapabilities, type CapabilityRecognition } from "./readPath";
+
+export type CapabilitySelection =
+  | { kind: "route"; id: OneBrainCapabilityId; recognition: CapabilityRecognition }
+  | { kind: "confirm"; id: OneBrainCapabilityId; recognition: CapabilityRecognition }
+  | { kind: "ask"; options: [CapabilityRecognition, CapabilityRecognition] }
+  | { kind: "defer"; id: OneBrainCapabilityId; recognition: CapabilityRecognition }
+  | {
+      kind: "none";
+      reason:
+        | "pending_binding"
+        | "correction"
+        | "relation"
+        | "held_on_thread"
+        | "discussion"
+        | "no_capability";
+    };
+
+/** Kill switch: OB-5 capability connection (default on). */
+export function isCapabilityConnectEnabled(): boolean {
+  if (!isBoundaryMeaningHoldEnabled()) return false;
+  if (typeof process === "undefined") return true;
+  return process.env.NEXT_PUBLIC_ONE_BRAIN_CAPABILITY_CONNECT !== "0";
+}
+
+export function resolveCapabilitySelection(input: {
+  decision: ConversationBoundaryDecision;
+  userText: string;
+  pendingBinding: PendingBinding | null;
+  correctionBinding: CorrectionBinding | null;
+}): CapabilitySelection | null {
+  if (!isCapabilityConnectEnabled()) return null;
+  // Boundary's meaning, read through the One Brain gate (the one reader).
+  const eligibility = capabilityTurnEligibility(input);
+  if (eligibility.kind === "not_eligible") {
+    const reason =
+      eligibility.reason === "binding" ? "pending_binding" : eligibility.reason;
+    return { kind: "none", reason };
+  }
+
+  const recognitions = recognizeCapabilities(input.userText);
+  const owner = recognitions.filter((r) => r.strength === "owner");
+  const pool = owner.length ? owner : recognitions.filter((r) => r.strength === "catalog");
+  if (!pool.length) return { kind: "none", reason: "no_capability" };
+
+  // A recognizer that extracted the object it acts on (a named project, a
+  // strategy type, a profile intent) is more specific than one that did not.
+  const specific = pool.filter((r) => r.detail && Object.keys(r.detail).length > 0);
+  const ranked = distinctById(specific.length ? specific : pool);
+
+  const connected = ranked.filter((r) => isOneBrainConnected(r.id));
+  const deferred = ranked.filter((r) => !isOneBrainConnected(r.id));
+
+  // A catalog-only candidate never overrides an owner seam's own recognition.
+  if (!owner.length && deferred.length) {
+    return { kind: "defer", id: deferred[0].id, recognition: deferred[0] };
+  }
+  if (connected.length >= 2) {
+    return { kind: "ask", options: [connected[0], connected[1]] };
+  }
+  if (connected.length === 1) {
+    // Another existing owner claims the same words equally: never guess.
+    if (deferred.length) return { kind: "ask", options: [connected[0], deferred[0]] };
+    const chosen = connected[0];
+    if (eligibility.lowMeaning || chosen.strength === "catalog") {
+      return { kind: "confirm", id: chosen.id, recognition: chosen };
+    }
+    return { kind: "route", id: chosen.id, recognition: chosen };
+  }
+  return { kind: "defer", id: deferred[0].id, recognition: deferred[0] };
+}
+
+function distinctById(list: CapabilityRecognition[]): CapabilityRecognition[] {
+  const seen = new Set<OneBrainCapabilityId>();
+  return list.filter((r) => (seen.has(r.id) ? false : (seen.add(r.id), true)));
+}
