+    contextCarried: ["member's words", "the named saved project"],
+    cannot: "Spark suggests a next step only when the project has enough in it to reason from.",
+    evidence:
+      "lib/projectHomes/homeActions.ts resolveProjectHomeNextMove; lib/workspaceProjectLookup.ts searchProjects; open: openProjectHomesPrototypeCore('detail')",
