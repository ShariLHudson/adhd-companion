diff --git a/lib/businessProfileFounder/claireChatHandoff.ts b/lib/businessProfileFounder/claireChatHandoff.ts
new file mode 100644
index 00000000..81ffc592
--- /dev/null
+++ b/lib/businessProfileFounder/claireChatHandoff.ts
@@ -0,0 +1,157 @@
+/**
+ * OB-5 — main chat → Claire topic handoff, and Claire → main chat return.
+ *
+ * Mirrors the established Business Estate deep-link pattern
+ * (lib/businessEstateSectionIntent.ts): sessionStorage carries only the
+ * transient hand-off between navigation and mount. No new storage model.
+ *
+ * - Handoff: One Brain names the member's words + profile area; Claire consumes
+ *   it on mount and answers through her EXISTING topic-handoff path
+ *   (`handoffFromArea` → `talkWithClaire`), exactly like the LMC handoff.
+ * - Return: when a member-CONFIRMED write commits while a chat handoff is
+ *   active, Claire leaves a one-shot note; main chat consumes it when the
+ *   member comes back and records it as the OB-4 receipt of what changed.
+ */
+
+import { recordReceipt } from "@/lib/conversationSession/receipts";
+import type { ConversationReceipt } from "@/lib/conversationSession/types";
+import type { Bp2ProfileAreaId } from "./profileNavigatorModel";
+import { BP2_PROFILE_AREAS } from "./profileNavigatorModel";
+
+const HANDOFF_KEY = "claire-chat-handoff-pending-v1";
+const RETURN_KEY = "claire-chat-return-pending-v1";
+const ACTIVE_KEY = "claire-chat-handoff-active-v1";
+
+export type ClaireChatHandoff = {
+  memberPrompt: string;
+  areaId: Bp2ProfileAreaId;
+  /** Where the member came from — Claire returns there. */
+  source: "main_chat";
+  requestedAt: string;
+};
+
+export type ClaireChatReturn = {
+  areaId: Bp2ProfileAreaId;
+  areaLabel: string;
+  /** Short member-facing summary of what was confirmed and saved. */
+  summary: string;
+  committedAt: string;
+};
+
+function storage(): Storage | null {
+  if (typeof window === "undefined") return null;
+  try {
+    return window.sessionStorage;
+  } catch {
+    return null;
+  }
+}
+
+function isArea(value: unknown): value is Bp2ProfileAreaId {
+  return BP2_PROFILE_AREAS.some((a) => a.id === value);
+}
+
+/** Chat side: name what Claire should pick up (call BEFORE opening her). */
+export function requestClaireChatHandoff(input: { memberPrompt: string; areaId: Bp2ProfileAreaId }): void {
+  const s = storage();
+  if (!s || !input.memberPrompt.trim()) return;
+  const handoff: ClaireChatHandoff = {
+    memberPrompt: input.memberPrompt.trim(),
+    areaId: input.areaId,
+    source: "main_chat",
+    requestedAt: new Date().toISOString(),
+  };
+  try {
+    s.setItem(HANDOFF_KEY, JSON.stringify(handoff));
+  } catch {
+    /* noop */
+  }
+}
+
+/** Claire side: consume the pending handoff once, on mount. */
+export function consumeClaireChatHandoff(): ClaireChatHandoff | null {
+  const s = storage();
+  if (!s) return null;
+  try {
+    const raw = s.getItem(HANDOFF_KEY);
+    if (!raw) return null;
+    s.removeItem(HANDOFF_KEY);
+    const parsed = JSON.parse(raw) as Partial<ClaireChatHandoff>;
+    if (!parsed.memberPrompt?.trim() || !isArea(parsed.areaId)) return null;
+    // Remember that this Claire visit came from chat (for the return).
+    s.setItem(ACTIVE_KEY, "1");
+    return {
+      memberPrompt: parsed.memberPrompt.trim(),
+      areaId: parsed.areaId,
+      source: "main_chat",
+      requestedAt: parsed.requestedAt ?? new Date().toISOString(),
+    };
+  } catch {
+    return null;
+  }
+}
+
+/** Claire side: a member-confirmed write committed. Only recorded for chat visits. */
+export function recordClaireChatReturn(input: { areaId: Bp2ProfileAreaId; summary: string }): void {
+  const s = storage();
+  if (!s) return;
+  try {
+    if (s.getItem(ACTIVE_KEY) !== "1") return;
+    const area = BP2_PROFILE_AREAS.find((a) => a.id === input.areaId);
+    const ret: ClaireChatReturn = {
+      areaId: input.areaId,
+      areaLabel: area?.label ?? "your business profile",
+      summary: input.summary.trim(),
+      committedAt: new Date().toISOString(),
+    };
+    s.setItem(RETURN_KEY, JSON.stringify(ret));
+  } catch {
+    /* noop */
+  }
+}
+
+/** Chat side: consume Claire's return once, when the member comes back. */
+export function consumeClaireChatReturn(): ClaireChatReturn | null {
+  const s = storage();
+  if (!s) return null;
+  try {
+    const raw = s.getItem(RETURN_KEY);
+    s.removeItem(ACTIVE_KEY);
+    if (!raw) return null;
+    s.removeItem(RETURN_KEY);
+    const parsed = JSON.parse(raw) as Partial<ClaireChatReturn>;
+    if (!isArea(parsed.areaId) || !parsed.summary?.trim()) return null;
+    return {
+      areaId: parsed.areaId,
+      areaLabel: parsed.areaLabel ?? "your business profile",
+      summary: parsed.summary.trim(),
+      committedAt: parsed.committedAt ?? new Date().toISOString(),
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function formatClaireReturnMessage(ret: ClaireChatReturn): string {
+  return `Back from Claire. She saved this to ${ret.areaLabel}: ${ret.summary}\nIf that's not quite right, just tell me what to change.`;
+}
+
+/**
+ * OB-4 receipt for Claire's confirmed write, recorded when the member is back
+ * in chat (so "change it" binds to Claire's work on the next turn). Claire can
+ * revise in conversation (owner_supported); there is no rollback of a
+ * canonical write from chat, so undo is "none" — never a fake undo.
+ */
+export function recordClaireReturnReceipt(ret: ClaireChatReturn, turn: number): ConversationReceipt | null {
+  return recordReceipt({
+    ownerKey: "claire",
+    capability: "business_understanding",
+    operation: "update",
+    objectId: `business_understanding:${ret.areaId}`,
+    label: `${ret.areaLabel} (Claire)`,
+    committed: { area: ret.areaId, summary: ret.summary },
+    correction: "owner_supported",
+    undo: "none",
+    executedAtTurn: turn,
+  });
+}
