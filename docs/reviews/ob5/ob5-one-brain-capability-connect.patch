diff --git a/lib/oneBrainCapability/handoffs.ts b/lib/oneBrainCapability/handoffs.ts
new file mode 100644
index 00000000..4c24c545
--- /dev/null
+++ b/lib/oneBrainCapability/handoffs.ts
@@ -0,0 +1,195 @@
+/**
+ * OB-5 — context handoff builders. Pure: they decide WHAT to say and WHAT the
+ * receiving owner gets; the page executes (opens the room, arms the offer)
+ * with its existing functions. Nothing here opens, saves or executes.
+ *
+ * The handoff payload rides on the ONE pending record (OB-3 spine
+ * `expectedReply.handoff`) so "yes" / "do that" binds to exactly this offer,
+ * and a stale offer never executes.
+ */
+
+import { BOARD_PERSPECTIVE_INVITE } from "@/lib/conversationContinuity/resolveContinuityGate";
+import { loadMemberProjectHomesFromStore, resolveProjectHomeNextMove } from "@/lib/projectHomes/homeActions";
+import { getActiveProjects } from "@/lib/companionProjectsStore";
+import { scoreProjectMatch, searchProjects } from "@/lib/workspaceProjectLookup";
+import type { Bp2ProfileAreaId } from "@/lib/businessProfileFounder/profileNavigatorModel";
+import type { CapabilitySelection } from "./selectCapability";
+import type { OneBrainCapabilityId } from "./connections";
+import { capabilityProjection } from "./readPath";
+
+/** What the receiving owner gets. Never the whole conversation. */
+export type CapabilityHandoffPayload =
+  | {
+      kind: "claire_topic";
+      memberRequest: string;
+      areaId: Bp2ProfileAreaId;
+      sourceRoom: "main_chat";
+      returnTo: "main_chat";
+    }
+  | {
+      kind: "research_launch";
+      memberRequest: string;
+      /** Where the question came from (main chat or a Board discussion). */
+      sourceRoom: "main_chat" | "board";
+      sourceId?: string;
+      returnTo: "main_chat" | "board";
+    }
+  | {
+      kind: "project_home";
+      memberRequest: string;
+      projectId: string;
+      projectName: string;
+      sourceRoom: "main_chat";
+      returnTo: "main_chat";
+    }
+  | {
+      kind: "choice";
+      memberRequest: string;
+      options: OneBrainCapabilityId[];
+    };
+
+/** The ONE pending bind key family for One Brain capability offers. */
+export const CAPABILITY_BIND_PREFIX = "capability:";
+
+export type CapabilityTurnPlan =
+  /** Connect now (Claire: the member asked to update their profile). */
+  | { kind: "execute"; id: OneBrainCapabilityId; payload: CapabilityHandoffPayload; ack: string }
+  /** Reply and arm a pending offer the member can accept. */
+  | {
+      kind: "offer";
+      id: OneBrainCapabilityId;
+      reply: string;
+      bindKey: string;
+      payload: CapabilityHandoffPayload;
+      items?: { id: string; label: string }[];
+    }
+  /** Board: reuse the existing Board invite (pendingBoardInvite + "board_invite"). */
+  | { kind: "board_invite"; reply: string; sourceText: string }
+  /** Reply only (a question back, or an honest limit). Nothing is armed. */
+  | { kind: "reply"; id: OneBrainCapabilityId | null; reply: string };
+
+/**
+ * Claire's area for the member's words: the People-I-Help area when the
+ * existing Client Avatar recognizer fires; otherwise My Business (Claire
+ * resolves the rest in conversation — she owns the subject).
+ */
+export function claireAreaForRequest(detectsPeopleIHelp: boolean): Bp2ProfileAreaId {
+  return detectsPeopleIHelp ? "people-i-help" : "my-business";
+}
+
+export function planCapabilityTurn(input: {
+  selection: CapabilitySelection;
+  userText: string;
+  /** Existing Client Avatar recognizer result (for Claire's area). */
+  peopleIHelp?: boolean;
+}): CapabilityTurnPlan | null {
+  const { selection } = input;
+  const memberRequest = input.userText.trim();
+  if (selection.kind === "none" || selection.kind === "defer") return null;
+
+  if (selection.kind === "ask") {
+    const [a, b] = selection.options.map((o) => capabilityProjection(o.id));
+    return {
+      kind: "offer",
+      id: a.id,
+      reply: `I can help with that two ways — ${a.name} or ${b.name}. Which would you like?`,
+      bindKey: `${CAPABILITY_BIND_PREFIX}choice`,
+      payload: { kind: "choice", memberRequest, options: [a.id, b.id] },
+      items: [
+        { id: a.id, label: a.name },
+        { id: b.id, label: b.name },
+      ],
+    };
+  }
+
+  const confirm = selection.kind === "confirm";
+  switch (selection.id) {
+    case "claire": {
+      const payload: CapabilityHandoffPayload = {
+        kind: "claire_topic",
+        memberRequest,
+        areaId: claireAreaForRequest(Boolean(input.peopleIHelp)),
+        sourceRoom: "main_chat",
+        returnTo: "main_chat",
+      };
+      if (confirm) {
+        return {
+          kind: "offer",
+          id: "claire",
+          reply: "Claire keeps your business profile. Want me to open her in My Business Estate with what you just said?",
+          bindKey: `${CAPABILITY_BIND_PREFIX}claire`,
+          payload,
+        };
+      }
+      return {
+        kind: "execute",
+        id: "claire",
+        payload,
+        ack: "Opening Claire in My Business Estate — she'll pick up with what you just said.",
+      };
+    }
+    case "board":
+      return { kind: "board_invite", reply: BOARD_PERSPECTIVE_INVITE, sourceText: memberRequest };
+    case "research":
+      return {
+        kind: "offer",
+        id: "research",
+        reply:
+          "That deserves real sources rather than my best guess. Want me to open the Research Library with your question?",
+        bindKey: `${CAPABILITY_BIND_PREFIX}research`,
+        payload: { kind: "research_launch", memberRequest, sourceRoom: "main_chat", returnTo: "main_chat" },
+      };
+    case "projects":
+      return planProjectTurn(memberRequest, selection.recognition.detail?.projectQuery ?? null);
+    default:
+      return null;
+  }
+}
+
+/**
+ * Projects: find the SAVED project the member means, then answer with the
+ * Project Homes next-step engine (read-only) and offer its Project Home.
+ * No project → a short question, never a guess.
+ */
+export function planProjectTurn(memberRequest: string, projectQuery: string | null): CapabilityTurnPlan | null {
+  const candidates = projectQuery
+    ? searchProjects(projectQuery, 3).filter((p) => scoreProjectMatch(p, projectQuery) >= 85)
+    : getActiveProjects().slice(0, 4);
+  if (!candidates.length) return null; // nothing saved to talk about — existing flows handle it
+  if (candidates.length > 1) {
+    const names = candidates.slice(0, 3).map((p) => `“${p.name}”`);
+    return {
+      kind: "reply",
+      id: "projects",
+      reply: `Which project do you mean — ${names.slice(0, -1).join(", ")}${names.length > 1 ? " or " : ""}${names[names.length - 1]}?`,
+    };
+  }
+  const project = candidates[0];
+  const home = loadMemberProjectHomesFromStore().find((h) => h.id === project.id || h.companionProjectId === project.id);
+  const move = home ? resolveProjectHomeNextMove(home) : null;
+  const payload: CapabilityHandoffPayload = {
+    kind: "project_home",
+    memberRequest,
+    projectId: project.id,
+    projectName: project.name,
+    sourceRoom: "main_chat",
+    returnTo: "main_chat",
+  };
+  const reply = move
+    ? `For “${project.name}”, the next move I'd suggest: **${move.title}**.${move.reason ? ` ${move.reason}` : ""} Want me to open its Project Home?`
+    : `I don't know enough about “${project.name}” yet to suggest a grounded next step. Want me to open its Project Home so we can add what's going on?`;
+  return { kind: "offer", id: "projects", reply, bindKey: `${CAPABILITY_BIND_PREFIX}projects`, payload };
+}
+
+/** The handoff payload an accepted choice resolves to (the member named one). */
+export function planChoiceAcceptance(
+  payload: Extract<CapabilityHandoffPayload, { kind: "choice" }>,
+  chosen: OneBrainCapabilityId,
+): CapabilityTurnPlan | null {
+  if (!payload.options.includes(chosen)) return null;
+  const recognition = { id: chosen, strength: "owner" as const, recognizer: "member_choice" };
+  return planCapabilityTurn({
+    selection: { kind: "route", id: chosen, recognition },
+    userText: payload.memberRequest,
+  });
+}
