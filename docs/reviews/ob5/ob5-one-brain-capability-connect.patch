+    contextCarried: ["member's words", "profile area", "source: main chat"],
+    evidence:
+      "CompanionPageClient openProfileDestinationCore('my-business-estate') → ProfileDestinationHost → BusinessProfileBp2aPrototype.talkWithClaire (claireTopicHandoff.handoffFromArea); return: claireChatHandoff.recordClaireReturn → conversation receipt",
+  },
