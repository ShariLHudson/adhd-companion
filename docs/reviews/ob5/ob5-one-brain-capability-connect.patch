+/**
+ * OB-5 — the adapter table: how One Brain reaches each EXISTING owner, what
+ * that owner can actually do, and where its result goes.
+ *
+ * Every row is a TRACED fact about code that already exists (evidence cites
+ * the entry point); no row describes a capability or adds vocabulary — names
+ * and purposes come from the source registries via `./readPath.ts`.
+ *
+ * `handoff`:
+ *   - "claire_topic" | "board_invite" | "research_launch" | "project_next_move"
+ *       One Brain connects the turn itself (OB-5 connections).
+ *   - "owner_seam"
+ *       An existing page seam still routes this owner. One Brain records the
+ *       selection and DEFERS (retirement table in the OB-5 report).
+ */
+
+export type OneBrainCapabilityId =
+  | "claire"
+  | "board"
+  | "research"
+  | "projects"
+  | "events"
+  | "strategy_chamber"
+  | "create"
+  | "plan_my_day"
+  | "reminders"
+  | "rhythms"
+  | "visual_thinking"
+  | "client_avatars"
+  | "lmc";
+
+export type CapabilityOwnerMode =
+  /** Writes member state, only after the member confirms (owner's contract). */
+  | "acts_with_confirmation"
+  /** Writes member state directly from a clear request (owner's contract). */
+  | "acts"
+  /** Thinks / recommends / explains; writes nothing on its own. */
+  | "advises"
+  /** Opens a place; the member does the work there. */
+  | "navigates";
+
+export type CapabilityHandoffKind =
+  | "claire_topic"
+  | "board_invite"
+  | "research_launch"
+  | "project_next_move"
+  | "owner_seam";
+
+export type CapabilityReturnPath = "main_chat" | "originating_room" | "room_only" | "none";
+
+export type CapabilityConnectionStatus = "connected" | "partially_connected" | "disconnected";
+
+export type CapabilityConnection = {
+  ownerKey: string;
+  mode: CapabilityOwnerMode;
+  handoff: CapabilityHandoffKind;
+  returnPath: CapabilityReturnPath;
+  status: CapabilityConnectionStatus;
+  /** How the member gets there (member-facing, short). */
+  reach: string;
+  /** What the owner receives at handoff. */
+  contextCarried: readonly string[];
+  /** The honest limit Spark states instead of claiming. */
+  cannot?: string;
+  /** Repository evidence (entry point / return reader). */
+  evidence: string;
+};
+
+export const CAPABILITY_CONNECTIONS: Record<OneBrainCapabilityId, CapabilityConnection> = {
