@@ -386,3 +387,42 @@ export function resolveCorrectionBinding(input: {
   if (receipt) return { kind: "check", reason: "stale", receipt };
   return { kind: "none" };
 }
+
+// ── OB-5 — capability CONNECT eligibility ─────────────────────────────────────
+
+/**
+ * Whether THIS turn may select a capability owner, read from Boundary's meaning
+ * contract (the gate is the one reader of the meaning fields). Capability
+ * selection (`lib/oneBrainCapability/selectCapability.ts`) consumes this — it
+ * never reads `relation` / `stance` / `meaningConfidence` itself.
+ *
+ * - `binding` / `correction`: OB-3 / OB-4 own the reply.
+ * - `relation`: the member is accepting / declining / correcting / clarifying /
+ *   unsure about Spark's last contribution — not asking for a capability.
+ * - `held_on_thread`: OB-2 holds the current thread.
+ * - `discussion`: Boundary's stance says the member is talking ABOUT it.
+ * - `eligible` with `lowMeaning`: a capability may be OFFERED, never connected.
+ */
+export type CapabilityTurnEligibility =
+  | { kind: "eligible"; lowMeaning: boolean }
+  | { kind: "not_eligible"; reason: "binding" | "correction" | "relation" | "held_on_thread" | "discussion" };
+
+const NON_REQUEST_RELATIONS: ReadonlySet<string> = new Set(["accept", "decline", "correct", "clarify", "unsure"]);
+
+export function capabilityTurnEligibility(input: {
+  decision: ConversationBoundaryDecision;
+  pendingBinding: PendingBinding | null;
+  correctionBinding: CorrectionBinding | null;
+}): CapabilityTurnEligibility {
+  const { decision } = input;
+  if (input.pendingBinding && input.pendingBinding.kind !== "none") return { kind: "not_eligible", reason: "binding" };
+  if (input.correctionBinding && input.correctionBinding.kind !== "none") {
+    return { kind: "not_eligible", reason: "correction" };
+  }
+  if (decision.relation && NON_REQUEST_RELATIONS.has(decision.relation)) {
+    return { kind: "not_eligible", reason: "relation" };
+  }
+  if (isMeaningHold(decision)) return { kind: "not_eligible", reason: "held_on_thread" };
+  if (decision.stance === "talk_about") return { kind: "not_eligible", reason: "discussion" };
+  return { kind: "eligible", lowMeaning: decision.meaningConfidence === "low" };
+}
