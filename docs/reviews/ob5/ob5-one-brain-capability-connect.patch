+    expect(r.selection?.kind).toBe("defer");
+  });
+});
+
+// ── 3. Safety families ───────────────────────────────────────────────────────
+
+describe("Safety: ambiguity, discussion, unsupported, questions, stale, clarification, interruption", () => {
+  it("two connected owners fit → a short choice; choosing one plans exactly that owner", () => {
+    seedProject("Spring Launch");
+    const r = turn("Update my business profile for my launch project.", 1);
+    expect(r.selection?.kind).toBe("ask");
+    expect(r.plan).toMatchObject({ kind: "offer", bindKey: `${CAPABILITY_BIND_PREFIX}choice` });
+    const choice = (r.plan as { payload: CapabilityHandoffPayload }).payload;
+    expect(choice.kind).toBe("choice");
+    const plan = planChoiceAcceptance(choice as Extract<CapabilityHandoffPayload, { kind: "choice" }>, "claire");
+    expect(plan?.kind).toBe("execute");
+    expect(planChoiceAcceptance(choice as never, "board")).toBeNull(); // not offered → never
+  });
+
+  it("discussion-only (Boundary stance talk_about) never selects a capability", () => {
+    const decision = { decision: "continue_current_topic", confidence: "high", evidence: [], relation: "none", stance: "talk_about", meaningConfidence: "high" } as ConversationBoundaryDecision;
+    expect(capabilityTurnEligibility({ decision, pendingBinding: null, correctionBinding: null })).toEqual({
+      kind: "not_eligible",
+      reason: "discussion",
+    });
+    expect(resolveCapabilitySelection({ decision, userText: "Help me update my business profile.", pendingBinding: null, correctionBinding: null })).toMatchObject({ kind: "none", reason: "discussion" });
+  });
+
+  it("LOW meaning never connects — it offers", () => {
+    const decision = { decision: "switch_topic", confidence: "high", evidence: [], relation: "none", stance: "none", meaningConfidence: "low" } as ConversationBoundaryDecision;
+    const s = resolveCapabilitySelection({ decision, userText: "Help me update my business profile.", pendingBinding: null, correctionBinding: null });
+    expect(s?.kind).toBe("confirm");
+    const plan = planCapabilityTurn({ selection: s!, userText: "Help me update my business profile." });
+    expect(plan?.kind).toBe("offer");
+  });
+
+  it("unsupported request → no capability claimed; the prompt says Spark can't send anything itself", () => {
+    const before = memberSnapshot();
+    expect(kindOf(turn("Can you send an email to my client for me?", 1).selection)).toBe("none:no_capability");
+    expect(buildCapabilityPromptBlock()).toMatch(/cannot open, save, send/);
+    expect(memberSnapshot()).toBe(before);
+  });
+
+  it("capability question → no route; the model answers from the projection", () => {
+    expect(kindOf(turn("What can you do?", 1).selection)).toBe("none:no_capability");
+    expect(buildCapabilityPromptBlock()).toMatch(/Reach:/);
+  });
+
+  it("clarification during a handoff keeps the offer (OB-3 preserve); 'yes' next turn still binds", () => {
+    const r = turn("Research this before I decide.", 1);
+    const offer = (r.plan as { reply: string }).reply;
+    const q = turn("What would that do?", 2, offer);
+    expect(q.selection?.kind).toBe("none");
+    expect(readPendingReply()?.bindKey).toBe(`${CAPABILITY_BIND_PREFIX}research`);
+    const yes = turn("yes", 3, "It looks for sources and brings them back.");
+    expect(yes.accepted?.kind).toBe("research_launch");
+  });
+
+  it("stale handoff: 'yes' two turns later never executes", () => {
+    turn("Research this before I decide.", 1);
+    const late = turn("yes", 3, "Anyway, how is your week going?");
+    expect(late.accepted).toBeNull();
+  });
+
+  it("decline releases the capability offer; nothing runs", () => {
+    const r = turn("Research this before I decide.", 1);
+    const no = turn("No thanks.", 2, (r.plan as { reply: string }).reply);
+    expect(no.accepted).toBeNull();
+    expect(readPendingReply()).toBeNull();
+  });
+
+  it("active work is not destroyed: a direct Claire connection does not replace an armed Rhythm offer", () => {
+    armPendingReply({ bindKey: "remember_offer", offeredAtTurn: 1 });
+    const r = turn("Help me update my business profile.", 2, "Want me to set up that Rhythm?");
+    expect(r.plan?.kind).toBe("execute");
+    expect(readPendingReply()?.bindKey).toBe("remember_offer");
+  });
+
+  it("kill switches: capability connect off, or One Brain meaning hold off → legacy seams only", () => {
+    process.env[CONNECT] = "0";
+    expect(turn("Help me update my business profile.", 1).selection).toBeNull();
+    delete process.env[CONNECT];
+    process.env[HOLD] = "0";
+    expect(turn("Help me update my business profile.", 1).selection).toBeNull();
+  });
+
+  it("0 false actions across every family turn above (selection + offer write no member store)", () => {
+    seedProject("Spring Launch", "Email the ten warm leads");
+    const before = memberSnapshot();
+    const texts = [
+      "Help me update my business profile.",
+      "What does the board think about this?",
+      "I want several perspectives on this.",
+      "Research this before I decide.",
+      "Help me figure out what to do next on my launch project.",
+      "Help me with my event.",
+      "I need help with my pricing.",
+      "Help me create a client onboarding guide.",
+      "Help me plan today.",
+      "Remind me tomorrow to call Susan.",
+      "I want to do this every month.",
+      "Can you map this out visually?",
+      "Can you send an email to my client for me?",
+      "What can you do?",
+    ];
+    texts.forEach((t, i) => turn(t, i + 1));
+    expect(memberSnapshot()).toBe(before);
+  });
+});
