+/**
+ * OB-6 — KNOW: One Brain's read of what Spark already knows.
+ *
+ * UNDERSTAND → KNOW WHAT TYPE OF TRUTH IS NEEDED → FIND THE EXISTING SOURCE →
+ * RETRIEVE → LABEL → ANSWER → CONTINUE.
+ *
+ * No store, no registry, no retrieval authority of its own:
+ *   - the READ is the shared Situation façade (`retrieveRelevantSituation`),
+ *     scoped by source family and a time lens (current / history / reason);
+ *   - the Strategy Chamber's own store is read here through its own read
+ *     functions, because the façade's boundary forbids it importing the Chamber;
+ *   - "who knows what" is read from the Board's and the Chamber's own topic
+ *     selectors; "what can you do" from the OB-5 capability projection and the
+ *     executable-request availability map.
+ *
+ * Truth types are DERIVED from each source's own status / provenance / time
+ * fields (never stored). Precedence is deterministic, never left to the model.
+ */
+
+import { retrieveRelevantSituation } from "@/lib/relevantSituation";
+import { collectBusinessUnderstandingSnapshot } from "@/lib/profile/businessUnderstanding/readProvider";
+import { projectLivingModelCanvas } from "@/lib/profile/businessModelProjection/projectLivingModelCanvas";
+import { LMC_AREA_LABEL } from "@/lib/profile/businessModelProjection/areas";
+import { readSnapshotToProjection } from "@/lib/businessProfileFounder/snapshotBridge";
+import type { RelevantSituationItem, SituationKnowLens, SituationSourceFamily } from "@/lib/relevantSituation/types";
+import { mentionsPricing } from "@/lib/relevantSituation/collectBusinessUnderstandingItems";
+import { listCapabilityAvailability } from "@/lib/memberIntent/executableRequest";
+import {
+  readKnowQuestion,
+  subjectOf,
+  unavailableNamed,
+  WHERE_LIVES_RE,
+  type KnowQuestion,
+  type KnowSubject,
+} from "./knowQuestion";
+import {
+  getActiveStrategyWorkItem,
+  listStrategyWorkItems,
+} from "@/lib/strategyChamber/strategyWorkItemStore";
+import { buildStrategyDecisionRecord, decisionRecordIsReady } from "@/lib/strategyChamber/decisionRecord";
+import { getStrategyConclusionForContext } from "@/lib/strategyChamber/strategyChamberContinuity";
+import { listStrategicDecisionMemories } from "@/lib/strategyChamber/memory/strategicMemoryStore";
+import type { StrategyWorkItem } from "@/lib/strategyChamber/types";
+import { matchStrategyTypesFromText } from "@/lib/strategyChamber/intelligence/registry";
+import { inferMaterialDimensions } from "@/lib/board/reconstructed/selection/assessBoardSituation";
+import { allDomainScores } from "@/lib/board/reconstructed/selection/directorRelevanceModel";
+import { DIRECTOR_IDENTITIES } from "@/lib/board/reconstructed/identities";
+import { resolveExpertiseCategory } from "@/lib/chamber/expertiseCategory";
+import { CHAMBER_MEMBERS } from "@/lib/chamber/chamberMemberRegistry";
+import { CAPABILITY_CONNECTIONS, isOneBrainConnected } from "./connections";
+import { listCapabilityProjections } from "./projection";
+
+export { readKnowQuestion, type KnowQuestion, type KnowSubject } from "./knowQuestion";
+
+/** Re-exported for the page, which may not import the Situation façade directly. */
+export type KnowSituationLens = SituationKnowLens;
+export type KnowSourceFamily = SituationSourceFamily;
+
+// ── Truth types (derived, never stored) ──────────────────────────────────────
+
+export type KnowTruthType =
+  | "CURRENT_AUTHORITATIVE"
+  | "HISTORICAL_SUPERSEDED"
+  | "TENTATIVE"
+  | "PLANNED"
+  | "RESEARCH"
+  | "MEMORY_CONTEXT"
+  | "SPECIALIST_OPINION"
+  | "SAMPLE_DEMO"
+  | "UNKNOWN";
+
+/**
+ * Derive the truth type from the source's own fields. SAMPLE_DEMO cannot be
+ * derived today: facts carry no per-fact sample flag (the two seeds are
+ * test / founder-proof only). Reported as a gap, not guessed.
+ */
+export function truthTypeOf(item: RelevantSituationItem): KnowTruthType {
+  if (item.temporal?.state === "superseded" || item.temporal?.state === "retired") return "HISTORICAL_SUPERSEDED";
+  if (item.origin === "board_deliberation") return "SPECIALIST_OPINION";
+  if (item.informationType === "CURRENT_SOURCED_RESEARCH" || item.epistemicStatus === "research_finding") return "RESEARCH";
+  if (item.sourceAuthority.startsWith("companion-research-library")) return "RESEARCH";
+  if (item.representAs === "unknown" || item.informationType === "UNKNOWN") return "UNKNOWN";
+  if (
+    item.epistemicStatus === "hypothesis" ||
+    item.epistemicStatus === "inference" ||
+    item.epistemicStatus === "stale_or_uncertain" ||
+    item.representAs === "assumption" ||
+    item.informationType === "ASSUMPTION"
+  ) {
+    return "TENTATIVE";
+  }
+  if (item.role === "nextMeaningfulMove" || item.origin === "events_intelligence") return "PLANNED";
+  if (item.epistemicStatus === "member_established_fact" || item.epistemicStatus === "decision") return "CURRENT_AUTHORITATIVE";
+  return "MEMORY_CONTEXT";
+}
+
+/** Deterministic precedence for "what is true now": lower = stronger. */
+const PRECEDENCE: Record<KnowTruthType, number> = {
+  CURRENT_AUTHORITATIVE: 0,
+  PLANNED: 1,
+  MEMORY_CONTEXT: 2,
+  RESEARCH: 3,
+  SPECIALIST_OPINION: 4,
+  TENTATIVE: 5,
+  UNKNOWN: 6,
+  HISTORICAL_SUPERSEDED: 7,
+  SAMPLE_DEMO: 8,
+};
+
+export function byTruthPrecedence(a: RelevantSituationItem, b: RelevantSituationItem): number {
+  return PRECEDENCE[truthTypeOf(a)] - PRECEDENCE[truthTypeOf(b)];
+}
+
+// UNDERSTAND lives in ./knowQuestion (light: capability selection imports it).
+// ── RETRIEVE → LABEL → ANSWER ────────────────────────────────────────────────
+
+export type KnowPlan =
+  | {
+      kind: "answer";
+      reply: string;
+      question: KnowQuestion;
+      /** The sources the answer came from (for provenance; never shown as jargon). */
+      sourceRefs: string[];
+      truthTypes: KnowTruthType[];
+    }
+  | {
+      /** Nothing decisive in a structured store: the model answers, with the scoped labelled context. */
+      kind: "context";
+      question: KnowQuestion;
+      sources: readonly SituationSourceFamily[];
+    };
+
+const FAMILIES: Record<Exclude<KnowSubject, "specialists" | "capabilities" | "strategy">, readonly SituationSourceFamily[]> = {
+  board: ["board"],
+  research: ["research"],
+  events: ["events"],
+  visual: ["visual"],
+  business_model: ["business"],
+  avatar: ["business"],
+  pricing: ["business", "decisions"],
+  work: ["work"],
+  decisions: ["decisions", "business", "board"],
+  business: ["business"],
+};
+
+/** Member-language status (no architecture words). */
+function memberLabel(item: RelevantSituationItem): string {
+  switch (truthTypeOf(item)) {
+    case "CURRENT_AUTHORITATIVE":
+      return item.epistemicStatus === "decision" ? "your decision" : "confirmed";
+    case "RESEARCH":
+      return item.informationType === "CURRENT_SOURCED_RESEARCH"
+        ? "from your research, sourced"
+        : "from your research — an interpretation, not a sourced finding";
+    case "SPECIALIST_OPINION":
+      return "the Board's view — advice, not a decision";
+    case "TENTATIVE":
+      return "not settled yet";
+    case "HISTORICAL_SUPERSEDED":
+      return item.temporal?.state === "retired" ? "retired, no longer current" : "earlier — no longer current";
+    default:
+      return "";
+  }
+}
+
+function line(item: RelevantSituationItem): string {
+  const label = memberLabel(item);
+  return label ? `${item.summary} (${label})` : item.summary;
+}
+
+function read(q: KnowQuestion, text: string): RelevantSituationItem[] {
+  if (q.subject === "specialists" || q.subject === "capabilities" || q.subject === "strategy") return [];
+  if (q.subject === "business_model") return livingModelItems();
+  const slice = retrieveRelevantSituation({
+    intent: { memberStatement: text, aim: "think" },
+    consumerRole: "conversation",
+    lens: q.lens,
+    sources: FAMILIES[q.subject],
+  });
+  let items = slice.items;
+  if (q.subject === "pricing") items = items.filter((i) => mentionsPricing(i.summary));
+  if (q.subject === "avatar") items = items.filter((i) => i.id.startsWith("bu:person:"));
+  return items;
+}
+
+const NOTHING_SAVED: Partial<Record<KnowSubject, string>> = {
+  board: "I don't see a Board discussion with a result yet — nothing's come back from the Board.",
+  research: "There's no saved research yet, so I don't have findings to share.",
+  events: "You don't have an event in progress right now.",
+  strategy: "There's no strategy work saved yet.",
+  visual: "You haven't saved a visual map yet.",
+  business_model: "Your Living Model doesn't have anything confirmed in it yet.",
+  avatar: "I don't have an ideal client saved yet.",
+  pricing: "I don't have a confirmed price saved.",
+};
+
+/** Plan the KNOW turn. Null = not a KNOW question. */
+export function planKnowTurn(text: string): KnowPlan | null {
+  const q = readKnowQuestion(text);
+  if (!q) return null;
+  if (q.subject === "specialists") return answer(q, whoKnows(text), [], []);
+  if (q.subject === "capabilities") return answer(q, whatSparkCanDo(text), [], []);
+  if (q.subject === "strategy") return strategyAnswer(q);
+
+  const items = read(q, text);
+  const current = items.filter((i) => truthTypeOf(i) !== "HISTORICAL_SUPERSEDED").sort(byTruthPrecedence);
+  const earlier = items.filter((i) => truthTypeOf(i) === "HISTORICAL_SUPERSEDED");
+
+  if (q.lens === "reason") return reasonAnswer(q, current, earlier);
+  if (q.lens === "history") return historyAnswer(q, current, earlier);
+
+  if (!current.length) {
+    const none = NOTHING_SAVED[q.subject];
+    return none ? answer(q, none, [], ["UNKNOWN"]) : { kind: "context", question: q, sources: FAMILIES[q.subject as keyof typeof FAMILIES] };
+  }
+  const top = current.slice(0, q.subject === "business" || q.subject === "business_model" || q.subject === "decisions" ? 4 : 3);
+  return answer(q, `${LEAD[q.subject] ?? "Here's what's saved:"}\n${top.map((i) => `• ${line(i)}`).join("\n")}`, top.map((i) => i.sourceRef), top.map(truthTypeOf));
+}
+
+const LEAD: Partial<Record<KnowSubject, string>> = {
+  board: "Here's what came out of your Board:",
+  research: "Here's what your research found:",
+  events: "Here's the event you're working on:",
+  visual: "Here's your latest visual map:",
+  business_model: "Here's how your business model looks right now:",
+  avatar: "Here's what's saved about your ideal client:",
+  pricing: "Here's the price on record right now:",
+  work: "Here's what you were working on:",
+  decisions: "Here's what's been decided:",
+  business: "Here's what I know about your business right now:",
+};
+
+function historyAnswer(q: KnowQuestion, current: RelevantSituationItem[], earlier: RelevantSituationItem[]): KnowPlan {
+  if (!earlier.length) {
+    const now = current[0];
+    const reply = now
+      ? `I don't have an earlier version on record — only the current one: ${line(now)}.`
+      : "I don't have an earlier version of that on record.";
+    return answer(q, reply, now ? [now.sourceRef] : [], now ? [truthTypeOf(now)] : ["UNKNOWN"]);
+  }
+  const lines = earlier.slice(0, 3).map((i) => `• Earlier: ${i.summary} (no longer current)`);
+  // "Now" is what REPLACED the earlier version (its own supersession chain),
+  // not merely the strongest current line.
+  const successor = earlier[0].temporal?.supersededById;
+  const now =
+    (successor ? current.find((i) => i.sourceRef === `fact:${successor}` || i.sourceRef === `ledger:${successor}`) : undefined) ??
+    current.find((i) => truthTypeOf(i) === "CURRENT_AUTHORITATIVE");
+  if (now) lines.push(`• Now: ${now.summary}`);
+  const used = [...earlier.slice(0, 3), ...(now ? [now] : [])];
+  return answer(q, `Here's the earlier version on record:\n${lines.join("\n")}`, used.map((i) => i.sourceRef), used.map(truthTypeOf));
+}
+
+function reasonAnswer(q: KnowQuestion, current: RelevantSituationItem[], earlier: RelevantSituationItem[]): KnowPlan {
+  const changed = current.find((i) => i.temporal?.changeReason?.trim()) ?? earlier.find((i) => i.temporal?.changeReason?.trim());
+  if (changed) {
+    const was = earlier.find((e) => e.temporal?.supersededById && `fact:${e.temporal.supersededById}` === changed.sourceRef);
+    const from = was ? ` from ${was.summary}` : "";
+    return answer(
+      q,
+      `When it changed${from} to ${changed.summary}, you said: “${changed.temporal!.changeReason!.trim()}”`,
+      [changed.sourceRef, ...(was ? [was.sourceRef] : [])],
+      [truthTypeOf(changed), ...(was ? [truthTypeOf(was)] : [])],
+    );
+  }
+  if (earlier.length) {
+    const now = current.find((i) => truthTypeOf(i) === "CURRENT_AUTHORITATIVE");
+    return answer(
+      q,
+      `I can see it changed (earlier: ${earlier[0].summary}${now ? `; now: ${now.summary}` : ""}), but there's no reason on record — I won't guess. Do you remember what prompted it?`,
+      [earlier[0].sourceRef, ...(now ? [now.sourceRef] : [])],
+      ["HISTORICAL_SUPERSEDED", ...(now ? [truthTypeOf(now)] : [])],
+    );
+  }
+  return answer(q, "I don't have a record of that changing, so I don't know why — I won't guess.", [], ["UNKNOWN"]);
+}
+
+/**
+ * Living Model Canvas — the canvas is a pure projection of Business
+ * Understanding (no store of its own), built from the same BU snapshot the
+ * shared read path uses. Projected here (One Brain) rather than in the shared
+ * façade so every façade consumer does not pay for the projection engine.
+ * One line per populated area; unconfirmed lines say so.
+ */
+function livingModelItems(): RelevantSituationItem[] {
+  const snapshot = collectBusinessUnderstandingSnapshot();
+  let projection: ReturnType<typeof projectLivingModelCanvas>;
+  try {
+    projection = projectLivingModelCanvas(readSnapshotToProjection(snapshot), { kind: "WHOLE_BUSINESS" });
+  } catch {
+    return [];
+  }
+  const out: RelevantSituationItem[] = [];
+  for (const section of projection.sections) {
+    const confirmed = section.items.filter((i) => i.epistemicStatus === "CONFIRMED").map((i) => i.text.trim()).filter(Boolean);
+    const tentative = section.items.filter((i) => i.epistemicStatus !== "CONFIRMED").map((i) => i.text.trim()).filter(Boolean);
+    if (!confirmed.length && !tentative.length) continue;
+    const label = LMC_AREA_LABEL[section.areaId] ?? section.areaId;
+    const summary = confirmed.length
+      ? `${label}: ${confirmed.slice(0, 3).join("; ")}${tentative.length ? ` (also still open: ${tentative.slice(0, 2).join("; ")})` : ""}`
+      : `${label}: ${tentative.slice(0, 3).join("; ")}`;
+    out.push({
+      id: `lmc:${section.areaId}`,
+      informationType: "MEMBER_BUSINESS_CONTEXT",
+      sourceAuthority: "business_understanding:living_model",
+      sourceRef: `lmc:${section.areaId}`,
+      representAs: confirmed.length ? "settled" : "assumption",
+      summary,
+      relevanceReason: "business_understanding",
+      epistemicStatus: confirmed.length ? "member_established_fact" : "hypothesis",
+      origin: "living_model_canvas",
+    });
+  }
+  return out;
+}
+
+// ── Strategy Chamber (read through its own store; the façade may not import it) ──
+
+function latestStrategyWork(): StrategyWorkItem | null {
+  return getActiveStrategyWorkItem() ?? listStrategyWorkItems().filter((i) => i.status !== "archived")[0] ?? null;
+}
+
+function strategyAnswer(q: KnowQuestion): KnowPlan {
+  const item = latestStrategyWork();
+  if (item) {
+    const record = buildStrategyDecisionRecord(item);
+    if (decisionRecordIsReady(item) && record.directionYouChose) {
+      const settled = item.decisionRecordConfirmed || item.status === "completed" || item.status === "handed_off";
+      const why = record.whyThisDirectionFits ? ` — because ${lowerFirst(record.whyThisDirectionFits)}` : "";
+      const head = settled ? "You settled on" : "You chose a direction (not confirmed yet)";
+      return answer(
+        q,
+        `${head}: ${record.directionYouChose}${why}. That was for: “${record.whatYouWereDeciding}”.`,
+        [`strategy:${item.id}`],
+        [settled ? "CURRENT_AUTHORITATIVE" : "TENTATIVE"],
+      );
+    }
+    return answer(
+      q,
+      `You're still working through “${record.whatYouWereDeciding}” in the Strategy Chamber — nothing's settled yet.`,
+      [`strategy:${item.id}`],
+      ["TENTATIVE"],
+    );
+  }
+  const memory = listStrategicDecisionMemories()[0];
+  const chosen = memory?.chosenDirection;
+  if (memory && chosen?.direction?.trim()) {
+    return answer(
+      q,
+      `Last time you ${chosen.userConfirmed ? "decided" : "leaned toward (not confirmed)"}: ${chosen.direction.trim()}${chosen.rationale ? ` — because ${chosen.rationale}` : ""} (on “${memory.strategicQuestion}”).`,
+      [`strategy-memory:${memory.id}`],
+      [chosen.userConfirmed ? "CURRENT_AUTHORITATIVE" : "TENTATIVE"],
+    );
+  }
+  const conclusion = getStrategyConclusionForContext();
+  if (conclusion?.trim()) {
+    return answer(q, `The Strategy Chamber's last conclusion: ${conclusion.trim()} (its advice — not something you've confirmed).`, ["strategy:conclusion"], ["SPECIALIST_OPINION"]);
+  }
+  return answer(q, NOTHING_SAVED.strategy!, [], ["UNKNOWN"]);
+}
+
+// ── Who knows what (the Board's and the Chamber's own topic selectors) ──────
+
+function topicOf(text: string): string {
+  const m = text.match(/\b(?:about|with|on|for)\s+(.+?)[?.!]*$/i);
+  return (m?.[1] ?? text).trim();
+}
+
+function firstSentenceWith(bio: string, re: RegExp): string {
+  const sentences = bio.split(/(?<=[.!?])\s+/);
+  return sentences.find((s) => re.test(s)) ?? sentences[sentences.length - 1] ?? "";
+}
+
+export function whoKnows(text: string): string {
+  const topic = topicOf(text);
+  const lines: string[] = [];
+  const scores = allDomainScores(inferMaterialDimensions({ memberText: topic, suppressPreDeliberationQuestion: true }))
+    .filter((s) => s.score > 0)
+    .sort((a, b) => b.score - a.score);
+  if (scores[0]) {
+    const identity = DIRECTOR_IDENTITIES[scores[0].director];
+    const bring = firstSentenceWith(identity.memberBio, /\bBring (?:her|him|them)\b/);
+    lines.push(`On your Board: ${identity.displayName} (${identity.memberDescriptor}). ${bring}`.trim());
+  }
+  const chamber = resolveExpertiseCategory(topic);
+  const member = chamber ? CHAMBER_MEMBERS.find((m) => m.id === chamber.memberId) : null;
+  if (member) lines.push(`In the Chamber of Momentum: ${member.displayName} (${member.specialty}).`);
+  const strategy = matchStrategyTypesFromText(topic)[0];
+  if (strategy) lines.push(`The Strategy Chamber can work through it with you as ${strategy.type.name}.`);
+  if (!lines.length) return `I'm not sure who fits “${topic}” best yet — tell me a little more about what you're trying to figure out?`;
+  return lines.join("\n");
+}
+
+// ── What Spark can do (the OB-5 capability projection + availability map) ──
+
+export function whatSparkCanDo(text: string): string {
+  const t = text.trim();
+  const unavailable = unavailableNamed(t);
+  if (unavailable.length) {
+    return `Not yet — I can't add or change anything on your ${unavailable[0]} from here. I can set a reminder or a Rhythm for it instead.`;
+  }
+  if (WHERE_LIVES_RE.test(t)) {
+    const subject = subjectOf(t);
+    const id = subject === "business_model" ? "lmc" : subject === "avatar" ? "client_avatars" : subject === "events" ? "events" : subject === "visual" ? "visual_thinking" : subject === "research" ? "research" : subject === "board" ? "board" : subject === "strategy" ? "strategy_chamber" : "claire";
+    const projection = listCapabilityProjections().find((p) => p.id === id);
+    if (projection) return `${projection.name}: ${projection.connection.reach}.`;
+  }
+  if (/\bcan'?t\b|\bnot\b/i.test(t)) {
+    const limits = listCapabilityProjections()
+      .filter((p) => p.connection.cannot)
+      .map((p) => `• ${p.name}: ${p.connection.cannot}`);
+    const notYet = listCapabilityAvailability()
+      .filter(([, availability]) => availability === "not_available_from_chat")
+      .map(([cap]) => `• Add or change things on your ${cap}.`);
+    return ["Here's what I can't do yet:", ...notYet, ...limits].join("\n");
+  }
+  const connected = listCapabilityProjections().filter((p) => isOneBrainConnected(p.id) || CAPABILITY_CONNECTIONS[p.id].handoff === "owner_seam");
+  const names = connected.map((p) => p.name);
+  const board = Object.keys(DIRECTOR_IDENTITIES).length;
+  return `Here's what I can help with — just tell me what you need and I'll bring in the right place: ${names.join(", ")}. You also have a Board of ${board} directors and ${CHAMBER_MEMBERS.length} Chamber specialists to think with.`;
+}
+
+/** "It lowers…" → "it lowers…" when joined mid-sentence (never an acronym). */
+function lowerFirst(text: string): string {
+  return /^[A-Z][a-z]/.test(text) ? text[0].toLowerCase() + text.slice(1) : text;
+}
+
+function answer(q: KnowQuestion, reply: string, sourceRefs: string[], truthTypes: KnowTruthType[]): KnowPlan {
+  return { kind: "answer", reply, question: q, sourceRefs, truthTypes };
+}
