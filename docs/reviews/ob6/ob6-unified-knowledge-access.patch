+
+const reply = (plan: KnowPlan | null) => (plan?.kind === "answer" ? plan.reply : "");
+
+/** The page's One Brain step for this turn: selection (KNOW questions yield). */
+function selectionFor(text: string, lastAssistantText = ""): CapabilitySelection | null {
+  const snap = captureBoundaryPreTurnSnapshot();
+  const decision = resolveTurnBoundaryDecision({ userText: text, turn: 0, lastAssistantText, snapshot: snap });
+  const pb = resolvePendingBinding({ decision, pending: snap.pendingOwner, currentTurn: 1 });
+  const cb = resolveCorrectionBinding({ decision, pending: snap.pendingOwner, receipt: snap.receipt, currentTurn: 1 });
+  return resolveCapabilitySelection({ decision, userText: text, pendingBinding: pb, correctionBinding: cb });
+}
+
+// ── 1. Current / historical / reason (the pricing test) ──────────────────────
+
+describe("Current, historical and reason truth — from the Business Understanding temporal chain", () => {
+  it("'What are we charging now?' → the current price only, never the superseded one", () => {
+    seedPriceHistory();
+    const plan = planKnowTurn("What are we charging now?");
+    expect(reply(plan)).toMatch(/\$49/);
+    expect(reply(plan)).not.toMatch(/\$99/);
