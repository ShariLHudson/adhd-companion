+/**
+ * OB-6 — Conversation → Visual Thinking Studio bridge.
+ *
+ * The studio's capture-first front door reads Loose Thinking SOURCES ("Already
+ * brought in"). Research reaches it through `bridgeResearchVisualHandoff`; the
+ * conversation reaches it through the SAME intake: the member's own words are
+ * captured with `captureSource` (verbatim, claimState "member-stated") into an
+ * "unsorted" Loose Thinking map, then opened on hub entry. Nothing is split,
+ * grouped or interpreted here — "Help me see this" stays the only place loose
+ * items are made.
+ *
+ * The pointer is one-shot (sessionStorage), consumed once on hub entry, the
+ * same lifecycle the Research handoff uses.
+ */
+
+import { createVisualFocusMap, saveVisualFocusMap, type VisualFocusMap } from "@/lib/visualFocus";
+import { getVisualFocusMapById } from "@/lib/visualFocus/store";
+import { captureSource } from "./sourceEditing";
+import { finalizeLooseThinkingCaptureMap } from "./ensureLooseThinkingVisualLayout";
+
+const CONVERSATION_VISUAL_PENDING_KEY = "companion-visual-focus-conversation-pending-v1";
+
+/** Capture the member's conversation material as sources and queue it for the studio. */
+export function bringConversationIntoLooseThinking(input: {
+  texts: readonly string[];
+  title?: string | null;
+}): VisualFocusMap | null {
+  const texts = input.texts.map((t) => t.trim()).filter((t) => t.length >= 3);
+  if (!texts.length) return null;
+  let map = createVisualFocusMap("unsorted");
+  for (const text of texts) map = captureSource(map, text, { claimState: "member-stated" });
+  const saved = saveVisualFocusMap(finalizeLooseThinkingCaptureMap(map, { title: input.title ?? null }));
+  if (typeof sessionStorage !== "undefined") {
+    try {
+      sessionStorage.setItem(CONVERSATION_VISUAL_PENDING_KEY, saved.id);
+    } catch {
+      /* ignore — the map is still saved and listed under Previous work */
+    }
+  }
+  return saved;
+}
+
+/** One-shot: the conversation map queued for the studio's front door, if any. */
+export function consumeConversationVisualHandoffIntoLooseThinking(): VisualFocusMap | null {
+  if (typeof sessionStorage === "undefined") return null;
+  try {
+    const id = sessionStorage.getItem(CONVERSATION_VISUAL_PENDING_KEY);
+    if (!id) return null;
+    sessionStorage.removeItem(CONVERSATION_VISUAL_PENDING_KEY);
+    return getVisualFocusMapById(id);
+  } catch {
+    return null;
+  }
+}
