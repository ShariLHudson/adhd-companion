+/**
+ * OB-6 KNOW — UNDERSTAND: is this a question about what Spark already knows,
+ * which version of the truth does it ask for, and about which existing source?
+ *
+ * Deliberately light (lexicon + owner recognizers only): capability selection
+ * imports it on every turn. Retrieval and answers live in ./know.
+ */
+
+import type { SituationKnowLens } from "@/lib/relevantSituation/types";
+import {
+  KNOW_HISTORY_RE,
+  KNOW_REASON_RE,
+  KNOW_RECALL_RE,
+  WH_OPEN_RE,
+} from "@/lib/conversationBoundaryLexicon";
+import { detectClaireTopic } from "@/lib/businessProfileFounder/claireTopicResponses";
+import { listCapabilityAvailability } from "@/lib/memberIntent/executableRequest";
+import { namesBusinessModel, questionAboutCapability } from "./readPath";
+
+// ── UNDERSTAND: is this a question about what Spark already knows? ─────────
+
+export type KnowSubject =
+  | "board"
+  | "research"
+  | "events"
+  | "strategy"
+  | "visual"
+  | "business_model"
+  | "avatar"
+  | "pricing"
+  | "work"
+  | "decisions"
+  | "business"
+  | "specialists"
+  | "capabilities";
+
+export type KnowQuestion = { subject: KnowSubject; lens: SituationKnowLens };
+
+/**
+ * Each existing source, named by the owner's own record noun (the thing the
+ * member calls it). Order = specificity: the most specific owner wins.
+ */
+const SUBJECT_NOUNS: readonly [Exclude<KnowSubject, "specialists" | "capabilities">, RegExp][] = [
+  ["board", /\b(?:board|directors?)\b/i],
+  ["research", /\bresearch/i],
+  ["events", /\bevents?\b/i],
+  ["strategy", /\bstrateg/i],
+  ["visual", /\b(?:visual(?:ly)?|mapp?(?:ed|ing)?|mind\s*maps?|diagrams?)\b/i],
+  ["avatar", /\b(?:avatar|ideal client|client avatar)\b/i],
+  ["pricing", /\b(?:charg\w*|pric\w*|cost\w*)\b/i],
+  ["work", /\b(?:working on|left off|were we (?:doing|on))\b/i],
+  ["decisions", /\b(?:decid\w*|settled|agreed|landed on)\b/i],
+  ["business", /\b(?:(?:my|our) business|about me)\b/i],
+];
+
+function isQuestionForm(t: string): boolean {
+  return WH_OPEN_RE.test(t) || /\?\s*$/.test(t) || /\bdidn'?t\s+we\b|\b(?:remind|tell) me what\b/i.test(t);
+}
+
+function lensOf(t: string): SituationKnowLens {
+  if (KNOW_REASON_RE.test(t)) return "reason";
+  if (KNOW_HISTORY_RE.test(t)) return "history";
+  return "current";
+}
+
+const WHO_KNOWS_RE = /\bwho\b[^?.!]{0,40}\b(?:knows?|should help|can help|could help|is best|expert)\b|\bwhich\s+(?:specialist|director|expert|board member|chamber member)\b/i;
+const CAN_YOU_RE = /^(?:(?:so|and|ok(?:ay)?|hey)[,\s]+)*(?:can|could|will|would)\s+you\b|\bare you able to\b/i;
+const SELF_SCOPE_RE = /\bwhat\s+(?:else\s+)?(?:can|could)\s+you\s+(?:do|help)\b|\bwhat\s+tools\b|\bwhat\s+can'?t\s+you\b|\bwhat\s+(?:can|could)\s+(?:spark|you)\s+not\b/i;
+export const WHERE_LIVES_RE = /\bwhere\s+(?:does|do|is|are|can i find)\b[^?.!]{0,40}\b(?:live|kept|stored|saved|find)\b|\bwhere\s+(?:is|are)\s+(?:my|our)\b/i;
+
+/** Read the member's question; null when it is not a KNOW question. */
+export function readKnowQuestion(text: string): KnowQuestion | null {
+  const t = text.trim();
+  if (!t) return null;
+  // Asking what a capability DOES is OB-5C's explain path, not a recall.
+  if (questionAboutCapability(t)) return null;
+  if (WHO_KNOWS_RE.test(t)) return { subject: "specialists", lens: "current" };
+  if (SELF_SCOPE_RE.test(t)) return { subject: "capabilities", lens: "current" };
+  if (CAN_YOU_RE.test(t) && unavailableNamed(t).length) return { subject: "capabilities", lens: "current" };
+  if (WHERE_LIVES_RE.test(t) && subjectOf(t)) return { subject: "capabilities", lens: "current" };
+  if (!isQuestionForm(t)) return null;
+  const lens = lensOf(t);
+  if (!KNOW_RECALL_RE.test(t) && lens === "current") return null;
+  const subject = subjectOf(t);
+  return subject ? { subject, lens } : null;
+}
+
+/** Capabilities the availability map says are NOT available from chat, named in the text (by the map's own names). */
+export function unavailableNamed(t: string): string[] {
+  return listCapabilityAvailability()
+    .filter(([cap, availability]) => availability === "not_available_from_chat" && new RegExp(`\\b${cap}s?\\b`, "i").test(t))
+    .map(([cap]) => cap);
+}
+
+export function subjectOf(t: string): Exclude<KnowSubject, "specialists" | "capabilities"> | null {
+  if (namesBusinessModel(t) || /\bliving model\b/i.test(t)) return "business_model";
+  if (detectClaireTopic(t) === "people-i-help") return "avatar";
+  for (const [subject, noun] of SUBJECT_NOUNS) if (noun.test(t)) return subject;
+  // "Why did we change that?" / "What was the old version?" — the thing is the
+  // business record the conversation is about.
+  if (KNOW_REASON_RE.test(t) || KNOW_HISTORY_RE.test(t)) return "business";
+  return null;
+}
+
