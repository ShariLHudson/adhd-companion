+/**
+ * OB-1 shadow isolation — proves the meaning contract is computed but NOT
+ * consumed: no production file reads relation / stance / affect / binding /
+ * meaningConfidence, calls permitsFor, or imports the meaning module, the
+ * certification harness, or the evaluation-only model read.
+ */
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+
+const ROOT = path.resolve(__dirname, "../..");
+const SCAN_DIRS = ["app", "components", "lib", "proxy.ts"];
+
+function productionFiles(): string[] {
+  const out: string[] = [];
+  const walk = (p: string) => {
+    const st = statSync(p);
+    if (st.isDirectory()) {
+      if (/node_modules|\.next|__tests__/.test(p)) return;
+      for (const f of readdirSync(p)) walk(path.join(p, f));
+      return;
+    }
+    if (!/\.(ts|tsx)$/.test(p)) return;
+    if (/\.test\.(ts|tsx)$/.test(p)) return;
+    out.push(path.relative(ROOT, p));
+  };
+  for (const d of SCAN_DIRS) {
+    try {
+      walk(path.join(ROOT, d));
+    } catch {
+      // optional entry
+    }
+  }
+  return out;
+}
+
+/** The only production files allowed to touch the meaning contract. */
+const OWNERS = new Set([
+  "lib/conversationBoundary.ts", // computes it (the single production caller)
+  "lib/conversationBoundaryMeaning.ts", // the reader + permitsFor
+  "lib/conversationBoundaryLexicon.ts", // vocabulary leaf
+]);
+const HARNESS_PREFIX = "lib/oneBrainCertification/";
+
+describe("OB-1 shadow isolation", () => {
+  const files = productionFiles().filter((f) => !OWNERS.has(f) && !f.startsWith(HARNESS_PREFIX));
+  const read = (f: string) => readFileSync(path.join(ROOT, f), "utf8");
+
+  it("no production file imports the meaning module or the certification harness", () => {
+    const offenders = files.filter((f) =>
+      /from\s+["'][^"']*(?:conversationBoundaryMeaning|oneBrainCertification)[^"']*["']/.test(read(f)),
+    );
+    expect(offenders).toEqual([]);
+  });
+
+  it("no production file calls permitsFor or readBoundaryMeaning", () => {
+    const offenders = files.filter((f) => /\b(?:permitsFor|readBoundaryMeaning)\s*\(/.test(read(f)));
+    expect(offenders).toEqual([]);
+  });
+
+  it("no production file reads the new meaning fields off a Boundary decision", () => {
+    const re =
+      /(?:[bB]oundaryDecision|turnBoundaryDecision|boundary)\??\.(?:relation|stance|affect|binding|meaningConfidence)\b|\bmeaningConfidence\b/;
+    const offenders = files.filter((f) => re.test(read(f)));
+    expect(offenders).toEqual([]);
+  });
+
+  it("the Boundary is the only production caller of the meaning reader", () => {
+    const callers = productionFiles().filter(
+      (f) => f !== "lib/conversationBoundaryMeaning.ts" && /readBoundaryMeaning\s*\(/.test(read(f)),
+    );
+    expect(callers).toEqual(["lib/conversationBoundary.ts"]);
+  });
+});
