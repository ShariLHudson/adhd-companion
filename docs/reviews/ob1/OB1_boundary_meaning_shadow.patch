+++ b/lib/conversationBoundaryMeaning.test.ts
@@ -0,0 +1,185 @@
+/**
+ * OB-1 — Boundary meaning contract (shadow): required readings + permitsFor
+ * fail-safe invariants.
+ */
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import {
+  resolveConversationBoundary,
+  type BoundaryArmedItem,
+  type BoundaryTurnInput,
+  type ConversationBoundaryDecision,
+} from "./conversationBoundary";
+import { permitsFor } from "./conversationBoundaryMeaning";
+
+const ITEMS: BoundaryArmedItem[] = [
+  { id: "a", label: "Add Susan as a speaker" },
+  { id: "b", label: "Add David as a speaker" },
+  { id: "c", label: "Send the invitation email" },
+];
+const OPEN: Partial<BoundaryTurnInput> = {
+  pendingQuestion: { kind: "open", expects: "free" },
+  lastAssistantText: "Who is this conference mainly for?",
+};
+const OFFER: Partial<BoundaryTurnInput> = {
+  pendingOffer: { summary: "offer", offeredAtTurn: 5 },
+  lastAssistantText: "Want me to set that up?",
+};
+const OFFER3: Partial<BoundaryTurnInput> = { ...OFFER, armedItems: ITEMS };
+const EXECUTED: Partial<BoundaryTurnInput> = {
+  lastExecuted: { id: "r1", label: "Check my ASEA order" },
+  lastAssistantText: "Done — set for Mondays.",
+};
+
+function read(text: string, ctx: Partial<BoundaryTurnInput> = {}) {
+  return resolveConversationBoundary({ userText: text, turn: 6, ...ctx });
+}
+
+describe("OB-1 required readings", () => {
+  it("“No, I said Tuesday.” → correct (never decline)", () => {
+    const d = read("No, I said Tuesday.", EXECUTED);
+    expect(d.relation).toBe("correct");
+    expect(d.binding?.target).toBe("executed");
+    expect(d.meaningConfidence).toBe("high");
+  });
+
+  it("“I don't know what you mean. Can you explain?” → clarify (never unsure/defer/answer)", () => {
+    const d = read("I don't know what you mean. Can you explain?", OPEN);
+    expect(d.relation).toBe("clarify");
+    expect(d.binding?.target).toBe("pending");
+    expect(d.meaningConfidence).toBe("high");
+  });
+
+  it("“I'm thinking about it, but what would it cost?” → ask + talk_about", () => {
+    const d = read("I'm thinking about it, but what would it cost?", OFFER);
+    expect(d.relation).toBe("ask");
+    expect(d.stance).toBe("talk_about");
+  });
+
+  it("“I'm frustrated, but yes, do the first one.” → accept + strained + include first", () => {
+    const d = read("I'm frustrated, but yes, do the first one.", OFFER3);
+    expect(d.relation).toBe("accept");
+    expect(d.affect).toBe("strained");
+    expect(d.binding).toEqual({ target: "pending", include: ["a"] });
+    expect(d.meaningConfidence).toBe("high");
+  });
+
+  it("“I'm falling apart. I can't do this.” → distressed; interruption stays a transition", () => {
+    const d = read("I'm falling apart. I can't do this.", {
+      ...OPEN,
+      activeTopic: { topicId: "t", goal: "plan my conference", resolved: false, startedAtTurn: 1, updatedAtTurn: 5 },
+    });
+    expect(d.affect).toBe("distressed");
+    expect(d.relation).toBe("none");
+    expect(d.decision).toBe("interrupt_and_suspend");
+  });
+
+  it("payload cases keep the binding the contract needs", () => {
+    expect(read("Yes, but make it 4:00.", OFFER).binding).toEqual({ target: "pending", amended: true });
+    expect(read("Do the first two, not the third.", OFFER3).binding).toEqual({
+      target: "pending",
+      include: ["a", "b"],
+      exclude: ["c"],
+    });
+    expect(read("Yes, add Susan, but don't add David yet.", OFFER3).binding).toEqual({
+      target: "pending",
+      include: ["a"],
+      exclude: ["b"],
+    });
+    expect(read("I don't mean the conference. I mean the retreat.", { lastAssistantText: "Your conference…" }).binding).toEqual({
+      target: "referent",
+    });
+    expect(read("What do you mean by audience?", OPEN).relation).toBe("clarify");
+    expect(read("I'm not sure. Help me figure that out.", OPEN).relation).toBe("unsure");
+  });
+
+  it("“Okay, I'm overwhelmed.” is never a high-confidence acceptance", () => {
+    const d = read("Okay, I'm overwhelmed.", OFFER);
+    expect(d.meaningConfidence).toBe("low");
+  });
+
+  it("transition fields are unchanged; meaning evidence is appended only", () => {
+    const d = read("My dog just threw up on the carpet.", {
+      activeTopic: { topicId: "t", goal: "write an email", resolved: false, startedAtTurn: 1, updatedAtTurn: 1 },
+    });
+    expect(d.decision).toBe("switch_topic");
+    expect(d.evidence.slice(0, 2)).toEqual(["substantive_new_subject", "no_overlap"]);
+    expect(d.evidence.slice(2).every((e) => e.startsWith("meaning:"))).toBe(true);
+  });
+});
+
+describe("permitsFor — fail safe", () => {
+  const base = (over: Partial<ConversationBoundaryDecision>): ConversationBoundaryDecision => ({
+    decision: "continue_current_topic",
+    confidence: "high",
+    evidence: [],
+    relation: "accept",
+    stance: "act",
+    affect: "none",
+    binding: { target: "pending" },
+    meaningConfidence: "high",
+    ...over,
+  });
+  const snap = { currentTurn: 6, armedOfferedAtTurn: 5, armedItems: ITEMS, lastExecutedId: "r1" };
+
+  it("LOW meaning confidence grants nothing", () => {
+    const p = permitsFor(base({ meaningConfidence: "low" }), snap);
+    expect(p).toMatchObject({ mayExecute: false, mayStoreAsAnswer: false, mayAdvance: false, mayModifyExecuted: false });
+    expect(p.obligation).toBe("check_meaning");
+  });
+
+  it("a decision without meaning (legacy) grants nothing", () => {
+    const p = permitsFor({ decision: "answer_pending_question", confidence: "high", evidence: [] }, snap);
+    expect(p.mayStoreAsAnswer).toBe(false);
+    expect(p.mayExecute).toBe(false);
+  });
+
+  it("accept executes only a fresh, armed, in-scope, non-talk_about offer", () => {
+    expect(permitsFor(base({}), snap).mayExecute).toBe(true);
+    expect(permitsFor(base({}), { ...snap, armedOfferedAtTurn: 2 }).mayExecute).toBe(false); // stale
+    expect(permitsFor(base({}), { ...snap, armedOfferedAtTurn: null }).mayExecute).toBe(false); // nothing armed
+    expect(permitsFor(base({ stance: "talk_about" }), snap).mayExecute).toBe(false);
+    expect(permitsFor(base({ decision: "switch_topic" }), snap).mayExecute).toBe(false);
+    expect(permitsFor(base({ binding: undefined }), snap).mayExecute).toBe(false);
+  });
+
+  it("partial acceptance can never authorize an item that is not armed", () => {
+    expect(permitsFor(base({ binding: { target: "pending", include: ["zzz"] } }), snap).mayExecute).toBe(false);
+    expect(permitsFor(base({ binding: { target: "pending", include: ["a"], exclude: ["a"] } }), snap).mayExecute).toBe(false);
+    const p = permitsFor(base({ binding: { target: "pending", include: ["a", "b"], exclude: ["c"] } }), snap);
+    expect(p.mayExecute).toBe(true);
+    expect(p.executableScope).toEqual(["a", "b"]);
+  });
+
+  it("an amended acceptance must be parsed before execution", () => {
+    expect(permitsFor(base({ binding: { target: "pending", amended: true } }), snap).requiresAmendmentParse).toBe(true);
+  });
+
+  it("clarify / ask / unsure hold the process and keep the pending item", () => {
+    for (const relation of ["clarify", "ask", "unsure"] as const) {
+      const p = permitsFor(base({ relation, decision: "answer_pending_question" }), snap);
+      expect(p).toMatchObject({ mayExecute: false, mayStoreAsAnswer: false, mayAdvance: false, preservesPending: true });
+    }
+  });
+
+  it("correction modifies only an executed item with a receipt", () => {
+    expect(permitsFor(base({ relation: "correct", binding: { target: "executed" } }), snap).mayModifyExecuted).toBe(true);
+    expect(permitsFor(base({ relation: "correct", binding: { target: "executed" } }), { ...snap, lastExecutedId: null }).mayModifyExecuted).toBe(false);
+    expect(permitsFor(base({ relation: "correct", binding: { target: "pending" } }), snap).mayModifyExecuted).toBe(false);
+  });
+
+  it("a plain answer may be stored only when Boundary grants the pending slot", () => {
+    const answer = base({ relation: "none", stance: "none", binding: undefined, decision: "answer_pending_question" });
+    expect(permitsFor(answer, snap).mayStoreAsAnswer).toBe(true);
+    expect(permitsFor(answer, { ...snap, answerAffordanceValid: false }).mayStoreAsAnswer).toBe(false);
+    expect(permitsFor({ ...answer, decision: "switch_topic" }, snap).mayStoreAsAnswer).toBe(false);
+  });
+});
+
+describe("Boundary lexicon stays a leaf", () => {
+  it("has no imports (keeps Boundary out of the ~2,400-module graph)", () => {
+    const src = readFileSync(path.join(__dirname, "conversationBoundaryLexicon.ts"), "utf8");
+    expect(src).not.toMatch(/^\s*import\s/m);
+  });
+});
