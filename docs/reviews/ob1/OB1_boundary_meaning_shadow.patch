diff --git a/lib/oneBrainCertification/bakeoff.ob1.test.ts b/lib/oneBrainCertification/bakeoff.ob1.test.ts
new file mode 100644
index 00000000..ea6c8750
--- /dev/null
+++ b/lib/oneBrainCertification/bakeoff.ob1.test.ts
@@ -0,0 +1,144 @@
+/**
+ * OB-1 — corpus coverage + A vs C bake-off.
+ *
+ * A = the deterministic certain tier (Boundary as it runs in production shadow).
+ * C = hybrid: A's HIGH readings stand; A's LOW cases take ONE structured model
+ *     read, strictly validated (modelMeaningRead.ts); invalid → LOW.
+ *
+ * The model reads replayed here are the archived blind reads in
+ * docs/reviews/ob1/proxy_model_reads.json (see the OB-1 return report for how
+ * they were produced and their limits). Set OB1_WRITE_RESULTS=1 to regenerate
+ * docs/reviews/ob1/bakeoff_results.json.
+ */
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { CORPUS, HOLDOUT, type CorpusCase, type CorpusFamily } from "./corpus";
+import { boundaryInputFor, readA, scoreCase, summarize, type CaseResult } from "./evaluate";
+import { composeHybridMeaning, validateModelMeaningRead } from "./modelMeaningRead";
+
+const ROOT = path.resolve(__dirname, "../..");
+const PROXY = path.join(ROOT, "docs/reviews/ob1/proxy_model_reads.json");
+const ID_MAP = path.join(ROOT, "docs/reviews/ob1/proxy_id_map.json");
+
+function proxyReads(): Map<string, unknown> | null {
+  if (!existsSync(PROXY) || !existsSync(ID_MAP)) return null;
+  const reads = JSON.parse(readFileSync(PROXY, "utf8")) as Record<string, unknown>;
+  const map = JSON.parse(readFileSync(ID_MAP, "utf8")) as Record<string, string>;
+  const out = new Map<string, unknown>();
+  for (const [blind, caseId] of Object.entries(map)) out.set(caseId, reads[blind]);
+  return out;
+}
+
+function runA(cases: CorpusCase[]): CaseResult[] {
+  return cases.map((c) => {
+    const { decision, meaning } = readA(c);
+    return scoreCase(c, decision, meaning, meaning.meaningConfidence === "high" ? "deterministic_high" : "deterministic_low");
+  });
+}
+
+function runC(cases: CorpusCase[], reads: Map<string, unknown>): CaseResult[] {
+  return cases.map((c) => {
+    const { decision, meaning } = readA(c);
+    const validation =
+      meaning.meaningConfidence === "high" ? null : validateModelMeaningRead(reads.get(c.id), boundaryInputFor(c));
+    const hybrid = composeHybridMeaning(meaning, validation, boundaryInputFor(c));
+    return scoreCase(c, decision, hybrid, hybrid.tier);
+  });
+}
+
+/** Model-only reading (every case goes to the model; invalid → A at LOW). */
+function runModelOnly(cases: CorpusCase[], reads: Map<string, unknown>): { results: CaseResult[]; invalid: string[] } {
+  const invalid: string[] = [];
+  const results = cases.map((c) => {
+    const { decision, meaning } = readA(c);
+    const v = validateModelMeaningRead(reads.get(c.id), boundaryInputFor(c));
+    if (!v.ok) invalid.push(`${c.id}:${v.reason}`);
+    const m = v.ok ? v.meaning : { ...meaning, meaningConfidence: "low" as const };
+    return scoreCase(c, decision, m, v.ok ? "model" : "fallback_low");
+  });
+  return { results, invalid };
+}
+
+describe("OB-1 corpus coverage", () => {
+  it("every family has ≥5 paraphrases and ≥3 negative controls", () => {
+    const families = new Set<CorpusFamily>(CORPUS.map((c) => c.family));
+    expect(families.size).toBe(17);
+    for (const f of families) {
+      const pos = CORPUS.filter((c) => c.family === f && c.kind === "positive").length;
+      const neg = CORPUS.filter((c) => c.family === f && c.kind === "negative").length;
+      expect(pos, `${f} positives`).toBeGreaterThanOrEqual(5);
+      expect(neg, `${f} negatives`).toBeGreaterThanOrEqual(3);
+    }
+  });
+
+  it("case ids are unique", () => {
+    const ids = [...CORPUS, ...HOLDOUT].map((c) => c.id);
+    expect(new Set(ids).size).toBe(ids.length);
+  });
+});
+
+describe("OB-1 bake-off — A (deterministic)", () => {
+  for (const [name, cases] of [["CORPUS", CORPUS], ["HOLDOUT", HOLDOUT]] as const) {
+    it(`${name}: every HIGH-confidence reading matches the human label`, () => {
+      const wrong = runA(cases).filter((r) => r.highButWrong).map((r) => `${r.id}: ${r.text}`);
+      expect(wrong).toEqual([]);
+    });
+    it(`${name}: zero false execution authorizations (with and without transition gating)`, () => {
+      const s = summarize(runA(cases));
+      expect(s.falseExecutions).toBe(0);
+      expect(s.falseExecutionsMeaningOnly).toBe(0);
+    });
+  }
+});
+
+describe("OB-1 bake-off — C (hybrid, replayed blind model reads)", () => {
+  const reads = proxyReads();
+  it.skipIf(!reads)("zero false execution authorizations under the validator + permitsFor", () => {
+    for (const cases of [CORPUS, HOLDOUT]) {
+      const s = summarize(runC(cases, reads!));
+      expect(s.falseExecutions).toBe(0);
+      expect(s.falseExecutionsMeaningOnly).toBe(0);
+    }
+  });
+
+  it.skipIf(!reads)("writes the measurement file when OB1_WRITE_RESULTS=1", () => {
+    if (process.env.OB1_WRITE_RESULTS !== "1") return;
+    const all = [...CORPUS, ...HOLDOUT];
+    const byFamily = (rs: CaseResult[]) => {
+      const out: Record<string, { cases: number; relationCorrect: number; fullyCorrect: number; low: number }> = {};
+      for (const r of rs) {
+        const f = (out[r.family] ??= { cases: 0, relationCorrect: 0, fullyCorrect: 0, low: 0 });
+        f.cases += 1;
+        if (r.relationCorrect) f.relationCorrect += 1;
+        if (r.fullyCorrect) f.fullyCorrect += 1;
+        if (r.confidence === "low") f.low += 1;
+      }
+      return out;
+    };
+    const section = (cases: CorpusCase[]) => {
+      const a = runA(cases);
+      const c = runC(cases, reads!);
+      const mo = runModelOnly(cases, reads!);
+      return {
+        A: { summary: summarize(a), byFamily: byFamily(a), misses: a.filter((r) => !r.fullyCorrect) },
+        C: {
+          summary: summarize(c),
+          byFamily: byFamily(c),
+          modelFallbackCases: c.filter((r) => r.tier !== "deterministic_high").length,
+          modelUsedValid: c.filter((r) => r.tier === "model").length,
+          misses: c.filter((r) => !r.fullyCorrect),
+        },
+        modelOnly: {
+          summary: summarize(mo.results),
+          invalid: mo.invalid,
+          highButWrong: mo.results.filter((r) => r.highButWrong),
+        },
+      };
+    };
+    writeFileSync(
+      path.join(ROOT, "docs/reviews/ob1/bakeoff_results.json"),
+      JSON.stringify({ corpus: section(CORPUS), holdout: section(HOLDOUT), combined: section(all) }, null, 1),
+    );
+  });
+});
diff --git a/lib/oneBrainCertification/corpus.ts b/lib/oneBrainCertification/corpus.ts
new file mode 100644
index 00000000..241f9fcf
--- /dev/null
+++ b/lib/oneBrainCertification/corpus.ts
@@ -0,0 +1,440 @@
+/**
+ * One Brain certification corpus — OB-1.
+ *
+ * HUMAN-LABELLED. Every expected value below was written from the intended
+ * meaning of the member's words (OB-0 / OB-0.5 examples, the Founder's ASEA
+ * transcript, R0 §17 executable-intent scenarios, Board round-3F-5C cases),
+ * never by running production code. Labels are the source of truth that the
+ * readers (deterministic A, hybrid C) are measured against.
+ *
+ * Each family has ≥5 natural paraphrases (`kind: "positive"`) and ≥3 negative
+ * controls (`kind: "negative"`): near-miss sentences that must NOT receive the
+ * family's reading, labelled with what they actually mean.
+ */
+
+import type {
+  BoundaryArmedItem,
+  BoundaryMemberAffect,
+  BoundaryMemberRelation,
+  BoundaryMemberStance,
+  BoundaryPendingQuestion,
+  ConversationBoundaryDecisionKind,
+} from "@/lib/conversationBoundary";
+
+export type CorpusContextId =
+  | "open_question" // Spark asked an open question (e.g. an intake question)
+  | "offer_single" // Spark offered one action ("Want me to…?") on the previous turn
+  | "offer_three" // Spark proposed three enumerated actions on the previous turn
+  | "offer_stale" // the same single offer, made four turns ago
+  | "executed" // Spark just executed an item and reported it
+  | "chat" // Spark said something; nothing pending
+  | "fresh" // nothing said yet, nothing pending
+  | "suspended_work"; // earlier work is suspended; an unrelated topic is active
+
+export type CorpusFamily =
+  | "ask_spark"
+  | "clarification"
+  | "unsure_help"
+  | "correction"
+  | "acceptance"
+  | "modified_acceptance"
+  | "partial_acceptance"
+  | "decline"
+  | "discuss_vs_act"
+  | "hypothetical"
+  | "compound_request"
+  | "interruption"
+  | "return"
+  | "stale_reference"
+  | "know_current_vs_historical"
+  | "unsupported_capability"
+  | "emotion_combined";
+
+export type ExpectedMeaning = {
+  relation: BoundaryMemberRelation;
+  stance: BoundaryMemberStance;
+  affect: BoundaryMemberAffect;
+  bindingTarget?: "pending" | "executed" | "referent";
+  include?: string[];
+  exclude?: string[];
+  amended?: boolean;
+  /** Expected permitsFor(...).mayExecute for this situation (safety label). */
+  authorizesExecution: boolean;
+  /** Expected existing Boundary transition, where the family is about transitions. */
+  transition?: ConversationBoundaryDecisionKind;
+};
+
+export type CorpusCase = {
+  id: string;
