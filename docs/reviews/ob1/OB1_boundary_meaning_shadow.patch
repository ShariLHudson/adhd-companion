+/**
+ * OB-1 — LIVE hybrid-tier measurement (evaluation only; never part of a turn).
+ *
+ * Runs ONE structured model read (the production seam `invokeStructuredLlm`,
+ * gpt-4o-mini by default) for every OB-1 corpus + holdout case, validates it
+ * exactly as the hybrid would (modelMeaningRead.ts), and writes latency p50/p95,
+ * token use, invalid-output rate, and accuracy to
+ * docs/reviews/ob1/live_model_results.json.
+ *
+ *   OPENAI_API_KEY=… npx tsx scripts/ob1-model-meaning-bakeoff.ts
+ *
+ * The OB-1 build environment could not reach api.openai.com, so the OB-1
+ * return report uses archived blind reads instead; this script is how the live
+ * numbers are produced wherever a key and network exist.
+ */
+import { writeFileSync } from "node:fs";
+import path from "node:path";
+import { CORPUS, HOLDOUT } from "../lib/oneBrainCertification/corpus";
+import { boundaryInputFor, readA, scoreCase, summarize } from "../lib/oneBrainCertification/evaluate";
+import { composeHybridMeaning, runModelMeaningRead } from "../lib/oneBrainCertification/modelMeaningRead";
+
+function pct(values: number[], p: number): number | null {
+  if (!values.length) return null;
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.min(sorted.length - 1, Math.floor((p / 100) * sorted.length))]!;
+}
+
+async function main() {
+  const cases = [...CORPUS, ...HOLDOUT];
+  const latencies: number[] = [];
+  const tokens: number[] = [];
+  let failedCalls = 0;
+  let invalid = 0;
+  const hybrid = [];
+  for (const c of cases) {
+    const { decision, meaning } = readA(c);
+    const outcome = await runModelMeaningRead(boundaryInputFor(c));
+    latencies.push(outcome.latencyMs);
+    if (outcome.totalTokens) tokens.push(outcome.totalTokens);
+    if (!outcome.callSucceeded) failedCalls += 1;
+    else if (!outcome.validation.ok) invalid += 1;
+    const composed = composeHybridMeaning(
+      meaning,
+      meaning.meaningConfidence === "high" ? null : outcome.validation,
+      boundaryInputFor(c),
+    );
+    hybrid.push(scoreCase(c, decision, composed, composed.tier));
+  }
+  const fallbackCases = hybrid.filter((r) => r.tier !== "deterministic_high").length;
+  const report = {
+    model: process.env.OB1_MODEL ?? "gpt-4o-mini (invokeStructuredLlm default)",
+    cases: cases.length,
+    latencyMs: { p50: pct(latencies, 50), p95: pct(latencies, 95) },
+    tokensPerCall: { p50: pct(tokens, 50), p95: pct(tokens, 95) },
+    failedCalls,
+    invalidOutputs: invalid,
+    fallbackFractionUnderC: fallbackCases / cases.length,
+    hybrid: summarize(hybrid),
+  };
+  const out = path.resolve(__dirname, "../docs/reviews/ob1/live_model_results.json");
+  writeFileSync(out, JSON.stringify(report, null, 1));
+  console.log(JSON.stringify({ ...report, hybrid: undefined }, null, 1));
+}
+
+void main();
