+/**
+ * Boundary lexicon — the ONE shared, import-free home of the member-turn
+ * vocabulary that Boundary's meaning reader consumes (OB-1).
+ *
+ * Every pattern here was MOVED VERBATIM from the module that proved it; those
+ * modules now import it from here, so their behavior is byte-for-byte
+ * unchanged and no vocabulary exists twice. This file must stay a leaf
+ * (no imports): the original modules transitively import ~2,400 modules, and
+ * Boundary must not.
+ */
+
+// ── Acceptance / decline (moved verbatim from pendingAcceptanceAuthority.ts and conversationConfirmationGate.ts) ──
+
+/** Generic affirmations that must not act without pending context. */
+export const GENERIC_ACCEPTANCE_RE =
+  /^(?:yes|yep|yeah|yup|ok(?:ay)?|sure|sounds good|that would help|works for me|perfect|i like it|that'?s good|that'?s fine|that works|looks good|correct|right|good|that one|use that|let'?s do it|please|please do|go ahead|proceed|count me in|let'?s go|(?:yes[,\s]+)?(?:let'?s\s+)?try it)\.?$/i;
+
+export const CONFIRMATION_DECLINE_RE =
+  /^(?:no|nope|nah|not now|not yet|stay(?:\s+here)?|something else|keep talking|later)\b/i;
+
+/** Deferrals the canonical decline regex does not cover; whole-message anchored. */
+export const DEFERRAL_SUPPLEMENT_RE =
+  /^(?:maybe later|not today|some other time|another time|no thanks?|no thank you|let'?s not|skip it|hold off|never ?mind)\b/i;
+
+/** Normalize for acceptance matching — case, curly apostrophes, whitespace, trailing punctuation. */
+export function normalizeAcceptanceText(text: string): string {
+  return text
+    .normalize("NFKC")
+    .replace(/[‘’ʼ`]/g, "'")
+    .replace(/\s+/g, " ")
+    .trim()
+    .replace(/[.!?…]+$/g, "")
+    .trim()
+    .toLowerCase();
+}
+
+/** Matrix tokens the canonical base regex does not cover; whole-message anchored. */
+export const SHORT_ACCEPTANCE_SUPPLEMENT_RE =
+  /^(?:do it|absolutely|(?:yes|okay|ok|sure)\s+please)$/i;
+
+// ── Stance and restraint (moved verbatim from memberIntent/executableRequest.ts) ──
+
+export const PAST_TENSE_RE =
+  /\b(?:i|we)\s+(?:already\s+|just\s+)?(?:added|put|created|made|set up|scheduled|saved|placed|entered)\b|\b(?:i'?ve|i have|we'?ve|we have)\s+(?:already\s+)?(?:added|put|created|made|set up|scheduled|saved|placed|got)\b|\balready\s+(?:added|put|created|set up|scheduled|have (?:it|that|this|one))\b|\b(?:it'?s|it is|that'?s|that is)\s+already\s+(?:in|on)\b/i;
+
+export const NEGATED_RE =
+  /\b(?:don'?t|do not|never|no need to|stop|please don'?t)\s+(?:\w+\s+){0,2}?(?:add|put|create|make|set up|schedule|remind|save)\b/i;
+
+export const NEGATION_EXCEPTION_RE = /\b(?:don'?t|never)\s+let me forget\b/i;
+
+export const HYPOTHETICAL_RE =
+  /\bwhat if\b|\bif i (?:were to|did|made|added|put|set up|created)\b|\bsuppose\b|\bimagine\b|\bhypothetically\b|\bwould it (?:help|make sense|work)\b/i;
+
+export const THINKING_ALOUD_RE =
+  /\b(?:maybe|perhaps)\s+(?:i|we)\b|\bi\s+(?:should|could|might|may|probably should)\b|\bi\s+(?:think|guess|suppose)\s+i\b|\b(?:i'?m|i am)\s+(?:thinking|considering|wondering|debating|toying)\b|\bthinking (?:about|of)\b|\bconsidering\b|\bi wonder\b|\bshould i\b|\bprobably should\b/i;
+
+export const CAPABILITY_QUESTION_START_RE =
+  /^(?:can|could|would|will|do|does|are|is|am)\s+(?:you|spark|it|i|we|this|the app)\b/i;
+
+export const GENERIC_OBJECT_RE =
+  /\b(?:things|stuff|anything|items|something|rhythms|reminders|events|entries)\b/i;
+
+export const ABILITY_PHRASE_RE =
+  /\b(?:are you able to|is it possible to|do you (?:do|support|have|handle|offer)|does (?:spark|the app|this|it) (?:do|support|have|handle)|how (?:do|can|would|should) i|how to|can i|could i)\b/i;
+
+export const DIRECT_INSTRUCTION_RE =
+  /^(?:(?:please|ok(?:ay)?|hey|spark|so|also|and|now|then|just|go ahead and|alright|great)[,!\s]+)*(?:add|put|create|make|set up|setup|schedule|start|set|place|save|build|remind me|get)\b/i;
+
+export const REQUEST_TO_SPARK_RE =
+  /\b(?:need|want|would like|'d like)\s+(?:you|spark)\s+to\b|\b(?:can|could|would|will)\s+you\s+(?:please\s+)?(?:\w+\s+){0,8}?(?:add|put|create|make|set up|setup|schedule|start|set|place|save|remind)\b|\bplease\s+(?:\w+\s+){0,2}?(?:add|put|create|make|set up|schedule|start|remind)\b/i;
+
+export const ASPIRATION_RE =
+  /\b(?:i\s+)?(?:need|want|would like|'d like|wanna|gonna|going)\s+(?:to\s+)?(?:add|put|create|make|set up|setup|schedule|start|get)\b/i;
+
+export function isCapabilityQuestion(text: string): boolean {
+  if (ABILITY_PHRASE_RE.test(text)) return true;
+  if (!CAPABILITY_QUESTION_START_RE.test(text)) return false;
+  return GENERIC_OBJECT_RE.test(text);
+}
+
+export type TalkAboutReason =
+  | "hypothetical"
+  | "past_tense"
+  | "negated"
+  | "thinking_aloud"
+  | "capability_question";
+
+export function talkAboutReason(text: string): TalkAboutReason | null {
+  if (HYPOTHETICAL_RE.test(text)) return "hypothetical";
+  if (PAST_TENSE_RE.test(text)) return "past_tense";
+  if (NEGATED_RE.test(text) && !NEGATION_EXCEPTION_RE.test(text)) return "negated";
+  if (THINKING_ALOUD_RE.test(text)) return "thinking_aloud";
+  if (isCapabilityQuestion(text)) return "capability_question";
+  return null;
+}
+
+export const LEADING_ACCEPTANCE_RE =
+  /^(?:yes|yeah|yep|yup|sure|ok(?:ay)?|please|go ahead|do it|sounds good|perfect|great)\b[\s,!.:;-]*(?:but\s+|and\s+|though\s+)?/i;
+
+// ── Member conversational moves (moved verbatim from board/reconstructed/orchestration/classifyMemberBoardResponse.ts) ──
+
+/**
+ * Founder retest — a member turn confused about the QUESTION ITSELF ("what
+ * do you mean", "I'm not sure what you're asking") is a different
+ * conversational move than not knowing the ANSWER. It fires on the
+ * structural shape of confusion-about-the-question (an uncertainty marker
+ * paired with "what you mean/asking/getting at", or a direct "what does
+ * that mean"/"can you clarify" request) — never on a fixed business-topic
+ * word list, so it generalizes to any Director's question.
+ */
+export const MEMBER_CLARIFICATION_RE =
+  /\b(not\s+sure|don'?t\s+know|no\s+idea|unclear|confused)\b[^.!?]{0,40}\b(what|how)\s+(you'?re|you\s+are|you)\s+(asking|mean(?:ing)?|getting\s+at)\b|\bwhat\s+(do|does)\s+(you|that)\s+mean\b|\b(i\s+)?(don'?t|do\s+not)\s+understand\b|\bcan\s+you\s+(clarify|explain|rephrase|say\s+that\s+(again|another\s+way))\b|\bcould\s+you\s+clarify\b|\bnot\s+sure\s+what\s+(that|this)\s+means\b|\bwhat\s+are\s+you\s+asking\b/i;
+
+/**
+ * A request for Spark/Board assistance in figuring something out, alongside
+ * (or instead of) an answer. Structural: "help me + [figure/determine/
+ * calculate/compare/decide/plan/explore/think through]", or a direct request
+ * for help, never a fixed topic list.
+ */
+export const MEMBER_HELP_REQUEST_RE =
+  /\bhelp\s+me\s+(figure|work|think|calculate|determine|decide|compare|explore|plan|understand)\b|\bwould\s+welcome\s+(the\s+)?help\b|\b(can|could)\s+you\s+help\b|\bwalk\s+me\s+through\b|\bneed\s+(some\s+)?help\s+(figuring|working|thinking|determining|deciding)\b|\bhelp\s+(figuring|working)\s+(it|this|that)\s+out\b/i;
+
+/**
+ * The member saying a Board premise/understanding is wrong — structural
+ * ("that's not right/correct/what I said/meant", "you misunderstood", "I
+ * didn't say that"), never a topic-specific phrase list.
+ */
+export const MEMBER_CORRECTION_RE =
+  /\bthat'?s\s+not\s+(right|correct|quite\s+right|what\s+i\s+(said|meant))\b|\byou\s+(misunderstood|misread|got\s+that\s+wrong)\b|\bi\s+(didn'?t|did\s+not)\s+say\s+that\b|\bactually,?\s+no\b|\bno,?\s+that'?s\s+not\s+(it|right)\b/i;
+
+// ── New in OB-1 — structural, domain-free markers the moved vocabularies lack ──
+// Each is the smallest structural shape needed for the Boundary meaning
+// contract (OB-0.5). None names a business topic. None grants anything: every
+// permission is derived later by `permitsFor`, which fails safe on LOW meaning
+// confidence.
+
+/**
+ * Crisis-level distress — the subset of Boundary's EMOTIONAL_URGENCY_RE and
+ * adhdEmotionalFrictionIntelligence CRISIS_DISTRESS_RE that signals the member
+ * cannot continue right now. Ordinary strain ("overwhelmed", "frustrated") is
+ * deliberately NOT here: it is a tone modifier, never an interruption on its own.
+ */
+export const AFFECT_DISTRESS_RE =
+  /\b(?:falling apart|can'?t cope|can'?t handle (?:this|it|any ?more)|breaking down|panicking|panic attack|freaking out|shutting down|can'?t do this|can'?t breathe|can'?t catch (?:my )?breath|at my breaking point)\b/i;
+
+/** Strain that should soften delivery and reduce process pressure, never erase meaning. */
+export const AFFECT_STRAIN_RE =
+  /\b(?:frustrat(?:ed|ing)|annoy(?:ed|ing)|overwhelm(?:ed|ing)|stressed|anxious|exhausted|so tired|confus(?:ed|ing)|ugh+|this is (?:hard|a lot)|too much)\b/i;
+
+/**
+ * Not knowing the answer to what Spark asked. Subset of activeTopicGate
+ * GENUINE_UNCERTAINTY_RE and Board UNKNOWN_MARKERS without their
+ * topic-specific or affect terms.
+ */
+export const UNSURE_RE =
+  /\b(?:i\s+)?(?:don'?t|do not)\s+know\b|\bnot\s+(?:really\s+)?sure\b|\bno\s+idea\b|\bunsure\b|\bidk\b|\bdunno\b|\bhaven'?t decided\b|\bcan'?t decide\b|\bnot certain\b/i;
+
+/** A sentence that opens with a wh-word — a question even without "?". */
+export const WH_OPEN_RE =
+  /^(?:(?:so|and|but|wait|ok(?:ay)?|hmm|also|then)[,\s]+)*(?:what|why|how|when|where|who|whom|whose|which)\b/i;
+
+/** Stating that Spark's understanding or action is wrong. */
+export const STATED_WRONG_RE =
+  /\b(?:that'?s|that is|it'?s|it is|you'?re|you are|you got (?:it|that))\s+(?:all\s+)?wrong\b|\bwrong (?:day|date|time|one|person|name|place|event|item)\b/i;
+
+/**
+ * Restating what the member already said or meant. "I meant to <verb>" is an
+ * intention, not a correction (same guard as turnRecovery CORRECTION_RE).
+ */
+export const SAID_MEANT_RE =
+  /\bi\s+(?:said|asked for|told you)\b|\bi\s+meant\b(?!\s+to\s+\w)/i;
+
+/** Correcting WHICH thing Spark is talking about ("I don't mean X, I mean Y"). */
+export const REFERENT_CORRECTION_RE =
+  /\bi\s+(?:don'?t|didn'?t|do not|did not)\s+mean\b|\bnot\s+(?:the|that|this|my)\s+[\w'-]+(?:\s+[\w'-]+)?\s*[,;—–-]+\s*(?:the|my|i mean|i meant)\b/i;
+
+/** A clause that opens by telling Spark not to act. */
+export const DONT_ACT_OPEN_RE =
+  /^(?:please\s+)?(?:don'?t|do not)\s+(?:do|add|put|make|create|schedule|set|save|send|book|include)\b|^(?:not yet|hold off)\b/i;
+
+/** An amendment riding on an acceptance ("yes, but make it 4:00"). */
+export const AMENDMENT_RE =
+  /\b(?:make it|change it|move it|switch it|push it|instead|actually)\b|\bat\s+\d{1,2}(?::\d{2})?\b|\b\d{1,2}:\d{2}\b|\b\d{1,2}\s*(?:am|pm|a\.m\.|p\.m\.)(?![a-z])|\b(?:on|to)\s+(?:mon|tues|wednes|thurs|fri|satur|sun)day\b|\bevery\s+(?:day|week|month|morning|evening|(?:mon|tues|wednes|thurs|fri|satur|sun)day)\b|\b(?:weekly|monthly|daily)\b/i;
+
+/** Marks a clause as EXCLUDING what follows ("not the third", "but don't add David"). */
+export const EXCLUSION_MARKER_RE =
+  /\b(?:not|except|skip|without|leave out|hold off on|don'?t (?:add|do|include|send|book|schedule))\b/i;
+
+/** Supplements THINKING_ALOUD_RE with the adverbial forms ("I'm just thinking"). */
+export const TALK_ABOUT_SUPPLEMENT_RE =
+  /\b(?:i'?m|i am|we'?re|we are)\s+(?:just|only|still)\s+(?:thinking|considering|wondering|brainstorming|exploring|musing)\b|\bjust (?:thinking|brainstorming|exploring|musing)(?: out loud)?\b/i;
+
+/**
+ * A clause-initial imperative action verb — an instruction to Spark even when
+ * the verb is outside DIRECT_INSTRUCTION_RE's capability list. Excludes the
+ * noun reading ("Change is hard", "Plan was to…").
+ */
+export const IMPERATIVE_ACTION_OPEN_RE =
+  /^(?:(?:please|ok(?:ay)?|so|also|and|now|then|just|quick thing|one sec|hey)[,!\s]+)*(?:send|email|text|call|book|schedule|move|cancel|delete|remove|update|change|rename|draft|write|order|pay|invite|share|post|publish|add|put|create|make|set up|remind me)\b(?!\s+(?:is|was|are|were)\b)/i;
+
+/** First-person / exclamative framing: the strain is the MEMBER's own. */
+export const FIRST_PERSON_AFFECT_FRAME_RE =
+  /\b(?:i|i'?m|im|i am|i feel|i'?ve|me|my)\b|^\s*(?:ugh+|argh+|this is|that'?s|it'?s|so)\b/i;
+
+/** A yes/no question put to Spark's abilities or opinions ("Do you connect to…?"). */
+export const QUESTION_TO_SPARK_OPEN_RE =
+  /^(?:(?:so|and|but|wait|ok(?:ay)?)[,\s]+)*(?:do|does|can|could|will|would|are|is)\s+(?:you|spark|it|the app)\b/i;
