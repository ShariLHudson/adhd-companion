+];
+
+describe("The connected capability set — ordinary conversation reaches every owner", () => {
+  it.each(MATRIX)("$id: '$text'", ({ id, text, handoff, returns }) => {
+    const before = memberSnapshot();
+    const r = turn(text, 1);
+    expect(ownerOf(r.selection)).toBe(id);
+    if (handoff === "owner_seam") {
+      expect(r.selection?.kind).toBe("defer");
+      expect(CAPABILITY_CONNECTIONS[id].handoff).toBe("owner_seam");
+    } else if (handoff === "board_invite") {
+      expect(r.plan?.kind).toBe("board_invite");
+    } else {
+      const payload = r.plan && "payload" in r.plan ? r.plan.payload : null;
+      expect(payload?.kind).toBe(handoff);
+      if (r.plan?.kind === "offer") expect(turn("yes", 2, r.reply).accepted?.kind).toBe(handoff);
+    }
+    expect(CAPABILITY_CONNECTIONS[id].returnPath).toBe(returns);
+    // Selecting, offering and accepting never write member state themselves.
+    expect(memberSnapshot()).toBe(before);
+  });
+
+  it("projects: a saved project named in conversation → its grounded next step", () => {
+    seedProject("Spring Launch");
+    const r = turn("Help me figure out what to do next on my Spring Launch project.", 1);
+    expect(ownerOf(r.selection)).toBe("projects");
+    expect(r.plan?.kind === "execute" || r.plan?.kind === "offer").toBe(true);
+  });
+
+  it("partially connected owners say so (no chat summary of their result yet)", () => {
+    for (const id of ["events", "strategy_chamber", "visual_thinking", "client_avatars", "lmc"] as const) {
+      expect(CAPABILITY_CONNECTIONS[id].status).toBe("partially_connected");
+    }
+  });
+});
