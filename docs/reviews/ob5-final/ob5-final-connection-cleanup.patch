+/**
+ * OB-5 final: the MEANING behind the allow-list's literal phrases. The member asks
+ * to think about, understand or organize something IN A VISUAL WAY. This is
+ * structural, not a phrase list:
+ *   (a) a thinking / seeing / arranging verb + the visual MANNER adverb
+ *       ("see this visually", "think it through visually", "lay this out visually");
+ *   (b) spatially arranging the member's own material: lay/map/sketch/spread
+ *       + a deictic object + "out" ("map this out", "lay it all out");
+ *   (c) seeing RELATIONS between parts ("see how these pieces fit together");
+ *   (d) the member's stated way of thinking ("I think better when I can see it").
+ * The manner adverb must attach to a thinking verb. So a description of content
+ * ("my site looks visually cluttered") or a request for an image never matches.
+ */
+const THINK_VERB = String.raw`(?:see|seeing|think|thinking|understand|organi[sz]e|sort|work|show|lay|look|explore|process|plan|map|picture|walk)`;
+const VISUAL_MANNER_RE = new RegExp(String.raw`\b${THINK_VERB}\b[^.?!]{0,40}?\b(?:visually|in a visual way)\b`, "i");
+const LAYOUT_RE =
+  /\b(?:lay|map|sketch|spread|draw)\s+(?:this|it|that|these|them|everything|things)(?:\s+all)?\s+out\b/i;
+const SEE_RELATIONS_RE =
+  /\bsee how\b[^.?!]{0,40}?\b(?:fit|fits|connect|connects|relate|relates|link|links|come)\s+(?:together|to each other|up)\b/i;
+const SEEING_THINKER_RE =
+  /\b(?:think|work|understand|process|learn)\s+(?:better|best)\s+(?:when|if)\s+i\s+(?:can\s+)?see\b/i;
+
+export function expressesVisualThinkingIntent(text: string): boolean {
+  const t = text.trim();
+  if (!t) return false;
+  return VISUAL_MANNER_RE.test(t) || LAYOUT_RE.test(t) || SEE_RELATIONS_RE.test(t) || SEEING_THINKER_RE.test(t);
+}
+
 export function isExplicitVisualThinkingRequest(text: string): boolean {
