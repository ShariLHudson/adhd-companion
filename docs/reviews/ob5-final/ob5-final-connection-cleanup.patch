+/**
+ * OB-5 final: a deliberation about the member's OWN course of action, as
+ * opposed to a pick between two named options (the Compass's own
+ * "X or Y" job). It is one of:
+ *   - the Estate's decision signal, or
+ *   - uncertainty (the Boundary lexicon) about deciding or whether to act.
+ * Either way it must be about THIS (the conversation's subject) or the
+ * member's own affairs ("my / our"). The Founder assigns these to the Board
+ * (big decision); a two-option pick stays here.
+ */
+const DELIBERATION_VERB_RE = /\b(?:decid\w*|should\s+(?:i|we)|whether\s+(?:i|we|to))\b/i;
+const OWN_SUBJECT_RE = /\b(?:this|that|it|my|our)\b/i;
+const TWO_OPTIONS_RE = /\bor\b/i;
+
+export function isOwnDecisionDeliberation(text: string): boolean {
+  const t = text.trim();
+  if (!t || TWO_OPTIONS_RE.test(t) || !OWN_SUBJECT_RE.test(t)) return false;
+  return isDecisionCompassOfferSignal(t) || (UNSURE_RE.test(t) && DELIBERATION_VERB_RE.test(t));
+}
