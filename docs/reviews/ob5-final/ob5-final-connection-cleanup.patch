+ * change ("my business is changing", "what my business really is"). This is
+ * Claire's subject (business understanding). One Brain pairs it with its own
+ * uncertainty / talk-it-through meaning to decide "exploring → Claire".
+ */
+const BUSINESS_SELF_SUBJECT_RE =
+  /\b(?:my|our)\s+(?:business|company)\s+(?:really\s+|actually\s+)?(?:is|was|has|keeps|feels|seems|looks)\b|\bwhat\s+(?:my|our)\s+(?:business|company)\s+(?:really\s+|actually\s+)?is\b/i;
+
+export function namesOwnBusinessAsSubject(text: string): boolean {
+  return BUSINESS_SELF_SUBJECT_RE.test(text.trim());
+}
