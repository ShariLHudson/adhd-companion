diff --git a/lib/oneBrainCertification/finalConnection.ob5f.test.ts b/lib/oneBrainCertification/finalConnection.ob5f.test.ts
new file mode 100644
index 00000000..84439244
--- /dev/null
+++ b/lib/oneBrainCertification/finalConnection.ob5f.test.ts
@@ -0,0 +1,376 @@
+// @vitest-environment jsdom
+/**
+ * OB-5 final — connection cleanup certification.
+ *
+ *  1. Founder decisions: business model → Living Model Canvas (exploring the
+ *     business → Claire); big decision → Board (explicit strategy work →
+ *     Strategy Chamber).
+ *  2. Visual Thinking: the owner's structural "wants to SEE it" meaning, as a
+ *     paraphrase family with negative controls.
+ *  3. Adversarial precedence across owners.
+ *  4. The full connected capability set: UNDERSTAND → CONNECT → DECIDE →
+ *     HANDOFF → RETURN / CONTINUE.
+ *
+ * Same production chain as the OB-5 / OB-5C certification (Boundary → OB-3 /
+ * OB-4 bindings → capability selection → plan). Ordinary member language only.
+ */
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { getOrCreateConversationSpine } from "@/lib/conversationSession/spine";
+import { resetConversationSessionMemoryForTests } from "@/lib/conversationSession/store";
+import { captureBoundaryPreTurnSnapshot, resolveTurnBoundaryDecision } from "@/lib/conversationBoundaryInputs";
+import { resolveCorrectionBinding, resolvePendingBinding } from "@/lib/conversationBoundaryRoomGate";
+import {
+  armPendingReply,
+  notePendingReplyHeld,
+  readPendingReply,
+  releasePendingReply,
+} from "@/lib/conversationSession/ownership/pendingReply";
+import { resolveCapabilitySelection, type CapabilitySelection } from "@/lib/oneBrainCapability/selectCapability";
+import {
+  CAPABILITY_BIND_PREFIX,
+  lmcOfferAfterClaire,
+  planCapabilityTurn,
+  planChoiceAcceptance,
+  type CapabilityHandoffPayload,
+  type CapabilityTurnPlan,
+} from "@/lib/oneBrainCapability/handoffs";
+import { CAPABILITY_CONNECTIONS, type OneBrainCapabilityId } from "@/lib/oneBrainCapability/connections";
+import { detectClientAvatarExploration } from "@/lib/clientAvatarOffer";
+import { expressesVisualThinkingIntent, isExplicitVisualThinkingRequest } from "@/lib/visualThinkingOverreach";
+import { detectVisualRecommendationIntent } from "@/lib/visualRecommendationEngine";
+import { resolveContinuationOffer } from "@/lib/businessProfileFounder/pertinentContinuation";
+import { saveProject } from "@/lib/companionProjectsStore";
+
+const HOLD = "NEXT_PUBLIC_BOUNDARY_MEANING_HOLD";
+let saved: string | undefined;
+beforeEach(() => {
+  saved = process.env[HOLD];
+  delete process.env[HOLD];
+  localStorage.clear();
+  sessionStorage.clear();
+  resetConversationSessionMemoryForTests();
+  getOrCreateConversationSpine();
+});
+afterEach(() => {
+  if (saved === undefined) delete process.env[HOLD];
+  else process.env[HOLD] = saved;
+});
+
+type Turn = {
+  selection: CapabilitySelection | null;
+  plan: CapabilityTurnPlan | null;
+  accepted: CapabilityHandoffPayload | null;
+  reply: string;
+};
+
+/** One member turn as the page runs its One Brain connect block. */
+function turn(text: string, n: number, lastAssistantText = ""): Turn {
+  const snap = captureBoundaryPreTurnSnapshot();
+  const decision = resolveTurnBoundaryDecision({ userText: text, turn: n - 1, lastAssistantText, snapshot: snap });
+  const pb = resolvePendingBinding({ decision, pending: snap.pendingOwner, currentTurn: n });
+  if (pb?.kind === "preserve") notePendingReplyHeld(n);
+  if (pb?.kind === "release") releasePendingReply("member_declined");
+  const cb = resolveCorrectionBinding({ decision, pending: snap.pendingOwner, receipt: snap.receipt, currentTurn: n });
+  const selection = resolveCapabilitySelection({ decision, userText: text, pendingBinding: pb, correctionBinding: cb });
+  if (pb?.kind === "bind" && pb.executable && pb.bindKey.startsWith(CAPABILITY_BIND_PREFIX)) {
+    const payload = (readPendingReply()?.handoff ?? null) as CapabilityHandoffPayload | null;
+    releasePendingReply("capability_handoff_accepted");
+    return { selection, plan: null, accepted: payload, reply: "" };
+  }
+  const plan = selection
+    ? planCapabilityTurn({ selection, userText: text, peopleIHelp: detectClientAvatarExploration(text) })
+    : null;
+  if (plan?.kind === "offer") {
+    armPendingReply({ bindKey: plan.bindKey, offeredAtTurn: n, handoff: plan.payload as unknown as Record<string, unknown> });
+    return { selection, plan, accepted: null, reply: plan.reply };
+  }
+  return { selection, plan, accepted: null, reply: plan?.kind === "execute" ? plan.ack : "" };
+}
+
+const kindOf = (s: CapabilitySelection | null) =>
+  !s
+    ? "null"
+    : s.kind === "none"
+      ? `none:${s.reason}`
+      : s.kind === "ask"
+        ? `ask:${s.options.map((o) => o.id).join("/")}`
+        : `${s.kind}:${s.id}`;
+
+/** The owner One Brain chose (route or confirm), else null. */
+const ownerOf = (s: CapabilitySelection | null): OneBrainCapabilityId | null =>
+  s && (s.kind === "route" || s.kind === "confirm" || s.kind === "defer") ? s.id : null;
+
+const MEMBER_STORES = [
+  "companion-business-profile-v1",
+  "companion-ideal-clients-v1",
+  "companion-projects-v1",
+  "companion-reminders-v1",
+  "spark.board.director-discussions.v1",
+  "companion-research-library-collections-v1",
+];
+const memberSnapshot = () => MEMBER_STORES.map((k) => localStorage.getItem(k)).join("\u0001");
+
+function seedProject(name: string) {
+  return saveProject({ name, goal: `Finish ${name}` } as never).find((p) => p.name === name)!;
+}
+
+// ── 1. Founder decision: business model ──────────────────────────────────────
+
+describe("Founder decision — business model → Living Model Canvas; exploring the business → Claire", () => {
+  it.each([
+    "Let's look at my business model.",
+    "I want to work on my business model.",
+    "Show me my business model.",
+    "I need to update my business model.",
+  ])("%s → the Living Model Canvas opens (named object: the Living Business Model)", (text) => {
+    const r = turn(text, 1);
+    expect(kindOf(r.selection)).toBe("route:lmc");
+    expect(r.plan).toMatchObject({ kind: "execute", payload: { kind: "lmc_open", memberRequest: text } });
+  });
+
+  it.each([
+    ["I'm not sure what my business really is anymore.", "my-business"],
+    ["Help me figure out what my business does.", "my-business"],
+    ["I don't know who I'm really serving.", "people-i-help"],
+    ["I think my business is changing and I need to talk it through.", "my-business"],
+    ["I'm not sure my business model works anymore.", "my-business"],
+  ])("%s → Claire (exploring), area %s", (text, area) => {
+    const r = turn(text, 1);
+    expect(kindOf(r.selection)).toBe("route:claire");
+    expect(r.selection?.kind === "route" && r.selection.recognition.detail).toMatchObject({ purpose: "explore" });
+    expect(r.plan).toMatchObject({ kind: "execute", payload: { kind: "claire_topic", areaId: area } });
+  });
+
+  it("Claire → Living Model: a settled change in an area the canvas projects is offered onto the canvas", () => {
+    const offer = lmcOfferAfterClaire("my-business", "We sell coaching to new managers.")!;
+    expect(offer.bindKey).toBe(`${CAPABILITY_BIND_PREFIX}lmc`);
+    armPendingReply({ bindKey: offer.bindKey, offeredAtTurn: 1, handoff: offer.payload as unknown as Record<string, unknown> });
+    const yes = turn("yes", 2, offer.reply);
+    expect(yes.accepted).toEqual({ kind: "lmc_open", memberRequest: "We sell coaching to new managers." });
+    // People I Help keeps its own Avatar Builder offer; unknown areas offer nothing.
+    expect(lmcOfferAfterClaire("people-i-help", "x")).toBeNull();
+    expect(lmcOfferAfterClaire(undefined, "x")).toBeNull();
+  });
+
+  it("inside Claire, her own continuation still hands the member to the canvas", () => {
+    expect(resolveContinuationOffer({ utterance: "Show me how my business fits together." })?.kind).toBe("lmc");
+  });
+});
+
+// ── 2. Founder decision: big decision ────────────────────────────────────────
+
+describe("Founder decision — big decision → Board; explicit strategy work → Strategy Chamber", () => {
+  it.each([
+    "I have a big decision to make.",
+    "I need several perspectives on this.",
+    "Help me think through a major business decision.",
+    "I can't decide whether I should do this.",
+    "I can't decide whether to raise my prices.",
+  ])("%s → the Board is offered (the invite is the short clarification)", (text) => {
+    const before = memberSnapshot();
+    const r = turn(text, 1);
+    expect(kindOf(r.selection)).toBe("confirm:board");
+    expect(r.plan?.kind).toBe("board_invite");
+    expect(memberSnapshot()).toBe(before);
+  });
+
+  it.each([
+    "I need a strategy for launching this.",
+    "Let's work through my pricing strategy.",
+    "Help me develop a growth strategy.",
+    "I want to rethink my strategy.",
+  ])("%s → the Strategy Chamber (offered with the question on the table)", (text) => {
+    const r = turn(text, 1);
+    expect(ownerOf(r.selection)).toBe("strategy_chamber");
+    expect(r.plan).toMatchObject({ kind: "offer", payload: { kind: "strategy_entry", memberRequest: text } });
+  });
+
+  it("a deliberation held as DISCUSSION is only ever offered the Board — never routed, never executed", () => {
+    const r = turn("I can't decide whether I should do this.", 1);
+    expect(r.selection?.kind).toBe("confirm");
+    expect(r.accepted).toBeNull();
+  });
+
+  it.each([
+    "I can't decide what to have for lunch.",
+    "I'm not sure whether this is the right file.",
+    "Should I hire a VA or a bookkeeper?", // a two-option pick stays with the Decision Compass seam
+  ])("negative control: %s → not the Board", (text) => {
+    expect(ownerOf(turn(text, 1).selection)).not.toBe("board");
+  });
+
+  it("ADHD strategies stay with the Strategies library, not the Chamber", () => {
+    expect(kindOf(turn("I prefer ADHD strategies for focus.", 1).selection)).toBe("confirm:strategy_library");
+  });
+});
+
+// ── 3. Visual Thinking: paraphrase family + negative controls ────────────────
+
+const VISUAL_FAMILY = [
+  "I need to see this visually.",
+  "Help me think this through visually.",
+  "Can you help me think this through visually?",
+  "Can you show this to me visually?",
+  "I think better when I can see it.",
+  "Can we map this out?",
+  "Help me visualize this.",
+  "I need to organize this visually.",
+  "Could we lay this out visually?",
+  "I'd like to see how these pieces fit together.",
+];
+
+describe("Visual Thinking — the owner recognizes the MEANING (wants to see / organize it visually)", () => {
+  it.each(VISUAL_FAMILY)("%s → the studio's own recognizers and One Brain agree: Visual Thinking", (text) => {
+    expect(isExplicitVisualThinkingRequest(text)).toBe(true);
+    expect(detectVisualRecommendationIntent(text)).not.toBe("none");
+    const r = turn(text, 1);
+    expect(ownerOf(r.selection)).toBe("visual_thinking");
+    expect(r.plan).toMatchObject({ kind: "offer", payload: { kind: "visual_open", memberRequest: text } });
+    const yes = turn("yes", 2, r.reply);
+    expect(yes.accepted).toMatchObject({ kind: "visual_open", memberRequest: text });
+  });
+
+  it.each([
+    ["I need to see the doctor tomorrow.", "reminders"],
+    ["Show me my projects.", null],
+    ["Can you show me my reminders?", null],
+    ["I want to create an image for my Instagram post.", "create"],
+    ["Create a visual for my social media post.", "create"],
+    ["Our brand visuals need a refresh.", null],
+    ["Let me see what I can do.", null],
+    ["Take me to the Board Room.", null],
+    ["The board wants to see the numbers.", "board"],
+    ["I can't see the button on my screen.", null],
+    ["My website looks visually cluttered.", null],
+    ["I need a map of the venue for my event.", null],
+    ["What is a mind map?", "research"],
+    ["Write a blog post about visual thinking.", null],
+  ])("negative control: %s → never Visual Thinking (owner: %s)", (text, owner) => {
+    expect(expressesVisualThinkingIntent(text)).toBe(false);
+    const r = turn(text, 1);
+    expect(ownerOf(r.selection)).not.toBe("visual_thinking");
+    expect(ownerOf(r.selection)).toBe(owner);
+  });
+});
+
+// ── 4. Adversarial precedence ────────────────────────────────────────────────
+
+describe("Adversarial precedence", () => {
+  it("business model + uncertainty → Claire; business model + update → Living Model Canvas", () => {
+    expect(kindOf(turn("I'm not sure my business model works anymore.", 1).selection)).toBe("route:claire");
+    expect(ownerOf(turn("Can you update my business model with the new offer?", 2).selection)).toBe("lmc");
+  });
+
+  it("strategy + big decision → one short choice between the two Founder owners; choosing plans exactly that owner", () => {
+    const r = turn("I have a big decision about my pricing strategy.", 1);
+    expect(kindOf(r.selection)).toBe("ask:board/strategy_chamber");
+    const choice = (r.plan as { payload: CapabilityHandoffPayload }).payload as Extract<CapabilityHandoffPayload, { kind: "choice" }>;
+    expect(planChoiceAcceptance(choice, "board")?.kind).toBe("board_invite");
+    expect(planChoiceAcceptance(choice, "strategy_chamber")).toMatchObject({ kind: "offer", payload: { kind: "strategy_entry" } });
+    expect(planChoiceAcceptance(choice, "visual_thinking")).toBeNull();
+  });
+
+  it("naming the Board beats a strategy topic", () => {
+    expect(kindOf(turn("What does the board think about my pricing strategy?", 1).selection)).toBe("route:board");
+  });
+
+  it("visual thinking + strategy → a short choice (both explicit)", () => {
+    expect(kindOf(turn("Can you help me see my pricing strategy visually?", 1).selection)).toBe(
+      "ask:strategy_chamber/visual_thinking",
+    );
+  });
+
+  it("visual thinking + event → a short choice; an event with only weak visual words stays with Events", () => {
+    expect(kindOf(turn("I'm planning a workshop and want to map it out visually.", 1).selection)).toBe(
+      "ask:events/visual_thinking",
+    );
+    expect(ownerOf(turn("Help me visualize my event timeline.", 2).selection)).toBe("events");
+  });
+
+  it("visual thinking + a SAVED project → the member's own project wins (saved object outranks)", () => {
+    seedProject("Spring Launch");
+    expect(ownerOf(turn("Can we map out my Spring Launch project visually?", 1).selection)).toBe("projects");
+  });
+
+  it("saved project name + another topic signal → the saved project", () => {
+    seedProject("Spring Launch");
+    expect(ownerOf(turn("What's next on my Spring Launch project?", 1).selection)).toBe("projects");
+  });
+
+  it("visual thinking + Create → Create keeps a creation request; Visual Thinking never steals it", () => {
+    expect(ownerOf(turn("Create a visual for my social media post.", 1).selection)).toBe("create");
+  });
+
+  it("ideal client: exploring → Claire; the avatar named → Avatar Builder", () => {
+    expect(kindOf(turn("I'm not sure who my ideal client is anymore.", 1).selection)).toBe("route:claire");
+    expect(kindOf(turn("Help me update my client avatar with what I learned.", 2).selection)).toBe("route:client_avatars");
+  });
+
+  it("an ask never loops: the choice offer binds once, and a stale choice never executes", () => {
+    const r = turn("I have a big decision about my pricing strategy.", 1);
+    expect(r.plan).toMatchObject({ kind: "offer", bindKey: `${CAPABILITY_BIND_PREFIX}choice` });
+    expect(turn("yes", 4, "Anyway.").accepted).toBeNull();
+  });
+});
+
+// ── 5. The connected capability set ──────────────────────────────────────────
+
+/**
+ * UNDERSTAND (selection) → CONNECT (owner's existing entry point) → DECIDE
+ * (route / offer / defer) → HANDOFF (payload the page executes) → RETURN.
+ * Returns are proven where they exist: Claire / Board / Research / Projects /
+ * Rhythms / Reminders in capabilityConnect.ob5 + connectionCompletion.ob5c +
+ * receiptCorrection.ob4; here the adapter row must state the honest path.
+ */
+const MATRIX: {
+  id: OneBrainCapabilityId;
+  text: string;
+  handoff: CapabilityHandoffPayload["kind"] | "board_invite" | "owner_seam";
+  returns: "main_chat" | "originating_room";
+}[] = [
+  { id: "claire", text: "I need to update what my business does.", handoff: "claire_topic", returns: "main_chat" },
+  { id: "client_avatars", text: "Help me build my client avatar.", handoff: "avatar_builder", returns: "originating_room" },
+  { id: "lmc", text: "Let's look at my business model.", handoff: "lmc_open", returns: "originating_room" },
+  { id: "board", text: "I have a big decision to make.", handoff: "board_invite", returns: "main_chat" },
+  { id: "research", text: "Research this for me.", handoff: "research_launch", returns: "main_chat" },
+  { id: "events", text: "I'm planning an event and don't know where to start.", handoff: "events_doorway", returns: "originating_room" },
+  { id: "strategy_chamber", text: "I need to rethink my pricing.", handoff: "strategy_entry", returns: "main_chat" },
+  { id: "plan_my_day", text: "Help me plan my day.", handoff: "day_designer", returns: "main_chat" },
+  { id: "visual_thinking", text: "I need to see this visually.", handoff: "visual_open", returns: "originating_room" },
