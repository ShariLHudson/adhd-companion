+export function recordReminderReceipt(reminders: Reminder[], turn: number): void {
+  const stored = getReminders().filter((r) => reminders.some((x) => x.id === r.id));
+  if (!stored.length) return;
+  const first = stored[0]!;
+  recordReceipt({
+    ownerKey: "reminder",
+    capability: "reminder",
+    operation: "create",
+    objectId: stored.map((r) => r.id).join(","),
+    label: stored.length > 1 ? `${stored.length} reminders for “${first.title}”` : `reminder “${first.title}”`,
