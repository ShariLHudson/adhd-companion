diff --git a/lib/conversationSession/receiptCorrection.ts b/lib/conversationSession/receiptCorrection.ts
new file mode 100644
index 00000000..83c1c2bf
--- /dev/null
+++ b/lib/conversationSession/receiptCorrection.ts
@@ -0,0 +1,78 @@
+/**
+ * OB-4 — return a bound correction to the receipt's OWNER, for owners whose
+ * correction path is not inside the frictionless Remember layer. Not a
+ * correction brain: it never decides WHETHER the member is correcting (One
+ * Brain did) or WHAT they refer to (the receipt did); it only dispatches to
+ * the owner's own existing function, or says honestly what is not supported.
+ *
+ * Returns a deterministic reply for:
+ *   - checks (ambiguous / stale / multiple items / low confidence) — nothing written;
+ *   - an owner that cannot apply this correction → OWNER_CORRECTION_NOT_SUPPORTED;
+ *   - an undo the owner supports (Reminder delete) — verified.
+ * Returns null when another layer's owner handles it (Remember) or there is
+ * nothing to do.
+ */
+
+import type { CorrectionBinding } from "@/lib/conversationBoundaryRoomGate";
+import { undoRemindersFromReceipt } from "@/lib/reminderIntelligence";
+import { clearReceipt } from "./receipts";
+
+export type ReceiptCorrectionOutcome =
+  | "check"
+  | "undone"
+  | "undo_failed"
+  | "OWNER_CORRECTION_NOT_SUPPORTED";
+
+/** Owners whose correction is applied inside their own layer (not here). */
+const OWNER_LAYER_HANDLES = new Set(["remember"]);
+
+export function resolveReceiptCorrectionReply(
+  binding: CorrectionBinding | null,
+): { reply: string; outcome: ReceiptCorrectionOutcome } | null {
+  if (!binding) return null;
+  if (binding.kind === "check") {
+    const r = binding.receipt;
+    if (!r) return null; // no receipt: OB-2 handles the conversational correction
+    switch (binding.reason) {
+      case "stale":
+        return {
+          outcome: "check",
+          reply:
+            "I don't want to change the wrong thing, and I no longer have that in front of me. Tell me which item and what should change, and I'll update it.",
+        };
+      case "ambiguous":
+        return {
+          outcome: "check",
+          reply: `Do you mean the ${r.label} I just set up, or what I just offered? Tell me which one, and what should change.`,
+        };
+      case "multiple_items":
+        return {
+          outcome: "check",
+          reply: `Which one should I change — ${(r.items ?? []).map((i, n) => `${n + 1}. ${i.label}`).join(", ")}?`,
+        };
+      case "low_confidence":
+      default:
+        return {
+          outcome: "check",
+          reply: `Just so I get this right — what would you like me to change about the ${r.label}?`,
+        };
+    }
+  }
+  if (binding.kind !== "correct_receipt") return null;
+  const r = binding.receipt;
+  if (OWNER_LAYER_HANDLES.has(r.ownerKey)) return null;
+  if (binding.undo && r.undo === "delete" && r.ownerKey === "reminder") {
+    const result = undoRemindersFromReceipt(r.objectId);
+    if (!result.ok) {
+      return { outcome: "undo_failed", reply: `I couldn't remove the ${r.label} just now — it's still there.` };
+    }
+    clearReceipt();
+    return { outcome: "undone", reply: `Removed the ${r.label}. Nothing else changed.` };
+  }
+  return {
+    outcome: "OWNER_CORRECTION_NOT_SUPPORTED",
+    reply: `I can't change the ${r.label} from here yet, so I left it exactly as it is. You can edit it in its own place in the Estate${
+      r.undo === "delete" ? `, or say "undo that" and I'll remove it` : ""
+    }.`,
+  };
+}
