new file mode 100644
index 00000000..9cffe50c
--- /dev/null
+++ b/lib/conversationSession/receipts.ts
@@ -0,0 +1,62 @@
+/**
+ * OB-4 — the ONE receipt authority: the spine's `receipt` field.
+ *
+ * Not a new store: thin accessors over the existing ConversationSession, the
+ * sole durable conversational authority. An owner records a receipt only
+ * AFTER it has committed (and read back) a change to member state; Boundary
+ * sees it as its existing `lastExecuted` input; a bound correction returns to
+ * `ownerKey`, which alone decides how its data changes.
+ *
+ * Provenance: a receipt can be corrected only while it is FRESH — its last
+ * relevant turn (execution, a previous correction, or a hold that kept it
+ * alive) is the immediately previous turn. After a reload the turn counter
+ * restarts, so an old receipt is never fresh ("change that" does nothing).
+ */
+
+import { getConversationSpine, patchConversationSpine } from "./spine";
+import type { ConversationReceipt } from "./types";
+
+export type RecordReceiptInput = Omit<ConversationReceipt, "receiptId" | "at" | "correctedAtTurn" | "heldThroughTurn">;
+
+export function recordReceipt(input: RecordReceiptInput): ConversationReceipt | null {
+  // Only inside a live conversation (the spine exists once a turn has started).
+  if (!getConversationSpine()) return null;
+  const prior = getConversationSpine()?.receipt ?? null;
+  const sameObject = prior && prior.ownerKey === input.ownerKey && prior.objectId === input.objectId;
+  const receipt: ConversationReceipt = {
+    ...input,
+    // A change to the SAME object keeps its receipt identity (a correction chain).
+    receiptId: sameObject ? prior.receiptId : `${input.ownerKey}:${input.objectId}:${input.executedAtTurn}`,
+    operation: sameObject && input.operation === "create" ? "update" : input.operation,
+    ...(sameObject && input.operation !== "delete" ? { correctedAtTurn: input.executedAtTurn } : {}),
+    executedAtTurn: sameObject ? prior.executedAtTurn : input.executedAtTurn,
+    at: new Date().toISOString(),
+  };
+  patchConversationSpine({ receipt });
+  return receipt;
+}
+
+export function readReceipt(): ConversationReceipt | null {
+  return getConversationSpine()?.receipt ?? null;
+}
+
+/** The last turn that kept the receipt correctable. */
+export function receiptLastRelevantTurn(receipt: ConversationReceipt): number {
+  return Math.max(receipt.executedAtTurn, receipt.correctedAtTurn ?? 0, receipt.heldThroughTurn ?? 0);
+}
+
+export function isReceiptFresh(receipt: ConversationReceipt, currentTurn: number): boolean {
+  return currentTurn - receiptLastRelevantTurn(receipt) === 1;
+}
+
+/** A person-before-process hold (or a check) kept the receipt correctable. */
+export function noteReceiptHeld(turn: number): void {
+  const receipt = readReceipt();
+  if (!receipt) return;
+  patchConversationSpine({ receipt: { ...receipt, heldThroughTurn: turn } });
+}
+
+export function clearReceipt(): void {
+  if (!getConversationSpine()) return;
+  patchConversationSpine({ receipt: undefined });
+}
