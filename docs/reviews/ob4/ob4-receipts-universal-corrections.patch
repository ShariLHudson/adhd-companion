+    correction: "not_supported",
+    undo: "delete",
+    ...(stored.length > 1 ? { items: stored.map((r) => ({ id: r.id, label: r.title })) } : {}),
+    executedAtTurn: turn,
+  });
+}
+
+/** Undo the reminders a receipt names, then verify they are gone. */
+export function undoRemindersFromReceipt(objectId: string): { ok: boolean; title: string } {
+  const ids = objectId.split(",").filter(Boolean);
+  const before = getReminders().filter((r) => ids.includes(r.id));
+  const title = before[0]?.title ?? "that reminder";
+  for (const id of ids) {
+    try {
+      deleteReminder(id);
+    } catch {
+      /* verified below */
+    }
+  }
+  const remaining = getReminders().filter((r) => ids.includes(r.id));
+  return { ok: before.length > 0 && remaining.length === 0, title };
+}
