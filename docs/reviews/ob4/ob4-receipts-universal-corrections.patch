+});
+
+describe("undo / remove — owner-supported (Rhythm delete, Reminder delete), verified", () => {
+  it.each(["Undo that.", "Remove that.", "Delete that.", "No, undo that.", "Please remove that."])(
+    "%s → the just-created Rhythm is removed (verified), receipt cleared",
