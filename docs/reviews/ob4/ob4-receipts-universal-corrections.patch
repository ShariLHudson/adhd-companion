+// @vitest-environment jsdom
+/**
+ * OB-4 — Receipts + universal correction loop.
+ *
+ * Production chain, as the page runs it:
+ *   owner commits + records the ONE receipt (production save path, read back)
+ *   → captureBoundaryPreTurnSnapshot → resolveTurnBoundaryDecision (Boundary
+ *   sees the FRESH receipt as `lastExecuted`) → resolveCorrectionBinding
+ *   → owner: Remember (frictionless) or resolveReceiptCorrectionReply (others).
+ * Observers are language-free: what storage actually holds afterwards.
+ */
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { getOrCreateConversationSpine } from "@/lib/conversationSession/spine";
+import { readReceipt } from "@/lib/conversationSession/receipts";
+import { resolveReceiptCorrectionReply } from "@/lib/conversationSession/receiptCorrection";
+import { captureBoundaryPreTurnSnapshot, resolveTurnBoundaryDecision } from "@/lib/conversationBoundaryInputs";
+import { isMeaningHold } from "@/lib/conversationBoundary";
+import { noteReceiptHeld, isReceiptFresh } from "@/lib/conversationSession/receipts";
+import {
+  resolveCorrectionBinding,
+  resolvePendingBinding,
+  type CorrectionBinding,
+} from "@/lib/conversationBoundaryRoomGate";
+import { armPendingReply, notePendingReplyHeld, releasePendingReply } from "@/lib/conversationSession/ownership/pendingReply";
+import { loadPendingRememberCreate, savePendingRememberCreate } from "@/lib/remindersVsRhythms/conversationPending";
+import { resolveFrictionlessAction } from "@/lib/frictionlessActionLayer";
+import { createMemberRhythm, getMemberRhythm, listMemberRhythms } from "@/lib/rhythms/store";
+import { getReminders, saveReminder } from "@/lib/reminderStore";
+import { recordReminderReceipt } from "@/lib/reminderIntelligence";
+import { classifyPrimaryConversationTurn } from "@/lib/conversation/primaryTurnClassifier";
+
+const HOLD = "NEXT_PUBLIC_BOUNDARY_MEANING_HOLD";
+const LAST = "Done — I set up a Rhythm: “Check my Assia order,” weekly on Mondays at 3:00 PM.";
+let saved: string | undefined;
+beforeEach(() => {
+  saved = process.env[HOLD];
+  delete process.env[HOLD];
+  localStorage.clear();
+  sessionStorage.clear();
+  getOrCreateConversationSpine();
+});
+afterEach(() => {
+  if (saved === undefined) delete process.env[HOLD];
+  else process.env[HOLD] = saved;
+});
+
+/** The Remember owner commits a weekly Rhythm on `turn` and records its receipt. */
+function rhythmExecuted(turn = 1, title = "Check my Assia order") {
+  const r = createMemberRhythm({
+    title,
+    cadence: "weekly",
+    schedule: { cadence: "weekly", weekdays: ["monday"], exactTime: "15:00" },
+  } as Parameters<typeof createMemberRhythm>[0]);
+  const now = new Date().toISOString();
+  savePendingRememberCreate({
+    kind: "rhythm", title: r.title, sourceText: `${title} every Monday`, cadence: "weekly",
+    timeOfDay: "15:00", weekdays: ["monday"], createdAt: now, phase: "executed",
+    executedItemId: r.id, offeredAtTurn: turn, offeredAt: now,
+  });
+  return r.id;
+}
+
+/** One member turn, exactly as the page runs it. */
+function turn(text: string, n: number, lastAssistantText = LAST) {
+  const snap = captureBoundaryPreTurnSnapshot();
+  const decision = resolveTurnBoundaryDecision({ userText: text, turn: n - 1, lastAssistantText, snapshot: snap });
+  const pb = resolvePendingBinding({ decision, pending: snap.pendingOwner, currentTurn: n });
+  if (pb?.kind === "preserve") notePendingReplyHeld(n);
+  if (pb?.kind === "release") releasePendingReply("member_declined");
+  const cb = resolveCorrectionBinding({ decision, pending: snap.pendingOwner, receipt: snap.receipt, currentTurn: n });
+  if (isMeaningHold(decision) && snap.receipt && isReceiptFresh(snap.receipt, n)) noteReceiptHeld(n);
+  const local = resolveReceiptCorrectionReply(cb);
+  const fa = local
+    ? null
+    : resolveFrictionlessAction({
+        userText: text,
+        currentTurn: n,
+        lastAssistantText,
+        primaryTurn: classifyPrimaryConversationTurn({ userText: text, lastAssistantText }),
+        boundaryDecision: decision,
+        pendingBinding: pb,
+        correctionBinding: cb,
+      });
+  return { decision, cb, local, reply: local?.reply ?? fa?.localReply ?? "" };
+}
+
+const schedule = (id: string) => getMemberRhythm(id)?.schedule;
+const snapshotOf = (id: string) => JSON.stringify(getMemberRhythm(id));
+
+describe("Rhythm Tuesday proof — the known OB-3 divergence, fixed through the universal path", () => {
+  it.each([
+    "No, I said Tuesday.",
+    "No, that's wrong. I said Tuesday.",
+    "Ugh, no — I said Tuesday!",
+    "Sorry, I meant Tuesday.",
+    "This is so frustrating. I said Tuesday.",
+  ])("%s → bound to the receipt; the Remember owner moves it to Tuesday; everything else unchanged", (text) => {
+    const id = rhythmExecuted();
+    const r = turn(text, 2);
+    expect(r.cb).toMatchObject({ kind: "correct_receipt", undo: false });
+    expect(r.cb?.kind === "correct_receipt" && r.cb.receipt.ownerKey).toBe("remember");
+    expect(schedule(id)).toMatchObject({ cadence: "weekly", weekdays: ["tuesday"], exactTime: "15:00" });
+    expect(listMemberRhythms()).toHaveLength(1); // corrected, not duplicated
+    expect(r.reply).toMatch(/Tuesday/);
+  });
+});
+
+describe("'actually' / directive corrections (structural family, only against a fresh receipt)", () => {
+  it.each([
+    "Actually make it monthly.",
+    "Actually, make it monthly.",
+    "Actually, change it to monthly.",
+    "Make it monthly instead.",
+    "No, make it monthly.",
+  ])("%s → cadence becomes monthly; the time is kept", (text) => {
+    const id = rhythmExecuted();
+    expect(turn(text, 2).cb?.kind).toBe("correct_receipt");
+    expect(schedule(id)).toMatchObject({ cadence: "monthly", exactTime: "15:00" });
+  });
+  it.each(["Make it monthly.", "Actually, make it monthly.", "Change it to 4pm."])(
+    "negative: %s with NOTHING executed is not a correction (nothing written)",
+    (text) => {
+      const r = turn(text, 2, "Here's an idea for your week.");
+      expect(r.cb?.kind === "correct_receipt").toBe(false);
+      expect(listMemberRhythms()).toHaveLength(0);
+    },
+  );
+});
+
+describe("field replacement preserves every other field", () => {
+  it.each([
+    ["Make that 4pm instead.", "16:00"],
+    ["Actually, make it 5pm.", "17:00"],
+    ["Change it to 4pm.", "16:00"],
+    ["Move it to 4pm.", "16:00"],
+    ["Make it 4:30 pm instead.", "16:30"],
+  ])("%s → only the time changes", (text, time) => {
+    const id = rhythmExecuted();
+    turn(text, 2);
+    expect(schedule(id)).toMatchObject({ cadence: "weekly", weekdays: ["monday"], exactTime: time });
+    expect(getMemberRhythm(id)?.title).toBe("Check my Assia order");
+  });
+  it("subject correction changes only the title", () => {
+    const id = rhythmExecuted();
+    turn("No, I meant ASEA not Assia.", 2);
+    expect(getMemberRhythm(id)?.title).toMatch(/ASEA/);
+    expect(schedule(id)).toMatchObject({ weekdays: ["monday"], exactTime: "15:00" });
+  });
+});
+
+describe("ambiguous or valueless correction → the owner asks; nothing written", () => {
+  it.each([
+    "That's not what I meant.",
+    "No, that's not what I meant.",
+    "That's wrong.",
+    "Change that.",
+    "No, change it.",
+    "Keep everything else the same, just change it to 4.", // 4 AM or 4 PM? never guessed
+  ])("%s → no write, receipt kept, Spark asks what should change", (text) => {
+    const id = rhythmExecuted();
+    const before = snapshotOf(id);
+    const r = turn(text, 2);
+    expect(r.cb?.kind).toBe("correct_receipt");
+    expect(snapshotOf(id)).toBe(before);
+    expect(r.reply).toMatch(/What should I change/);
+    // …and the next turn can still correct it (provenance kept by the check)
+    turn("Make it 4pm.", 3);
+    expect(schedule(id)?.exactTime).toBe("16:00");
+  });
+});
+
+describe("repeated correction chains on the same result", () => {
+  it("'No, I said Tuesday.' → 'And make it 10am instead.' → 'Actually make it monthly.'", () => {
+    const id = rhythmExecuted();
+    turn("No, I said Tuesday.", 2);
+    expect(turn("And make it 10am instead.", 3).cb?.kind).toBe("correct_receipt");
+    expect(schedule(id)).toMatchObject({ weekdays: ["tuesday"], exactTime: "10:00" });
+    turn("Actually make it monthly.", 4);
+    expect(schedule(id)).toMatchObject({ cadence: "monthly", exactTime: "10:00" });
+    expect(readReceipt()?.objectId).toBe(id);
+    expect(listMemberRhythms()).toHaveLength(1);
+  });
+});
+
+describe("correction after a clarification", () => {
+  it.each(["What do you mean?", "Can you explain that?", "What exactly did you set up?"])(
+    "%s → Spark explains; the next 'No, I said Tuesday.' still corrects it",
+    (hold) => {
+      const id = rhythmExecuted();
+      const before = snapshotOf(id);
+      turn(hold, 2);
+      expect(snapshotOf(id)).toBe(before);
+      turn("No, I said Tuesday.", 3);
+      expect(schedule(id)?.weekdays).toEqual(["tuesday"]);
+    },
+  );
+});
+
+describe("correction of a PENDING candidate amends the offer; nothing is created", () => {
+  it.each(["No, I meant weekly.", "No, I said weekly.", "Sorry, I meant weekly."])("%s", (text) => {
+    const now = new Date().toISOString();
+    savePendingRememberCreate({
+      kind: "rhythm", title: "Check my ASEA order", sourceText: "check my ASEA order every month",
+      cadence: "monthly", createdAt: now, phase: "confirm", offeredAtTurn: 1, offeredAt: now,
+    });
+    const r = turn(text, 2, "Want me to set up a monthly Rhythm to check your ASEA order?");
