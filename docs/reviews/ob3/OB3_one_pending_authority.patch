+  return { kind: "none", reason: "check_meaning" };
+}
+
+/**
+ * May the bind site that owns an offer made on `offeredAtTurn` (and/or armed
+ * under `bindKey`) consume this acceptance and act? True only when One Brain
+ * bound the reply, executably, to THAT offer. With the kill switch (`null`
+ * binding) every bind site keeps its legacy behavior.
+ */
+export function pendingBindingAllows(
+  binding: PendingBinding | null,
+  offer: { offeredAtTurn?: number | null; bindKey?: string | null },
+): boolean {
+  if (binding === null) return true;
+  if (binding.kind !== "bind" || !binding.executable) return false;
+  if (offer.offeredAtTurn != null) return offer.offeredAtTurn === binding.offeredAtTurn;
+  return offer.bindKey != null && offer.bindKey === binding.bindKey;
+}
+
+/** The reply is about THIS owner's pending item (bound, released, or held). */
+export function pendingBindingOwnedBy(binding: PendingBinding | null, bindKey: string): boolean {
+  return binding !== null && binding.kind !== "none" && binding.bindKey === bindKey;
+}
+
+/**
+ * The reply is an ACCEPTANCE that One Brain did not bind to this offer (stale,
+ * replaced, text-recovered, unarmed, or ambiguous). Bind sites that also take
+ * domain replies (room names, menu options) use this to refuse only the
+ * acceptance. Kill switch (`null` binding): never unbound.
+ */
+export function acceptanceUnboundFor(
+  decision: ConversationBoundaryDecision,
+  binding: PendingBinding | null,
+  offer: { offeredAtTurn?: number | null; bindKey?: string | null },
+): boolean {
+  return binding !== null && decision.relation === "accept" && !pendingBindingAllows(binding, offer);
+}
