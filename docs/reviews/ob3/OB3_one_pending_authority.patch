+// ── OB-3 — One pending authority: what does this reply bind to? ────────────
+
+/**
+ * The one binding result for a turn, derived from Boundary meaning + the
+ * pending-owner snapshot (spine `ownership.expectedReply`) + `permitsFor`.
+ * Every bind site reads THIS; none decides on its own what a "yes" belongs to.
+ * Specialists still decide what the bound acceptance MEANS in their domain.
+ */
+export type PendingBinding =
+  /** The reply binds to the pending item. `executable` only for an owner-armed item. */
+  | {
+      kind: "bind";
+      bindKey: string;
+      offeredAtTurn: number;
+      scope: string[];
+      amended: boolean;
+      executable: boolean;
+    }
+  /** The member declined / deferred: release exactly this pending item. */
+  | { kind: "release"; bindKey: string; offeredAtTurn: number }
+  /** A person-before-process hold: the pending item survives this turn. */
+  | { kind: "preserve"; bindKey: string; offeredAtTurn: number; obligation: BoundaryObligation }
+  /** A partial acceptance that names items this offer never enumerated: ask which. */
+  | { kind: "ask_which"; bindKey: string; offeredAtTurn: number }
+  /** Nothing binds (and nothing may execute). */
+  | {
+      kind: "none";
+      reason: "no_pending" | "stale" | "not_yes_no" | "check_meaning" | "not_a_reply";
+    };
+
+const PRESERVING: ReadonlySet<string> = new Set(["clarify", "ask", "unsure", "correct"]);
+
+/**
+ * Resolve the turn's pending binding. Returns `null` with the kill switch
+ * (`NEXT_PUBLIC_BOUNDARY_MEANING_HOLD=0`) — callers then keep their legacy path.
+ *
+ * Freshness (Round 1 rule, generalized by provenance): a reply binds only when
+ * the pending item's LAST RELEVANT turn — the offer, or a later hold that kept
+ * it alive — is the immediately previous turn. A newer arm replaces an older
+ * one on the single record, so only the newest offer can bind.
+ */
+export function resolvePendingBinding(input: {
+  decision: ConversationBoundaryDecision;
+  pending: BoundaryPendingOwner | null | undefined;
+  currentTurn: number;
+}): PendingBinding | null {
+  if (!isBoundaryMeaningHoldEnabled()) return null;
+  const { decision, pending, currentTurn } = input;
+  const relation = decision.relation;
+  const high = decision.meaningConfidence === "high";
+  if (!pending) {
+    return { kind: "none", reason: relation === "accept" ? "no_pending" : "not_a_reply" };
+  }
+  const lastRelevant = Math.max(pending.offeredAtTurn, pending.heldThroughTurn ?? pending.offeredAtTurn);
+  const fresh = currentTurn - lastRelevant === 1;
