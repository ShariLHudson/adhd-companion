+import { savePendingRememberCreate, loadPendingRememberCreate } from "@/lib/remindersVsRhythms/conversationPending";
+import { resolveFrictionlessAction, saveFrictionlessPending } from "@/lib/frictionlessActionLayer";
+import { listMemberRhythms } from "@/lib/rhythms/store";
+import { classifyPrimaryConversationTurn } from "@/lib/conversation/primaryTurnClassifier";
+
+const HOLD = "NEXT_PUBLIC_BOUNDARY_MEANING_HOLD";
+const OFFER_TEXT = "Want me to set up a monthly Rhythm to check your ASEA order?";
+let saved: string | undefined;
+
+beforeEach(() => {
+  saved = process.env[HOLD];
+  delete process.env[HOLD];
+  localStorage.clear();
+  sessionStorage.clear();
+  getOrCreateConversationSpine();
+});
+afterEach(() => {
+  if (saved === undefined) delete process.env[HOLD];
+  else process.env[HOLD] = saved;
+});
+
+/** The Rhythm owner makes its offer on `turn` through its production save path. */
+function rhythmOffer(turn: number) {
+  const now = new Date().toISOString();
+  savePendingRememberCreate({
+    kind: "rhythm",
+    title: "Check my ASEA order",
+    sourceText: "check my ASEA order every month",
+    cadence: "monthly",
+    createdAt: now,
+    phase: "confirm",
+    offeredAtTurn: turn,
+    offeredAt: now,
+  });
+}
+
+/** One member turn, exactly as the page runs it (Boundary before the turn counter advances). */
+function memberTurn(text: string, turn: number, lastAssistantText = OFFER_TEXT) {
+  const snapshot = captureBoundaryPreTurnSnapshot();
+  const decision = resolveTurnBoundaryDecision({ userText: text, turn: turn - 1, lastAssistantText, snapshot });
+  const binding = resolvePendingBinding({ decision, pending: snapshot.pendingOwner, currentTurn: turn });
+  if (binding?.kind === "preserve") notePendingReplyHeld(turn);
+  if (binding?.kind === "release") releasePendingReply("member_declined");
+  return { snapshot, decision, binding };
+}
+
+/** The Remember owner's REAL bind path; returns whether a Rhythm was created (language-free). */
+function rememberBindPath(text: string, turn: number, binding: PendingBinding | null, decision = memberTurnDecision) {
+  const before = listMemberRhythms().length;
+  const primaryTurn = classifyPrimaryConversationTurn({ userText: text, lastAssistantText: OFFER_TEXT });
+  resolveFrictionlessAction({
+    userText: text,
+    currentTurn: turn,
+    lastAssistantText: OFFER_TEXT,
+    primaryTurn,
+    pendingBinding: binding,
+    boundaryDecision: decision ?? undefined,
+  });
+  return listMemberRhythms().length > before;
+}
+let memberTurnDecision: ReturnType<typeof memberTurn>["decision"] | undefined;
+
+function fullTurn(text: string, turn: number) {
+  const t = memberTurn(text, turn);
+  memberTurnDecision = t.decision;
+  const executed = rememberBindPath(text, turn, t.binding, t.decision);
+  return { ...t, executed };
+}
+
+const THREE_ITEMS = [
+  { id: "item-susan", label: "Add Susan as a speaker" },
+  { id: "item-david", label: "Add David as a speaker" },
+  { id: "item-invite", label: "Send the invitation email" },
+];
+
+describe("fresh acceptance binds to that offer only", () => {
+  it.each(["Yes.", "Yes please.", "Sure, go ahead.", "Okay, do it.", "Sounds good.", "Yep, let's do it."])(
+    "%s → bound executably; the Rhythm is created",
+    (text) => {
+      rhythmOffer(1);
+      const r = fullTurn(text, 2);
+      expect(r.binding).toMatchObject({ kind: "bind", bindKey: "remember_offer", offeredAtTurn: 1, executable: true });
+      expect(r.executed).toBe(true);
+    },
+  );
+  it.each(["What do you mean?", "No.", "I need to email my client about the invoice."])(
+    "negative control %s → no execution",
+    (text) => {
+      rhythmOffer(1);
+      expect(fullTurn(text, 2).executed).toBe(false);
+    },
+  );
+});
+
+describe("stale acceptance never executes", () => {
+  it.each(["Yes.", "Sure, go ahead.", "Okay, do it.", "Sounds good.", "Yes please."])(
+    "offer → unrelated turn → %s → none(stale), nothing created",
+    (text) => {
+      rhythmOffer(1);
+      fullTurn("I need to email my client about the invoice.", 2);
+      const r = fullTurn(text, 3);
+      expect(r.binding).toEqual({ kind: "none", reason: "stale" });
+      expect(r.executed).toBe(false);
+    },
+  );
+  it("the same yes one turn earlier WOULD bind (control)", () => {
+    rhythmOffer(1);
+    expect(fullTurn("Yes.", 2).executed).toBe(true);
+  });
+});
+
+describe("modified acceptance binds WITH the amendment and never executes the unmodified offer", () => {
+  it.each([
+    "Yes, but make it 4:00.",
+    "Sure, but make it weekly.",
+    "Okay, but move it to Friday.",
+    "Yes, but at 9 instead.",
+    "Yeah, but make it every other week.",
+  ])("%s → bind(amended); the UNMODIFIED (monthly) Rhythm is never created", (text) => {
+    rhythmOffer(1);
+    const r = fullTurn(text, 2);
+    expect(r.binding).toMatchObject({ kind: "bind", offeredAtTurn: 1, amended: true });
+    // Remember may apply the amendment it can parse (e.g. "weekly"); it never
+    // creates the offer as originally worded.
+    expect(listMemberRhythms().filter((x) => x.cadence === "monthly")).toEqual([]);
+  });
+  it.each(["Yes.", "Sounds good.", "Okay, do it."])("control %s → not amended", (text) => {
+    rhythmOffer(1);
+    expect(fullTurn(text, 2).binding).toMatchObject({ kind: "bind", amended: false });
+  });
+});
+
+describe("partial acceptance scopes to armed items only", () => {
+  const armThree = () => armPendingReply({ bindKey: "board_project_actions", offeredAtTurn: 1, items: THREE_ITEMS });
+  it.each([
+    "Do the first two, not the third.",
+    "The first and second, but not the third.",
+    "Just the first two.",
+    "Only the first two, please.",
+    "Yes to the first two, not the third.",
+    "Go ahead with the first and second.",
+  ])("%s → include items 1+2, exclude 3", (text) => {
+    armThree();
+    const r = memberTurn(text, 2, "I can do three things: add Susan, add David, send the invitation. Want me to go ahead?");
+    expect(r.binding).toMatchObject({ kind: "bind", scope: ["item-susan", "item-david"], executable: true });
+  });
+  it.each(["Do the fourth one.", "Yes, the fifth and sixth."])(
+    "negative: %s names an unarmed item → ask which, never selects",
+    (text) => {
+      armThree();
+      const r = memberTurn(text, 2);
+      expect(r.binding?.kind).toBe("ask_which");
+    },
+  );
+  it("negative: a partial acceptance of an offer WITHOUT enumerated items fails safe (ask which)", () => {
+    armPendingReply({ bindKey: "remember_offer", offeredAtTurn: 1 });
+    expect(memberTurn("Do the first two, not the third.", 2).binding?.kind).toBe("ask_which");
+  });
+  it("negative: model-text-armed items are never selectable", () => {
+    armPendingReply({ bindKey: "x", offeredAtTurn: 1, items: THREE_ITEMS, authority: "model_text" });
+    const b = memberTurn("Do the first two, not the third.", 2).binding;
+    expect(b?.kind === "bind" && b.executable).toBeFalsy();
+  });
+});
+
+describe("named partial acceptance", () => {
+  const armNamed = () =>
+    armPendingReply({
+      bindKey: "speakers",
+      offeredAtTurn: 1,
+      items: [
+        { id: "item-susan", label: "Add Susan as a speaker" },
+        { id: "item-david", label: "Add David as a speaker" },
+      ],
+    });
+  it.each([
+    "Yes, Susan, but not David yet.",
+    "Go ahead with Susan only.",
+    "Yes to Susan, not David.",
+    "Just Susan, please.",
+    "Just the first one.",
+  ])("%s → Susan included, David excluded", (text) => {
+    armNamed();
+    const b = memberTurn(text, 2, "Want me to add Susan and David as speakers?").binding;
+    expect(b).toMatchObject({ kind: "bind", scope: ["item-susan"] });
+  });
+  it.each(["Add Susan, not David.", "Only Susan for now.", "Susan yes, David no."])(
+    "fail-safe: %s is not read as a HIGH scoped acceptance → nothing is authorized",
+    (text) => {
+      armNamed();
+      const b = memberTurn(text, 2).binding;
+      expect(b?.kind === "bind" && b.executable).toBeFalsy();
+    },
+  );
+});
+
+describe("decline / defer releases exactly the pending item; nothing executes", () => {
+  it.each(["No.", "Not now.", "Let's come back to that later.", "No thanks.", "Maybe later.", "Let's skip this one for now."])(
+    "%s → release; pending record cleared; no Rhythm",
+    (text) => {
+      rhythmOffer(1);
+      const r = fullTurn(text, 2);
+      expect(r.binding).toMatchObject({ kind: "release", bindKey: "remember_offer", offeredAtTurn: 1 });
+      expect(r.executed).toBe(false);
+      expect(getSpineOwnership()?.expectedReply).toBeUndefined();
+      expect(loadPendingRememberCreate()).toBeNull();
+    },
+  );
+});
+
+describe("clarification / question PRESERVE the pending offer; the next yes binds to it", () => {
+  it.each([
+    "What do you mean?",
+    "What exactly will that do?",
+    "Can you explain that?",
+    "I don't understand.",
+    "Sorry, what would that do?",
+  ])("offer → %s → (Spark explains) → Yes. → the ORIGINAL offer is accepted", (text) => {
+    rhythmOffer(1);
+    const hold = fullTurn(text, 2);
+    expect(hold.binding).toMatchObject({ kind: "preserve", offeredAtTurn: 1 });
+    expect(hold.executed).toBe(false);
+    const yes = fullTurn("Yes.", 3);
+    expect(yes.binding).toMatchObject({ kind: "bind", offeredAtTurn: 1, executable: true });
+    expect(yes.executed).toBe(true);
+  });
+  it.each(["What happens if I say yes?", "What would that remind me about?", "How often would it run?", "Can I change it later?", "Where would I find it?"])(
+    "question %s → answered first, offer survives, nothing executes",
+    (text) => {
+      rhythmOffer(1);
+      const r = fullTurn(text, 2);
+      expect(r.binding?.kind).toBe("preserve");
+      expect(r.executed).toBe(false);
+      expect(getSpineOwnership()?.expectedReply?.heldThroughTurn).toBe(2);
+    },
+  );
+  it("negative: a hold does not revive a STALE offer", () => {
+    rhythmOffer(1);
+    fullTurn("I need to email my client about the invoice.", 2);
+    fullTurn("What do you mean?", 3);
+    expect(fullTurn("Yes.", 4).executed).toBe(false);
+  });
+});
+
+describe("replaced offer: only the newest offer may bind", () => {
+  it("Rhythm offer (A) → a newer offer (B) → Yes. → binds B; A's owner does not execute", () => {
+    rhythmOffer(1);
+    saveFrictionlessPending({
+      type: "open_tool",
+      target: "focus-timer",
+      context: "focus",
+      offeredAtTurn: 2,
+      offerSummary: "Open a focus timer",
+    });
+    const r = fullTurn("Yes.", 3);
+    expect(r.binding).toMatchObject({ kind: "bind", offeredAtTurn: 2, bindKey: "frictionless:open_tool" });
+    expect(pendingBindingAllows(r.binding, { offeredAtTurn: 1 })).toBe(false);
+    expect(r.executed).toBe(false);
+  });
+});
+
+describe("open question: a bare yes is not its answer", () => {
+  it.each(["Yes.", "Yep.", "Sure.", "Okay.", "Sounds good."])("Who are you trying to help? → %s → not bound", (text) => {
+    armPendingReply({ bindKey: "open_question", offeredAtTurn: 1, kind: "free_text" });
+    const b = memberTurn(text, 2, "Who are you trying to help?").binding;
+    expect(b).toEqual({ kind: "none", reason: "not_yes_no" });
+  });
+});
+
+describe("reload / missing pending record: yes executes nothing", () => {
+  it.each(["Yes.", "Sure, go ahead.", "Okay, do it.", "Sounds good.", "Yes please."])("%s with no spine pending → none", (text) => {
+    rhythmOffer(1);
+    clearSpineOwnership("reload");
+    const r = fullTurn(text, 2);
+    expect(r.binding?.kind).toBe("none");
+    expect(r.executed).toBe(false);
+  });
+});
+
+describe("model text cannot independently arm execution", () => {
+  it.each(["Yes.", "Sure, go ahead.", "Okay, do it.", "Sounds good.", "Yes please."])(
+    "model-text-armed offer → %s → bound to the conversation, never executable",
+    (text) => {
+      armPendingReply({ bindKey: "confirmation:model_text_offer", offeredAtTurn: 1, authority: "model_text" });
+      const b = memberTurn(text, 2, "Would you like me to build that for you?").binding;
+      expect(b).toMatchObject({ kind: "bind", executable: false });
+      expect(pendingBindingAllows(b, { offeredAtTurn: 1 })).toBe(false);
+    },
+  );
+});
+
+describe("compound response never executes a guess", () => {
+  it.each([
+    "Yes, and also remind me tomorrow at 9.",
+    "Yes — and add a note to call Susan.",
+    "Sure, and can you also set a reminder?",
+  ])("%s → the unmodified offer is not executed", (text) => {
+    rhythmOffer(1);
+    const r = fullTurn(text, 2);
+    expect(r.executed).toBe(false);
+  });
+});
+
+describe("Decision Ledger B-10 — reproduced, then routed through the shared binding", () => {
+  const ledgerTurn = (text: string) => {
+    armPendingReply({ bindKey: "decision_ledger", offeredAtTurn: 1 });
+    const snapshot = { ...captureBoundaryPreTurnSnapshot() };
+    // The Ledger's pending confirmation, as the production snapshot carries it.
+    snapshot.pendingQuestion = { kind: "confirmation", expects: "yes_no", role: "decision" };
+    const decision = resolveTurnBoundaryDecision({ userText: text, turn: 1, lastAssistantText: "Want me to record that decision?", snapshot });
+    const binding = resolvePendingBinding({ decision, pending: snapshot.pendingOwner, currentTurn: 2 });
+    return { decision, binding };
+  };
+  it("REPRODUCED: Boundary answers the Ledger's own pending ('Yes.' → answer_pending_question), which claims the turn", () => {
+    const d = resolveConversationBoundary({
+      userText: "Yes.",
+      turn: 4,
+      pendingQuestion: { kind: "confirmation", expects: "yes_no", role: "decision" },
+      lastAssistantText: "Want me to record that decision?",
+    });
+    expect(d.decision).toBe("answer_pending_question"); // → boundaryClaimedTurn → only consumer skipped (pre-OB-3)
+  });
+  it.each(["Yes.", "Yep", "Yes please.", "No.", "Not now."])("OB-3: %s now reaches the Ledger (owned by decision_ledger)", (text) => {
+    const { binding } = ledgerTurn(text);
+    expect(pendingBindingOwnedBy(binding, "decision_ledger")).toBe(true);
+    expect(binding?.kind === "bind" || binding?.kind === "release").toBe(true);
+  });
+  it("the page consumer gate uses the shared binding", async () => {
+    const fs = await import("node:fs");
+    const src = fs.readFileSync(`${process.cwd()}/app/companion/CompanionPageClient.tsx`, "utf8");
+    expect(src).toMatch(/if \(!boundaryClaimedTurn \|\| decisionLedgerOwnsReply\)/);
+  });
+});
+
+describe("kill switch NEXT_PUBLIC_BOUNDARY_MEANING_HOLD=0", () => {
+  it("binding is null (every bind site keeps its legacy behavior) and Boundary is not fed the pending owner", () => {
+    process.env[HOLD] = "0";
+    rhythmOffer(1);
+    const snapshot = captureBoundaryPreTurnSnapshot();
+    const decision = resolveTurnBoundaryDecision({ userText: "Yes.", turn: 1, lastAssistantText: OFFER_TEXT, snapshot });
+    expect(resolvePendingBinding({ decision, pending: snapshot.pendingOwner, currentTurn: 2 })).toBeNull();
+    expect(pendingBindingAllows(null, { offeredAtTurn: 99 })).toBe(true);
+    const legacy = resolveConversationBoundary({ userText: "Yes.", turn: 1, lastAssistantText: OFFER_TEXT });
+    expect(decision.decision).toBe(legacy.decision);
+    // Legacy Remember binder (its own yes + turn rule) still creates the Rhythm.
+    expect(rememberBindPath("Yes.", 2, null, decision)).toBe(true);
+  });
+});
