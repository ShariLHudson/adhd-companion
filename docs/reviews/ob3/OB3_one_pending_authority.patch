@@ -0,0 +1,123 @@
+/**
+ * OB-3 — the ONE pending-response record: the spine's `ownership.expectedReply`.
+ *
+ * Not a new store. These are thin accessors over the existing ownership record
+ * so every owner arms, refreshes and releases the same record, and Boundary
+ * reads it (as plain pre-turn data) through `pendingOwnerSnapshot`.
+ *
+ * - arm:     an owner/capability made an offer or asked a yes/no question.
+ *            A newer arm REPLACES the previous pending item (only the newest
+ *            offer may bind).
+ * - held:    a person-before-process hold (clarify / ask / unsure / correct)
+ *            kept the item alive — freshness is measured from here.
+ * - release: the member declined, or the owner consumed/cancelled it.
+ *
+ * Arming never changes WHO owns the conversation: when an owner is active the
+ * pending reply is attached to it; only when nobody owns the conversation is a
+ * `confirmation` owner created (the existing free-form pending shape).
+ */
+
+import { getConversationSpine } from "../spine";
+import {
+  beginSpineOwnership,
+  clearSpineOwnership,
+  getSpineOwnership,
+  setSpineOwnership,
+} from "./ownershipStore";
+import type { ExpectedReplyKind, OwnershipExpectedReply } from "./types";
+
+export type ArmPendingReplyInput = {
+  bindKey: string;
+  offeredAtTurn: number;
+  kind?: ExpectedReplyKind;
+  optional?: boolean;
+  items?: { id: string; label: string }[];
+  authority?: "owner" | "model_text";
+  allowedValues?: string[];
+};
+
+function liveOwnership() {
+  // Read without creating a spine: no spine means nothing is pending.
+  if (!getConversationSpine()) return null;
+  const ownership = getSpineOwnership();
+  if (!ownership || ownership.owner === "none" || ownership.status === "completed") return null;
+  return ownership;
+}
+
+export function armPendingReply(input: ArmPendingReplyInput): OwnershipExpectedReply | null {
+  // Only inside a live conversation (the spine exists once a turn has started).
+  if (!getConversationSpine()) return null;
+  const expectedReply: OwnershipExpectedReply = {
+    kind: input.kind ?? "confirmation",
+    ...(input.allowedValues ? { allowedValues: input.allowedValues } : {}),
+    bindKey: input.bindKey,
+    offeredAtTurn: input.offeredAtTurn,
+    ...(input.optional ? { optional: true } : {}),
+    ...(input.items?.length ? { items: input.items } : {}),
+    authority: input.authority ?? "owner",
+  };
+  const current = liveOwnership();
+  if (current) {
+    setSpineOwnership({
+      ...current,
+      status: "awaiting_user",
+      updatedAt: new Date().toISOString(),
+      expectedReply,
+    });
+  } else {
+    beginSpineOwnership({
+      owner: "confirmation",
+      reason: `pending_reply:${input.bindKey}`,
+      status: "awaiting_user",
+      expectedReply,
+    });
+  }
+  return expectedReply;
+}
+
+/** The pending item survived a person-before-process hold on `turn`. */
+export function notePendingReplyHeld(turn: number): void {
+  const current = liveOwnership();
+  const reply = current?.expectedReply;
+  if (!current || !reply || reply.offeredAtTurn == null) return;
+  setSpineOwnership({
+    ...current,
+    updatedAt: new Date().toISOString(),
+    expectedReply: { ...reply, heldThroughTurn: turn },
+  });
+}
+
+/** Release the pending item (declined / consumed / cancelled). */
+export function releasePendingReply(reason: string): void {
+  const current = liveOwnership();
+  if (!current?.expectedReply) return;
+  if (current.owner === "confirmation") {
+    clearSpineOwnership(reason);
+    return;
+  }
+  const { expectedReply: _released, ...rest } = current;
+  void _released;
+  setSpineOwnership({ ...rest, updatedAt: new Date().toISOString(), reason });
+}
+
+/**
+ * The live pending reply, or null. A legacy record may carry its offer turn in
+ * `continuation` (collection `sourceTurn`, win-save / confirmation
+ * `offeredAtTurn`); without any offer turn the record cannot bind.
+ */
+export function readPendingReply(): (OwnershipExpectedReply & { offeredAtTurn: number; ownerKind: string }) | null {
+  const current = liveOwnership();
+  const reply = current?.expectedReply;
+  if (!current || !reply) return null;
+  const continuation = current.continuation as
+    | { sourceTurn?: number; offeredAtTurn?: number; kind?: string }
+    | undefined;
+  const offeredAtTurn = reply.offeredAtTurn ?? continuation?.offeredAtTurn ?? continuation?.sourceTurn;
+  if (offeredAtTurn == null || !Number.isFinite(offeredAtTurn)) return null;
+  return {
+    ...reply,
+    offeredAtTurn,
+    bindKey: reply.bindKey ?? continuation?.kind ?? current.owner,
+    ownerKind: current.owner,
+  };
+}
